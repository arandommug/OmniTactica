@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core

@inject BookmarkService BookmarkService
@inject MathhammerService MathhammerService
@inject NavigationManager Navigation
@implements IDisposable

<div class="btn-group w-100" role="group">
    <button class="btn @(isBookmarked ? "btn-warning" : "btn-outline-warning")" 
            @onclick="ToggleBookmark"
            title="@(isBookmarked ? "Remove bookmark" : "Add bookmark")">
        <i class="fa @(isBookmarked ? "fa-bookmark" : "fa-bookmark-o") me-1"></i>
        @(isBookmarked ? "Bookmarked" : "Bookmark")
    </button>

    <button class="btn btn-outline-danger" 
            @onclick="SetAsAttacker"
            title="Set as attacker in mathhammer">
        <i class="fa fa-gun me-1"></i>
        Attacker
    </button>

    <button class="btn btn-outline-primary" 
            @onclick="SetAsDefender"
            title="Set as defender in mathhammer">
        <i class="fa fa-shield me-1"></i>
        Defender
    </button>
</div>

@code {
    [Parameter] public int DatasheetId { get; set; }
    [Parameter] public string DatasheetName { get; set; } = string.Empty;
    [Parameter] public string? FactionId { get; set; }

    private bool isBookmarked;

    protected override void OnInitialized()
    {
        UpdateBookmarkState();
        BookmarkService.OnBookmarksChanged += UpdateBookmarkState;
    }

    private void UpdateBookmarkState()
    {
        isBookmarked = BookmarkService.IsBookmarked(BookmarkType.Datasheet, DatasheetId.ToString());
        StateHasChanged();
    }

    private async Task ToggleBookmark()
    {
        if (isBookmarked)
        {
            await BookmarkService.RemoveBookmarkByEntityAsync(BookmarkType.Datasheet, DatasheetId.ToString());
        }
        else
        {
            await BookmarkService.AddBookmarkAsync(new Bookmark
            {
                Type = BookmarkType.Datasheet,
                EntityId = DatasheetId.ToString(),
                Name = DatasheetName,
                FactionId = FactionId
            });
        }
    }

    private void SetAsAttacker()
    {
        MathhammerService.SetAttacker(DatasheetId, DatasheetName);
        Navigation.NavigateTo("/mathhammer");
    }

    private void SetAsDefender()
    {
        MathhammerService.SetDefender(DatasheetId, DatasheetName);
        Navigation.NavigateTo("/mathhammer");
    }

    public void Dispose()
    {
        BookmarkService.OnBookmarksChanged -= UpdateBookmarkState;
    }
}
