@using OmniTactica.AppCode.Models.Core
@using Microsoft.JSInterop

@inject IJSRuntime JS

<div class="modal fade" id="simulationSettingsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-cog"></i> Simulation Settings
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Number of Simulations</label>
                    <input type="number" class="form-control" @bind="localSettings.Iterations" min="100" max="100000" step="1000" />
                    <div class="form-text">More simulations = more accurate but slower (1,000 - 100,000)</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Wound Allocation Method</label>
                    <select class="form-select" @bind="localSettings.WoundAllocation">
                        <option value="@WoundAllocationMethod.EvenDistribution">Even Distribution</option>
                        <option value="@WoundAllocationMethod.TargetWeakest">Target Weakest Models First</option>
                        <option value="@WoundAllocationMethod.TargetStrongest">Target Full Health Models First</option>
                        <option value="@WoundAllocationMethod.RandomAllocation">Random Allocation</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Range to Target (inches, optional)</label>
                    <input type="number" class="form-control" @bind="rangeString" placeholder="Leave empty if not applicable" />
                    <div class="form-text">Used for Rapid Fire, Melta, and range-dependent abilities</div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="localSettings.AttackerCharged" id="attackerChargedCheck" />
                    <label class="form-check-label" for="attackerChargedCheck">
                        Attacker Charged This Turn
                    </label>
                    <div class="form-text">Affects charge-dependent abilities like Lance</div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="localSettings.EnableDetailedLogging" id="detailedLoggingCheck" />
                    <label class="form-check-label" for="detailedLoggingCheck">
                        Enable Detailed Combat Log
                    </label>
                    <div class="form-text">Shows step-by-step combat resolution (may slow down large simulations)</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ApplySettings">
                    <i class="fa fa-check"></i> Apply
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public SimulationSettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback<SimulationSettings> OnSettingsChanged { get; set; }

    private SimulationSettings localSettings = new();
    private string rangeString = "";

    public async Task Show()
    {
        // Clone current settings
        localSettings = new SimulationSettings
        {
            Iterations = Settings.Iterations,
            WoundAllocation = Settings.WoundAllocation,
            EnableDetailedLogging = Settings.EnableDetailedLogging,
            AttackerCharged = Settings.AttackerCharged,
            RangeToTarget = Settings.RangeToTarget
        };

        rangeString = Settings.RangeToTarget?.ToString() ?? "";

        await JS.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('simulationSettingsModal')).show()");
    }

    private async Task ApplySettings()
    {
        // Parse range
        if (int.TryParse(rangeString, out var range) && range > 0)
        {
            localSettings.RangeToTarget = range;
        }
        else
        {
            localSettings.RangeToTarget = null;
        }

        await OnSettingsChanged.InvokeAsync(localSettings);
        await JS.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('simulationSettingsModal')).hide()");
    }
}
