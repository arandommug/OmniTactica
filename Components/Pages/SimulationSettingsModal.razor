@using OmniTactica.AppCode.Models.Core
@using Microsoft.JSInterop

@inject IJSRuntime JS

<div class="modal fade" id="simulationSettingsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-cog"></i> Simulation Settings
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Number of Simulations</label>
                    <input type="number" class="form-control" @bind="localSettings.Iterations" min="100" max="100000" step="1000" />
                    <div class="form-text">More simulations = more accurate but slower (1,000 - 100,000)</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Wound Allocation Method</label>
                    <select class="form-select" @bind="localSettings.WoundAllocation">
                        <option value="@WoundAllocationMethod.EvenDistribution">Even Distribution</option>
                        <option value="@WoundAllocationMethod.TargetWeakest">Target Weakest Models First</option>
                        <option value="@WoundAllocationMethod.TargetStrongest">Target Full Health Models First</option>
                        <option value="@WoundAllocationMethod.RandomAllocation">Random Allocation</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Combat Phase</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="combatPhase" id="phaseShootingOnly"
                               checked="@(localSettings.CombatPhase == CombatPhaseMode.ShootingOnly)"
                               @onchange="() => localSettings.CombatPhase = CombatPhaseMode.ShootingOnly" />
                        <label class="btn btn-outline-danger" for="phaseShootingOnly">
                            <i class="fa fa-crosshairs"></i> Shooting Only
                        </label>

                        <input type="radio" class="btn-check" name="combatPhase" id="phaseBoth"
                               checked="@(localSettings.CombatPhase == CombatPhaseMode.Both)"
                               @onchange="() => localSettings.CombatPhase = CombatPhaseMode.Both" />
                        <label class="btn btn-outline-primary" for="phaseBoth">
                            <i class="fa fa-bolt"></i> Both
                        </label>

                        <input type="radio" class="btn-check" name="combatPhase" id="phaseFightOnly"
                               checked="@(localSettings.CombatPhase == CombatPhaseMode.FightOnly)"
                               @onchange="() => localSettings.CombatPhase = CombatPhaseMode.FightOnly" />
                        <label class="btn btn-outline-warning" for="phaseFightOnly">
                            <i class="fa fa-fist-raised"></i> Fight Only
                        </label>
                    </div>
                    <div class="form-text">Shooting processes ranged weapons first, then Fight processes melee weapons</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Range to Target</label>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="withinHalfRange" id="halfRangeCheck" />
                        <label class="form-check-label" for="halfRangeCheck">
                            Within Half Range (Quick Toggle)
                        </label>
                        <div class="form-text">Automatically sets range for Rapid Fire weapons</div>
                    </div>
                    <input type="number" class="form-control" @bind="rangeString" placeholder="Or enter specific range in inches" disabled="@withinHalfRange" />
                    <div class="form-text">Used for Rapid Fire, Melta, and range-dependent abilities</div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="localSettings.AttackerCharged" id="attackerChargedCheck" />
                    <label class="form-check-label" for="attackerChargedCheck">
                        Attacker Charged This Turn
                    </label>
                    <div class="form-text">Affects charge-dependent abilities like Lance</div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="localSettings.EnableDetailedLogging" id="detailedLoggingCheck" />
                    <label class="form-check-label" for="detailedLoggingCheck">
                        Enable Detailed Combat Log
                    </label>
                    <div class="form-text">Shows step-by-step combat resolution (may slow down large simulations)</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ApplySettings">
                    <i class="fa fa-check"></i> Apply
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public SimulationSettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback<SimulationSettings> OnSettingsChanged { get; set; }

    private SimulationSettings localSettings = new();
    private string rangeString = "";
    private bool withinHalfRange = false;

    public async Task Show()
    {
        // Clone current settings
        localSettings = new SimulationSettings
        {
            Iterations = Settings.Iterations,
            WoundAllocation = Settings.WoundAllocation,
            EnableDetailedLogging = Settings.EnableDetailedLogging,
            AttackerCharged = Settings.AttackerCharged,
            RangeToTarget = Settings.RangeToTarget,
            CombatPhase = Settings.CombatPhase
        };

        rangeString = Settings.RangeToTarget?.ToString() ?? "";
        withinHalfRange = Settings.RangeToTarget == -1; // -1 indicates "within half range" mode
        if (withinHalfRange)
            rangeString = "";

        await JS.InvokeVoidAsync("bootstrapInterop.showModal", "simulationSettingsModal");
    }

    private void HandleHalfRangeToggle()
    {
        if (withinHalfRange)
        {
            rangeString = "";
        }
    }

    private async Task ApplySettings()
    {
        // Parse range
        if (withinHalfRange)
        {
            localSettings.RangeToTarget = -1; // Special value to indicate "within half range"
        }
        else if (int.TryParse(rangeString, out var range) && range > 0)
        {
            localSettings.RangeToTarget = range;
        }
        else
        {
            localSettings.RangeToTarget = null;
        }

        await OnSettingsChanged.InvokeAsync(localSettings);
        await JS.InvokeVoidAsync("bootstrapInterop.hideModal", "simulationSettingsModal");
    }
}
