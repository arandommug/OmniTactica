@code {
    [Parameter]
    public string? ListId { get; set; }

    private static readonly string[] PreferredRoleOrder =
    {
        "Characters",
        "Battleline",
        "Dedicated Transports",
        "Other Datasheets"
    };

    private static readonly string[] phases = new[] { "Command phase", "Movement phase", "Shooting phase", "Charge phase", "Fight phase" };

    private ArmyList? armyList;
    private List<Enhancement> availableEnhancements = new();
    private List<Stratagem> detachmentStratagems = new();
    private List<Stratagem> coreStratagems = new();
    private List<DetachmentAbility> detachmentAbilities = new();
    private List<DetachmentAbility> armyRules = new();
    private Dictionary<int, DatasheetDetail> datasheetDetailCache = new();
    private readonly HashSet<string> destroyedUnits = new();
    private readonly HashSet<string> collapsedPanels = new(StringComparer.OrdinalIgnoreCase);

    private bool loading = true;
    private int turnNumber = 1;
    private int roundNumber = 1;
    private int commandPoints = 1;
    private string currentPhase = "Command phase";
    private string playMobileTab = "units";
    private string playModeSearch = string.Empty;
    private string playModeRoleFilter = string.Empty;

    private IEnumerable<IGrouping<string, ArmyListUnit>> RoleGroups => (armyList?.Units ?? Enumerable.Empty<ArmyListUnit>())
        .GroupBy(unit => GetRoleDisplay(unit.Role))
        .OrderBy(group => GetRoleSortOrder(group.Key))
        .ThenBy(group => group.Key);

    private List<string> PlayModeRoles => (armyList?.Units ?? Enumerable.Empty<ArmyListUnit>())
        .Select(unit => GetRoleDisplay(unit.Role))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(role => GetRoleSortOrder(role))
        .ThenBy(role => role)
        .ToList();

    private List<ArmyListUnit> FilteredPlayModeUnits => (armyList?.Units ?? Enumerable.Empty<ArmyListUnit>())
        .Where(unit => string.IsNullOrWhiteSpace(playModeSearch) || unit.DatasheetName.Contains(playModeSearch, StringComparison.OrdinalIgnoreCase))
        .Where(unit => string.IsNullOrWhiteSpace(playModeRoleFilter) || string.Equals(GetRoleDisplay(unit.Role), playModeRoleFilter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(unit => GetRoleSortOrder(GetRoleDisplay(unit.Role)))
        .ThenBy(unit => unit.DatasheetName)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!DB.DatabaseExists)
        {
            loading = false;
            return;
        }

        // Activate the requested list so ArmyListService serves the right one
        if (!string.IsNullOrWhiteSpace(ListId))
        {
            await ArmyListService.SetActiveListAsync(ListId);
        }

        armyList = ArmyListService.GetArmyList();

        if (armyList == null || !armyList.Units.Any())
        {
            loading = false;
            return;
        }

        // Pre-load datasheet details for all units
        foreach (var datasheetId in armyList.Units.Select(unit => unit.DatasheetId).Distinct())
        {
            await EnsureDatasheetDetailLoadedAsync(datasheetId);
        }

        if (armyList.DetachmentId.HasValue)
        {
            await LoadEnhancementsAsync(armyList.DetachmentId.Value);
        }

        // Load core stratagems
        try
        {
            await using var conn = DB.CreateConnection();
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = @"SELECT id, faction_id, name, type, cp_cost, legend, turn, phase, description, detachment, detachment_id FROM Stratagems WHERE (faction_id IS NULL OR faction_id = '') ORDER BY name";
            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                coreStratagems.Add(new Stratagem
                {
                    Id = reader.IsDBNull(0) ? 0 : reader.GetInt32(0),
                    FactionId = reader.IsDBNull(1) ? string.Empty : reader.GetString(1),
                    Name = reader.IsDBNull(2) ? string.Empty : reader.GetString(2),
                    Type = reader.IsDBNull(3) ? string.Empty : reader.GetString(3),
                    CpCost = reader.IsDBNull(4) ? string.Empty : reader.GetString(4),
                    Legend = reader.IsDBNull(5) ? string.Empty : reader.GetString(5),
                    Turn = reader.IsDBNull(6) ? string.Empty : reader.GetString(6),
                    Phase = reader.IsDBNull(7) ? string.Empty : reader.GetString(7),
                    Description = reader.IsDBNull(8) ? string.Empty : reader.GetString(8),
                    Detachment = reader.IsDBNull(9) ? string.Empty : reader.GetString(9),
                    DetachmentId = reader.IsDBNull(10) ? 0 : reader.GetInt32(10)
                });
            }
        }
        catch { /* ignore */ }

        coreStratagems = coreStratagems.DistinctBy(GetStratagemDedupKey).ToList();

        // Load army rules
        if (!string.IsNullOrWhiteSpace(armyList.FactionId))
        {
            try
            {
                await using var conn = DB.CreateConnection();
                await conn.OpenAsync();
                using var cmd = conn.CreateCommand();
                cmd.CommandText = @"SELECT id, name, legend, faction_id, description FROM Abilities WHERE faction_id = @factionId ORDER BY name";
                var p = cmd.CreateParameter();
                p.ParameterName = "@factionId";
                p.Value = armyList.FactionId;
                cmd.Parameters.Add(p);
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    armyRules.Add(new DetachmentAbility
                    {
                        Id = reader.IsDBNull(0) ? 0 : reader.GetInt32(0),
                        Name = reader.IsDBNull(1) ? string.Empty : reader.GetString(1),
                        Legend = reader.IsDBNull(2) ? string.Empty : reader.GetString(2),
                        FactionId = reader.IsDBNull(3) ? string.Empty : reader.GetString(3),
                        Description = reader.IsDBNull(4) ? string.Empty : reader.GetString(4)
                    });
                }
            }
            catch { /* ignore */ }
        }

        await JS.InvokeVoidAsync("lockBodyScroll");
        loading = false;
    }

    private async Task EnsureDatasheetDetailLoadedAsync(int datasheetId)
    {
        if (datasheetDetailCache.ContainsKey(datasheetId)) return;
        var detail = await Data.GetDatasheetDetailAsync(datasheetId, armyList?.DetachmentId);
        if (detail != null) datasheetDetailCache[datasheetId] = detail;
    }

    private async Task LoadEnhancementsAsync(int detachmentId)
    {
        var detachment = await Data.GetDetachmentDetailsAsync(detachmentId);
        availableEnhancements = detachment?.Enhancements.OrderBy(e => e.Name).ToList() ?? [];
        detachmentStratagems = detachment?.Stratagems.DistinctBy(GetStratagemDedupKey).ToList() ?? [];
        detachmentAbilities = detachment?.Abilities.OrderBy(a => a.Name).ToList() ?? [];
    }

    private DatasheetDetail? GetDatasheetDetail(int datasheetId)
        => datasheetDetailCache.TryGetValue(datasheetId, out var detail) ? detail : null;

    private Enhancement? GetSelectedEnhancement(ArmyListUnit unit)
        => unit.EnhancementId.HasValue
            ? availableEnhancements.FirstOrDefault(e => e.Id == unit.EnhancementId.Value)
              ?? new Enhancement { Id = unit.EnhancementId.Value, Name = unit.EnhancementName, Cost = unit.EnhancementCost }
            : null;

    private void GoBack()
    {
        var route = armyList != null && !string.IsNullOrWhiteSpace(armyList.FactionId)
            ? $"/list-builder/{armyList.FactionId}"
            : "/list-builder";
        Navigation.NavigateTo(route);
    }

    private void IncreaseCP() => commandPoints++;
    private void DecreaseCP() { if (commandPoints > 0) commandPoints--; }

    private void SetPhase(string phase)
    {
        currentPhase = phase;
        StateHasChanged();
    }

    private bool IsPanelExpanded(string key) => !collapsedPanels.Contains(key);

    private void TogglePanel(string key)
    {
        if (!collapsedPanels.Add(key))
            collapsedPanels.Remove(key);
    }

    private void ToggleDestroyed(string unitId)
    {
        if (destroyedUnits.Contains(unitId)) destroyedUnits.Remove(unitId);
        else destroyedUnits.Add(unitId);
    }

    private bool IsDestroyed(string unitId) => destroyedUnits.Contains(unitId);

    private IEnumerable<Stratagem> GetPhaseStratagems()
    {
        var phaseList = detachmentStratagems.Concat(coreStratagems);
        return phaseList
            .Where(s => StratagemMatchesPhase(s.Phase, currentPhase))
            .DistinctBy(GetStratagemDedupKey)
            .OrderBy(s => GetTurnSortOrder(s.Turn))
            .ThenBy(s => s.Name);
    }

    private static string GetStratagemDedupKey(Stratagem s)
    {
        static string Norm(string? v)
            => string.Join(' ', (v ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                .Trim().ToUpperInvariant();
        return string.Join("|", Norm(s.Name), Norm(s.CpCost), Norm(s.Turn), Norm(s.Phase), Norm(s.Description));
    }

    private static bool StratagemMatchesPhase(string? stratagemPhase, string currentPhase)
    {
        if (string.IsNullOrWhiteSpace(stratagemPhase) || stratagemPhase.Equals("Any phase", StringComparison.OrdinalIgnoreCase))
            return true;

        var parts = stratagemPhase.Split(" or ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var part in parts)
        {
            var normalized = part.EndsWith(" phase", StringComparison.OrdinalIgnoreCase) ? part : part + " phase";
            if (normalized.Equals(currentPhase, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private static int GetTurnSortOrder(string? turn)
        => string.IsNullOrWhiteSpace(turn) ? 2 : turn.Trim().ToLowerInvariant() switch
        {
            "your turn" => 0,
            "opponent's turn" => 1,
            _ => 2
        };

    private static string GetRoleDisplay(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return "Other Datasheets";
        return role.Trim().ToLowerInvariant() switch
        {
            "character" or "characters" or "epic hero" => "Characters",
            "battleline" => "Battleline",
            "dedicated transport" or "dedicated transports" => "Dedicated Transports",
            _ => "Other Datasheets"
        };
    }

    private static int GetRoleSortOrder(string role)
    {
        var index = Array.FindIndex(PreferredRoleOrder, r => r.Equals(role, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : PreferredRoleOrder.Length;
    }

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("unlockBodyScroll"); } catch { }
    }
}
