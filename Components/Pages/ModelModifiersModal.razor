@using OmniTactica.AppCode.Models.Core

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Model Modifiers: @Model.ModelProfile?.Name</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">

                    <!-- Defense Modifiers -->
                    <div class="col-12">
                        <h6 class="border-bottom pb-2">Defense Modifiers</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Save Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.SaveModifier" min="-3" max="3" />
                        <small class="text-muted">Bonus to armor saves</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Invuln Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.InvulnerableSaveModifier" min="-3" max="3" />
                        <small class="text-muted">Bonus to invulnerable</small>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Toughness Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.ToughnessModifier" min="-3" max="3" />
                        <small class="text-muted">Bonus to toughness</small>
                    </div>

                    <!-- Damage Reduction -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Damage Reduction</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Damage Reduction:</label>
                        <input type="number" class="form-control" @bind="modifiers.DamageReduction" min="0" max="10" />
                        <small class="text-muted">Reduce damage by amount</small>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.HalveDamage" id="modelHalveDamage" />
                            <label class="form-check-label" for="modelHalveDamage">
                                Halve Damage
                            </label>
                        </div>
                    </div>

                    <!-- Feel No Pain -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Feel No Pain</h6>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.FeelNoPain" id="modelFNP" />
                            <label class="form-check-label" for="modelFNP">
                                Has Feel No Pain
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">FNP Value:</label>
                        <input type="number" class="form-control" @bind="modifiers.FeelNoPainValue" min="2" max="6" 
                               disabled="@(!modifiers.FeelNoPain)" />
                        <small class="text-muted">D6 roll needed</small>
                    </div>

                    <!-- Attack Modifiers (for attacking models) -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Attack Modifiers (if attacking)</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hit Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.HitModifier" min="-3" max="3" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Wound Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.WoundModifier" min="-3" max="3" />
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CombatModel Model { get; set; } = null!;
    [Parameter] public CombatUnit Unit { get; set; } = null!;
    [Parameter] public EventCallback<ModelModifiers> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ModelModifiers modifiers = new();

    protected override void OnInitialized()
    {
        // Clone the current modifiers
        modifiers = new ModelModifiers
        {
            HitModifier = Model.ModelModifiers.HitModifier,
            WoundModifier = Model.ModelModifiers.WoundModifier,
            SaveModifier = Model.ModelModifiers.SaveModifier,
            InvulnerableSaveModifier = Model.ModelModifiers.InvulnerableSaveModifier,
            ToughnessModifier = Model.ModelModifiers.ToughnessModifier,
            FeelNoPain = Model.ModelModifiers.FeelNoPain,
            FeelNoPainValue = Model.ModelModifiers.FeelNoPainValue,
            DamageReduction = Model.ModelModifiers.DamageReduction,
            HalveDamage = Model.ModelModifiers.HalveDamage
        };
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync(modifiers);
    }
}
