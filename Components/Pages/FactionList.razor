@page "/factions"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core

@inject WahaSQLiteService DB
@inject WahaDataService Data
@inject NavigationManager Navigation
@inject FactionViewerState ViewerState

<style>
    .factionList {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }

    @@media (max-width:640px)
    {
        .factionList {
            grid-template-columns: repeat(1, minmax(max-content, 1fr));
        }
    }
</style>

<div class="p-2">
    <div class="row g-2">
        <div class="col-12 col-lg-8">
            <div class="card bg-secondary-subtle">
                <div class="card-header">
                    <h1 class="text-primary">Browse Factions</h1>
                    @if (DB.DatabaseExists && !loading)
                    {
                        <div class="mt-3">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Search everything (faction, detachment, unit, stratagem, enhancement...)"
                                   @bind="searchText"
                                   @bind:event="oninput"
                                   @bind:after="PerformGlobalSearchAsync" />
                            @if (searchResults.Any())
                            {
                                <div class="list-group mt-1">
                                    @foreach (var r in searchResults.Take(8))
                                    {
                                        <button class="list-group-item list-group-item-action" @onclick="() => NavigateToSearchResult(r)">
                                            <div class="d-flex w-100 justify-content-between">
                                                <div>
                                                    <strong>@r.Name</strong>
                                                    <div class="text-muted" style="font-size:0.85rem">@r.TypeDisplay @if(!string.IsNullOrEmpty(r.Context)) { <span>· @r.Context</span> }</div>
                                                </div>
                                                <small class="text-muted">@r.Type</small>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="card-body">
        @if (!DB.DatabaseExists)
        {
            <div class="alert alert-warning">Database not installed. Go to Settings to download data.</div>
        }
        else if (loading)
        {
            <div class="d-flex align-items-center">
                <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                <div>Loading factions...</div>
            </div>
        }
        else
        {
            @if (filteredFactions.Count == 0)
            {
                <div class="alert alert-info">No factions found matching "@searchText"</div>
            }
            else
            {
                <div class="factionList">
                @foreach (var f in filteredFactions)
                {
                    <NavLink class="card border-primary" href="@($"/faction/{@f.Id}")">
                        <div class="card-body pe-0">
                            <div class="d-flex align-items-center text-nowrap">
                                <div class="w-auto h5 mb-0">@f.Name</div>
                                <icon class="fa fa-chevron-right ms-auto text-end me-3"></icon>
                            </div>
                        </div>
                    </NavLink>
                }
                </div>
            }
        }
        </div>
    </div>
        </div>

        <div class="col-12 col-lg-4">
            <BookmarksSidebar />
        </div>

    </div>

    <ScrollToTopButton />
</div>

@code {
    private List<Faction> factions = new();
    private List<Faction> filteredFactions = new();
    private string searchText = string.Empty;
    private bool loading = true;
    private List<SearchResult> searchResults = new();

    private sealed record SearchResult(string Type, string Name, string Id, string? FactionId, int? DetachmentId, string? Context)
    {
        public string TypeDisplay => Type switch
        {
            "Faction" => "Faction",
            "Detachment" => "Detachment",
            "Datasheet" => "Unit",
            "Stratagem" => "Stratagem",
            "Enhancement" => "Enhancement",
            _ => Type
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (!DB.DatabaseExists)
        {
            loading = false;
            return;
        }

        factions = await Data.GetAllFactionsAsync();
        filteredFactions = factions;
        loading = false;
    }

    private async Task PerformGlobalSearchAsync()
    {
        // If search text empty, reset
        if (string.IsNullOrWhiteSpace(searchText))
        {
            searchResults = new List<SearchResult>();
            filteredFactions = factions;
            StateHasChanged();
            return;
        }

        var q = $"%{searchText}%";
        var results = new List<SearchResult>();

        try
        {
            await using var conn = DB.CreateConnection();
            await conn.OpenAsync();

            // Factions
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "SELECT id, name FROM Factions WHERE name LIKE @q ORDER BY name LIMIT 20";
                cmd.Parameters.AddWithValue("@q", q);
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    results.Add(new SearchResult("Faction", reader.GetString(1), reader.GetString(0), null, null, null));
                }
            }

            // Detachments
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "SELECT id, faction_id, name FROM Detachments WHERE name LIKE @q ORDER BY name LIMIT 20";
                cmd.Parameters.AddWithValue("@q", q);
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    results.Add(new SearchResult("Detachment", reader.GetString(2), reader.GetInt32(0).ToString(), reader.GetString(1), reader.GetInt32(0), null));
                }
            }

            // Datasheets (units)
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "SELECT id, faction_id, name FROM Datasheets WHERE name LIKE @q ORDER BY name LIMIT 40";
                cmd.Parameters.AddWithValue("@q", q);
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    var id = reader.GetInt32(0).ToString();
                    var factionId = reader.IsDBNull(1) ? null : reader.GetString(1);
                    results.Add(new SearchResult("Datasheet", reader.GetString(2), id, factionId, null, factionId));
                }
            }

            // Stratagems
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "SELECT id, faction_id, detachment_id, name FROM Stratagems WHERE name LIKE @q ORDER BY name LIMIT 40";
                cmd.Parameters.AddWithValue("@q", q);
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    var detId = reader.IsDBNull(2) ? (int?)null : reader.GetInt32(2);
                    results.Add(new SearchResult("Stratagem", reader.GetString(3), reader.GetInt32(0).ToString(), reader.IsDBNull(1) ? null : reader.GetString(1), detId, reader.IsDBNull(1) ? null : reader.GetString(1)));
                }
            }

            // Enhancements
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "SELECT id, faction_id, detachment_id, name FROM Enhancements WHERE name LIKE @q ORDER BY name LIMIT 40";
                cmd.Parameters.AddWithValue("@q", q);
                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    var detId = reader.IsDBNull(2) ? (int?)null : reader.GetInt32(2);
                    results.Add(new SearchResult("Enhancement", reader.GetString(3), reader.GetInt32(0).ToString(), reader.IsDBNull(1) ? null : reader.GetString(1), detId, reader.IsDBNull(1) ? null : reader.GetString(1)));
                }
            }
        }
        catch (Exception)
        {
            // ignore errors and keep results empty
        }

        // Simple ordering: factions first, then units, detachments, stratagems, enhancements
        searchResults = results
            .OrderBy(r => r.Type == "Faction" ? 0 : r.Type == "Datasheet" ? 1 : r.Type == "Detachment" ? 2 : r.Type == "Stratagem" ? 3 : 4)
            .ThenBy(r => r.Name)
            .ToList();

        // Also filter displayed faction list if search appears to be a faction name search
        filteredFactions = string.IsNullOrWhiteSpace(searchText)
            ? factions
            : factions.Where(f => f.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();

        StateHasChanged();
    }

    private void NavigateToSearchResult(SearchResult r)
    {
        // Clear results and navigate appropriately
        searchResults.Clear();

        if (r.Type == "Faction")
        {
            Navigation.NavigateTo($"/faction/{r.Id}");
            return;
        }

        if (r.Type == "Datasheet")
        {
            if (!string.IsNullOrEmpty(r.FactionId))
                Navigation.NavigateTo($"/faction/{r.FactionId}/unit/{r.Id}");
            else
                Navigation.NavigateTo($"/unit/{r.Id}");
            return;
        }

        // For detachment/stratagem/enhancement navigate to faction and preselect detachment when available
        if (!string.IsNullOrEmpty(r.FactionId))
        {
            if (r.DetachmentId.HasValue)
            {
                ViewerState.SetFactionContext(r.FactionId!, r.DetachmentId.Value);
            }
            else
            {
                ViewerState.SetFactionContext(r.FactionId!, null);
            }

            Navigation.NavigateTo($"/faction/{r.FactionId}");
            return;
        }

        // Fallback: navigate to root
        Navigation.NavigateTo("/");
    }
}
