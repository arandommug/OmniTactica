@page "/factions"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core

@inject WahaSQLiteService DB
@inject WahaDataService Data

<style>
    .factionList {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }

    @@media (max-width:640px)
    {
        .factionList {
            grid-template-columns: repeat(1, minmax(max-content, 1fr));
        }
    }
</style>

<div class="p-2">
    <div class="row g-2">
        <div class="col-12 col-lg-8">
            <div class="card bg-secondary-subtle">
                <div class="card-header">
                    <h1 class="text-primary">Browse Factions</h1>
                    @if (DB.DatabaseExists && !loading)
                    {
                        <div class="mt-3">
                            <input type="text" 
                                   class="form-control" 
                                   placeholder="Search factions..." 
                                   @bind="searchText"
                                   @bind:event="oninput"
                                   @bind:after="FilterFactions" />
                        </div>
                    }
                </div>
                <div class="card-body">
        @if (!DB.DatabaseExists)
        {
            <div class="alert alert-warning">Database not installed. Go to Settings to download data.</div>
        }
        else if (loading)
        {
            <div class="d-flex align-items-center">
                <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                <div>Loading factions...</div>
            </div>
        }
        else
        {
            @if (filteredFactions.Count == 0)
            {
                <div class="alert alert-info">No factions found matching "@searchText"</div>
            }
            else
            {
                <div class="factionList">
                @foreach (var f in filteredFactions)
                {
                    <NavLink class="card border-primary" href="@($"/faction/{@f.Id}")">
                        <div class="card-body pe-0">
                            <div class="d-flex align-items-center text-nowrap">
                                <div class="w-auto h5 mb-0">@f.Name</div>
                                <icon class="fa fa-chevron-right ms-auto text-end me-3"></icon>
                            </div>
                        </div>
                    </NavLink>
                }
                </div>
            }
        }
        </div>
    </div>
        </div>

        <div class="col-12 col-lg-4">
            <BookmarksSidebar />
        </div>

    </div>

    <ScrollToTopButton />
</div>

@code {
    private List<Faction> factions = new();
    private List<Faction> filteredFactions = new();
    private string searchText = string.Empty;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!DB.DatabaseExists)
        {
            loading = false;
            return;
        }

        factions = await Data.GetAllFactionsAsync();
        filteredFactions = factions;
        loading = false;
    }

    private void FilterFactions()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredFactions = factions;
        }
        else
        {
            filteredFactions = factions
                .Where(f => f.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
}
