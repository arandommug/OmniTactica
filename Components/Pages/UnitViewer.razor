                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>

    <ScrollToTopButton />
</div>

@code {
    [Parameter]
    public string FactionId { get; set; } = string.Empty;

    [Parameter]
    public string DatasheetIdStr { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "detachment")]
    public int? InitialDetachmentId { get; set; }

    private int datasheetId;
    private DatasheetDetail? datasheet;
    private List<Detachment> availableDetachments = new();
    private List<UnitStatlineDisplayItem> uniqueStatlines = new();
    private List<WeaponStatlineDisplayItem> rangedWeapons = new();
    private List<WeaponStatlineDisplayItem> meleeWeapons = new();
    private List<UnitConfigurationView> unitConfigurations = new();
    private List<string> sortedFactionKeywords = new();
    private List<string> sortedKeywords = new();
    private Dictionary<int, List<string>> stratagemDetachmentsById = new();
    private Dictionary<string, List<Stratagem>> organizedStratagems = new();
    private int selectedDetachmentId = 0;
    private bool loading = true;
    private bool stackWeaponAbilities;
    private string previousDatasheetIdStr = string.Empty;
    private readonly string weaponLayoutContainerId = $"unit-viewer-weapon-layout-{Guid.NewGuid():N}";
    private DotNetObjectReference<UnitViewer>? dotNetRef;
    private static readonly HashSet<string> ExpandedAbilityTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Datasheet",
        "Wargear",
        "Primarch",
        "Fortification (левая колонка)"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload when navigating to a different unit (same page, different parameters)
        if (previousDatasheetIdStr != DatasheetIdStr && !string.IsNullOrEmpty(previousDatasheetIdStr))
        {
            await LoadPageAsync();
        }
        previousDatasheetIdStr = DatasheetIdStr;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loading || datasheet == null)
        {
            return;
        }

        dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("weaponAbilityLayout.init", weaponLayoutContainerId, dotNetRef);
    }

    private async Task LoadPageAsync()
    {
        loading = true;
        StateHasChanged();

        if (!DB.DatabaseExists || !int.TryParse(DatasheetIdStr, out datasheetId))
        {
            loading = false;
            return;
        }

        // If FactionId is not provided, fetch it from the datasheet
        if (string.IsNullOrEmpty(FactionId))
        {
            var basicDatasheet = await Data.GetDatasheetByIdAsync(datasheetId);
            if (basicDatasheet != null)
            {
                FactionId = basicDatasheet.FactionId;
            }
        }

        // Ensure state is for correct faction
        if (!string.IsNullOrEmpty(FactionId))
        {
            ViewerState.ResetForFaction(FactionId);
        }

        // Save current datasheet to state
        ViewerState.CurrentDatasheetId = datasheetId;

        // Load available detachments for the faction, filtered by keywords if any are selected
        // Note: Exclude keywords are handled at the database query level
        var includeKeywords = ViewerState.SelectedKeywords.Count > 0 ? ViewerState.SelectedKeywords : null;
        var excludeKeywords = ViewerState.ExcludedKeywords.Count > 0 ? ViewerState.ExcludedKeywords : null;

        if (!string.IsNullOrEmpty(FactionId))
        {
            var overview = await Data.GetFactionOverviewAsync(FactionId, includeKeywords, excludeKeywords, ViewerState.UseAndLogic);
            if (overview != null)
            {
                availableDetachments = overview.Detachments;
            }
        }

        // Priority for detachment selection:
        // 1. Query parameter (InitialDetachmentId)
        // 2. Shared state (ViewerState.SelectedDetachmentId)
        // 3. None (0)
        selectedDetachmentId = 0;

        if (InitialDetachmentId.HasValue && availableDetachments.Any(d => d.Id == InitialDetachmentId.Value))
        {
            selectedDetachmentId = InitialDetachmentId.Value;
        }
        else if (ViewerState.SelectedDetachmentId.HasValue && availableDetachments.Any(d => d.Id == ViewerState.SelectedDetachmentId.Value))
        {
            selectedDetachmentId = ViewerState.SelectedDetachmentId.Value;
        }

        await LoadDatasheetAsync();
        loading = false;
        StateHasChanged();
    }

    private async Task LoadDatasheetAsync()
    {
        int? detachmentFilter = selectedDetachmentId > 0 ? selectedDetachmentId : null;
        datasheet = await Data.GetDatasheetDetailAsync(datasheetId, detachmentFilter);

        if (datasheet == null)
        {
            uniqueStatlines.Clear();
            rangedWeapons.Clear();
            meleeWeapons.Clear();
            unitConfigurations.Clear();
            sortedFactionKeywords.Clear();
            sortedKeywords.Clear();
            stratagemDetachmentsById.Clear();
            organizedStratagems.Clear();
            return;
        }

        uniqueStatlines = StatlineDisplayFactory.CreateDatasheetStatlines(datasheet.Models);

        var weapons = StatlineDisplayFactory.CreateDatasheetWeapons(datasheet.Wargear);
        rangedWeapons = weapons
            .Where(weapon => string.Equals(weapon.Type, "Ranged", StringComparison.OrdinalIgnoreCase))
            .ToList();
        meleeWeapons = weapons
            .Where(weapon => string.Equals(weapon.Type, "Melee", StringComparison.OrdinalIgnoreCase))
            .ToList();
        unitConfigurations = BuildUnitConfigurations(datasheet);

        sortedFactionKeywords = datasheet.FactionKeywords
            .OrderBy(keyword => keyword)
            .ToList();

        sortedKeywords = datasheet.Keywords
            .OrderBy(keyword => keyword)
            .ToList();

        var groupedStratagems = datasheet.Stratagems
            .GroupBy(s => new
            {
                Name = s.Name?.Trim().ToUpperInvariant() ?? string.Empty,
                CpCost = s.CpCost?.Trim() ?? string.Empty,
                Phase = s.Phase?.Trim().ToUpperInvariant() ?? string.Empty
            })
            .Select(group => new
            {
                Stratagem = group.First(),
                Detachments = group.Select(s => s.Detachment)
                    .Distinct()
                    .Where(detachment => !string.IsNullOrEmpty(detachment))
                    .OrderBy(detachment => detachment)
                    .ToList()
            })
            .ToList();

        stratagemDetachmentsById = groupedStratagems.ToDictionary(
            group => group.Stratagem.Id,
            group => group.Detachments);

        organizedStratagems = OrganizeStratagemsByPhase(groupedStratagems.Select(group => group.Stratagem).ToList());
    }

    private async Task OnDetachmentChanged()
    {
        loading = true;
        StateHasChanged();

        // Save to state
        ViewerState.SetDetachment(selectedDetachmentId > 0 ? selectedDetachmentId : null);

        await LoadDatasheetAsync();

        loading = false;
        StateHasChanged();
    }

    private Dictionary<string, List<Stratagem>> OrganizeStratagemsByPhase(List<Stratagem> stratagems)
    {
        return StratagemHelper.OrganizeStratagemsByPhase(stratagems);
    }

    private static bool ShouldExpandAbility(string? abilityType)
    {
        return !string.IsNullOrWhiteSpace(abilityType) && ExpandedAbilityTypes.Contains(abilityType);
    }

    [JSInvokable]
    public Task SetWeaponAbilityLayout(bool shouldStack)
    {
        if (stackWeaponAbilities == shouldStack)
        {
            return Task.CompletedTask;
        }

        stackWeaponAbilities = shouldStack;
        return InvokeAsync(StateHasChanged);
    }

    private string GetTurnBadgeClass(string turn)
    {
        return StratagemHelper.GetTurnBadgeClass(turn);
    }

    private int GetTurnSortOrder(string turn)
    {
        if (string.IsNullOrEmpty(turn)) return 99;

        var turnUpper = turn.Trim().ToUpperInvariant();

        // Priority order: Your Turn (1) -> Either Player's Turn (2) -> Opponent's Turn (3)
        if (turnUpper.Contains("YOUR TURN") || turnUpper.Contains("YOUR COMMAND PHASE") || 
            turnUpper.Contains("YOUR MOVEMENT PHASE") || turnUpper.Contains("YOUR SHOOTING PHASE") || 
            turnUpper.Contains("YOUR CHARGE PHASE") || turnUpper.Contains("YOUR FIGHT PHASE"))
            return 1;

        if (turnUpper.Contains("EITHER PLAYER") || turnUpper.Contains("ANY PHASE") || 
            turnUpper.Contains("EITHER PLAYERS"))
            return 2;

        if (turnUpper.Contains("OPPONENT") || turnUpper.Contains("OPPONENTS"))
            return 3;

        return 99; // Unknown/other turns go last
    }

    private static List<UnitConfigurationView> BuildUnitConfigurations(DatasheetDetail datasheet)
    {
        var configurations = new List<UnitConfigurationView>();
        var compositionOptions = ParseCompositionOptions(datasheet.UnitComposition);
        var usedCompositionIndexes = new HashSet<int>();

        foreach (var cost in datasheet.Costs)
        {
            var description = NormalizeDisplayText(cost.Description);
            var matchingOption = FindMatchingCompositionOption(compositionOptions, usedCompositionIndexes, description);

            if (matchingOption != null)
            {
                usedCompositionIndexes.Add(matchingOption.Index);
                configurations.Add(new UnitConfigurationView(
                    matchingOption.DisplayText,
                    string.Equals(matchingOption.DisplayText, description, StringComparison.OrdinalIgnoreCase) ? string.Empty : description,
                    cost.Cost));
                continue;
            }

            configurations.Add(new UnitConfigurationView(
                string.IsNullOrWhiteSpace(description) ? "Configuration" : description,
                string.Empty,
                cost.Cost));
        }

        foreach (var option in compositionOptions.Where(option => !usedCompositionIndexes.Contains(option.Index)))
        {
            configurations.Add(new UnitConfigurationView(option.DisplayText, string.Empty, null));
        }

        return configurations;
    }

    private static List<CompositionOptionView> ParseCompositionOptions(IEnumerable<DatasheetUnitComposition> compositionEntries)
    {
        var options = new List<CompositionOptionView>();
        var currentEntries = new List<UnitCompositionEntry>();
        var currentDescriptions = new List<string>();
        var index = 0;

        foreach (var compositionEntry in compositionEntries)
        {
            var description = NormalizeDisplayText(compositionEntry.Description);
            if (string.IsNullOrWhiteSpace(description))
            {
                continue;
            }

            if (description.Equals("OR", StringComparison.OrdinalIgnoreCase))
            {
                AddCompositionOption(options, currentEntries, currentDescriptions, ref index);
                currentEntries = new List<UnitCompositionEntry>();
                currentDescriptions = new List<string>();
                continue;
            }

            currentDescriptions.Add(description);
            currentEntries.AddRange(ParseCompositionEntries(description));
        }

        AddCompositionOption(options, currentEntries, currentDescriptions, ref index);
        return options;
    }

    private static void AddCompositionOption(List<CompositionOptionView> options, List<UnitCompositionEntry> entries, List<string> descriptions, ref int index)
    {
        if (entries.Count == 0 && descriptions.Count == 0)
        {
            return;
        }

        var displayText = entries.Count > 0
            ? FormatComposition(entries)
            : string.Join(" • ", descriptions);

        options.Add(new CompositionOptionView(index++, entries, displayText));
    }

    private static CompositionOptionView? FindMatchingCompositionOption(
        IEnumerable<CompositionOptionView> options,
        HashSet<int> usedCompositionIndexes,
        string costDescription)
    {
        var availableOptions = options
            .Where(option => !usedCompositionIndexes.Contains(option.Index))
            .ToList();

        if (availableOptions.Count == 0)
        {
            return null;
        }

        var costEntries = ParseCostDescriptionEntries(costDescription);
        if (costEntries.Count > 0)
        {
            var exactMatch = availableOptions.FirstOrDefault(option => option.Entries.Count > 0 && MatchesCompositionOption(option.Entries, costEntries));
            if (exactMatch != null)
            {
                return exactMatch;
            }

            var targetTotal = costEntries.Sum(entry => entry.Quantity);
            var countMatch = availableOptions.FirstOrDefault(option => option.Entries.Count > 0 && option.Entries.Sum(entry => entry.Quantity) == targetTotal);
            if (countMatch != null)
            {
                return countMatch;
            }
        }

        return availableOptions.Count == 1 ? availableOptions[0] : null;
    }

    private static List<UnitCompositionEntry> ParseCompositionEntries(string description)
    {
        var matches = Regex.Matches(description, @"(\d+)(?:-(\d+))?\s+(.+?)(?=(?:\s+and\s+\d)|$)", RegexOptions.IgnoreCase);
        var entries = new List<UnitCompositionEntry>();

        foreach (Match match in matches)
        {
            if (!match.Success)
            {
                continue;
            }

            var minQuantity = int.Parse(match.Groups[1].Value);
            var maxQuantity = match.Groups[2].Success ? int.Parse(match.Groups[2].Value) : minQuantity;
            var name = match.Groups[3].Value.Trim();
            entries.Add(new UnitCompositionEntry(name, minQuantity, maxQuantity));
        }

        return entries;
    }

    private static List<CostDescriptionEntry> ParseCostDescriptionEntries(string description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return [];
        }

        return description.Split(new[] { " and ", "," }, StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Trim())
            .Select(ParseCostDescriptionEntry)
            .Where(entry => entry != null)
            .Cast<CostDescriptionEntry>()
            .ToList();
    }

    private static CostDescriptionEntry? ParseCostDescriptionEntry(string text)
    {
        var match = Regex.Match(text, @"^(\d+)\s+(.+)$", RegexOptions.IgnoreCase);
        if (!match.Success)
        {
            return null;
        }

        var quantity = int.Parse(match.Groups[1].Value);
        var name = match.Groups[2].Value.Trim();
        var normalizedName = NormalizeName(name);

        return new CostDescriptionEntry(
            quantity,
            name,
            normalizedName is "model" or "models");
    }

    private static bool MatchesCompositionOption(IEnumerable<UnitCompositionEntry> option, IEnumerable<CostDescriptionEntry> costEntries)
    {
        var optionList = option.ToList();
        var costList = costEntries.ToList();

        if (costList.Count == 1 && costList[0].IsGenericModelCount)
        {
            return optionList.Sum(entry => entry.Quantity) == costList[0].Quantity;
        }

        if (optionList.Count != costList.Count)
        {
            return false;
        }

        foreach (var costEntry in costList)
        {
            var matchingEntry = optionList.FirstOrDefault(entry => NamesMatch(entry.Name, costEntry.Name));
            if (matchingEntry == null || matchingEntry.Quantity != costEntry.Quantity)
            {
                return false;
            }
        }

        return true;
    }

    private static string FormatComposition(IEnumerable<UnitCompositionEntry> entries)
        => string.Join(" and ", entries.Select(entry => $"{entry.Quantity} {entry.Name}"));

    private static bool NamesMatch(string modelName, string costName)
    {
        var normalizedModel = NormalizeName(modelName);
        var normalizedCost = NormalizeName(costName);

        return normalizedModel == normalizedCost
               || normalizedModel.Contains(normalizedCost, StringComparison.OrdinalIgnoreCase)
               || normalizedCost.Contains(normalizedModel, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeName(string value)
    {
        var normalizedWords = Regex.Replace(value.ToLowerInvariant(), @"[^a-z0-9\s]", " ")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => word.Length > 3 && word.EndsWith('s') ? word[..^1] : word);

        return string.Join(' ', normalizedWords);
    }

    private static string NormalizeDisplayText(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : HtmlUtility.ConvertHtmlToPlainText(value).Trim();

    private sealed record UnitConfigurationView(string Title, string Subtitle, int? Cost);
    private sealed record CompositionOptionView(int Index, List<UnitCompositionEntry> Entries, string DisplayText);
    private sealed record CostDescriptionEntry(int Quantity, string Name, bool IsGenericModelCount);
    private sealed record UnitCompositionEntry(string Name, int MinQuantity, int MaxQuantity)
    {
        public int Quantity => MinQuantity;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("weaponAbilityLayout.dispose", weaponLayoutContainerId);
        }
        catch
        {
        }

        dotNetRef?.Dispose();
    }
}

