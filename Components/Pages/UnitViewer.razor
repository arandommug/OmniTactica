@page "/faction/{FactionId}/unit/{DatasheetIdStr}"
@page "/unit/{DatasheetIdStr}"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Data.Import
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core
@using OmniTactica.AppCode.Models.Rules
@using OmniTactica.AppCode.Helpers

@inject WahaSQLiteService DB
@inject WahaDataService Data
@inject NavigationManager Navigation
@inject FactionViewerState ViewerState

<div class="d-flex flex-column" style="height: 100vh; padding: 0.5rem;">
    <div class="row g-2 flex-grow-1" style="min-height: 0; margin: 0 0 0.5rem 0;">
        <!-- Unit Details Card -->
        <div class="col-12 col-xxl-6 d-flex flex-column" style="min-height: 0; height: 100%; padding-bottom: 0.5rem;">
            <div class="card bg-secondary-subtle d-flex flex-column" style="min-height: 0; height: 100%;">
                <div class="card-header d-flex align-items-center justify-content-between flex-shrink-0">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(FactionId))
                        {
                            <NavLink class="btn btn-dark btn-sm w-auto" href="@($"/faction/{FactionId}/units")">
                                <i class="fa fa-chevron-left" aria-hidden="true"></i>
                            </NavLink>
                        }
                        else
                        {
                            <NavLink class="btn btn-dark btn-sm w-auto" href="/">
                                <i class="fa fa-chevron-left" aria-hidden="true"></i>
                            </NavLink>
                        }

                        @if (loading || datasheet == null)
                        {
                            <h1 class="text-primary m-0 ms-3">Unit</h1>
                        }
                        else
                        {
                            <h1 class="text-primary m-0 ms-3">@datasheet.Name</h1>

                            <!-- Points Costs -->
                            @if (datasheet.Costs.Count > 0)
                            {
                                <div class="ms-3">
                                    @foreach (var cost in datasheet.Costs)
                                    {
                                        <div class="d-inline-block me-3 my-lg-0 my-1">
                                            <span class="badge bg-success fs-6 me-2">@cost.Cost pts</span>
                                            @if (!string.IsNullOrEmpty(cost.Description))
                                            {
                                                <span>@cost.Description</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                    @if (!loading && datasheet != null)
                    {
                        <DatasheetBookmarkButton DatasheetId="@datasheetId" DatasheetName="@datasheet.Name" FactionId="@FactionId" />
                    }
                </div>
                <div class="card-body overlay-scrollbar" style="overflow-y: auto; overflow-x: hidden; flex: 1 1 auto; min-height: 0;">
                    <div class="row">
                        @if (loading)
                        {
                            <div class="d-flex align-items-center">
                                <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                                <div>Loading unit details...</div>
                            </div>
                        }
                        else if (datasheet == null)
                        {
                            <div class="alert alert-danger">Unit not found.</div>
                        }
                        else
                        {
                            <!-- LEFT COLUMN: Models & Weapons -->
                            <div class="p-1 col-12 col-lg-6">
                                <!-- Models (Stat Line) -->
                                @if (datasheet.Models.Count > 0)
                                {
                                    var uniqueStatlines = datasheet.Models
                                        .GroupBy(d => new { d.M, d.T, d.Sv, d.W, d.Ld, d.OC, d.InvSv, d.InvSvDescr })
                                        .Select(grp => new
                                        {
                                            Names = string.Join(", ", grp.Select(m => m.Name)),
                                            grp.Key.M,
                                            grp.Key.T,
                                            grp.Key.Sv,
                                            grp.Key.W,
                                            grp.Key.Ld,
                                            grp.Key.OC,
                                            grp.Key.InvSv,
                                            grp.Key.InvSvDescr
                                        }).AsEnumerable();

                                    @foreach (var statline in uniqueStatlines)
                                    {
                                        var hasInvDesc = !string.IsNullOrEmpty(statline.InvSvDescr.Trim());
                                        if (uniqueStatlines.Count() > 1)
                                        {
                                        <div class="card bg-primary mb-2">
                                            <div class="card-header p-2 fw-bold">@statline.Names</div>
                                        </div>
                                        }
                                        <table class="table table-borderless text-center mb-1">
                                            <thead class="table-dark border-bottom-2 border-opacity-1">
                                                <tr>
                                                    <th class="rounded-top-3 rounded-end-0">M</th>
                                                    <th>T</th>
                                                    <th>SV</th>
                                                    <th>W</th>
                                                    <th>Ld</th>
                                                    <th class="rounded-top-3 rounded-start-0">OC</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr class="rounded-3">
                                                    <td class="@(hasInvDesc ? "" : "rounded-bottom-3 rounded-end-0")">@statline.M</td>
                                                    <td>@statline.T</td>
                                                    <td>
                                                        @statline.Sv
                                                        @if (!string.IsNullOrEmpty(statline.InvSv.Trim()) && statline.InvSv.Trim() != "-")
                                                        {
                                                            @("/" + statline.InvSv + "++" + (hasInvDesc ? "*" : ""))
                                                        }
                                                    </td>
                                                    <td>@statline.W</td>
                                                    <td>@statline.Ld</td>
                                                    <td class="@(hasInvDesc ? "" : "rounded-bottom-3 rounded-start-0")">@statline.OC</td>
                                                </tr>
                                                @if (hasInvDesc)
                                                {
                                                <tr>
                                                    <td colspan="6" class="text-start rounded-bottom-3">@("*" + statline.InvSvDescr)</td>
                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }

                                <!-- Unit Composition -->
                                @if (datasheet.UnitComposition.Count > 0)
                                {
                                    <div class="p-1 mb-3">
                                        <h5 class="text-primary">Unit Composition</h5>
                                        <ul class="list-group">
                                            @foreach (var composition in datasheet.UnitComposition)
                                            {
                                                <li class="list-group-item">
                                                    <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(composition.Description))</div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <!-- Loadout -->
                                @if (!string.IsNullOrEmpty(datasheet.Loadout))
                                {
                                    <div class="p-1">
                                        <h5 class="text-primary">Loadout</h5>
                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.Loadout))</div>
                                    </div>
                                }

                                <!-- Wargear (Weapons) -->
                                @if (datasheet.Wargear.Count > 0)
                                {
                                    var ranged = datasheet.Wargear.Where(wep => wep.Type == "Ranged").ToList();
                                    var melee = datasheet.Wargear.Where(wep => wep.Type == "Melee").ToList();
                                    var expandRanged = ranged.Any();

                                    <div class="accordion" id="weaponsAccordion">
                                        @if (ranged.Any())
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button @(expandRanged ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#rangedWeapons" aria-expanded="@expandRanged.ToString().ToLower()">
                                                        Ranged Weapons
                                                        <span class="badge bg-info ms-2">@ranged.Count</span>
                                                    </button>
                                                </h2>
                                                <div id="rangedWeapons" class="accordion-collapse collapse @(expandRanged ? "show" : "")" data-bs-parent="#weaponsAccordion">
                                                    <div class="accordion-body p-2">
                                                        @foreach (var weapon in ranged)
                                                        {
                                                            <div class="card mb-2">
                                                                <div class="card-body p-2">
                                                                    <div class="mb-2">
                                                                        <h6 class="card-title mb-0 d-inline m-1">@weapon.Name</h6>
                                                                        @if (!string.IsNullOrEmpty(weapon.Description))
                                                                        {
                                                                            @((MarkupString)string.Join("", weapon.Description.Split(",").Select(desc => $"<span class='badge bg-secondary mx-1 mb-1'>{desc.Trim()}</span>")))
                                                                        }
                                                                    </div>
                                                                    <div class="row g-2 text-center small mt-2 text-nowrap">
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">Range</div>
                                                                            <div class="fw-bold">@weapon.Range</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">A</div>
                                                                            <div class="fw-bold">@weapon.A</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">BS</div>
                                                                            <div class="fw-bold">@weapon.BsWs</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">S</div>
                                                                            <div class="fw-bold">@weapon.S</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">AP</div>
                                                                            <div class="fw-bold">@weapon.AP</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">D</div>
                                                                            <div class="fw-bold">@weapon.D</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (melee.Any())
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button @(expandRanged ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#meleeWeapons" aria-expanded="@(!expandRanged).ToString().ToLower()">
                                                        Melee Weapons
                                                        <span class="badge bg-info ms-2">@melee.Count</span>
                                                    </button>
                                                </h2>
                                                <div id="meleeWeapons" class="accordion-collapse collapse @(expandRanged ? "" : "show")" data-bs-parent="#weaponsAccordion">
                                                    <div class="accordion-body p-2">
                                                        @foreach (var weapon in melee)
                                                        {
                                                            <div class="card mb-2">
                                                                <div class="card-body p-2">
                                                                    <div class="mb-2">
                                                                        <h6 class="card-title mb-0 d-inline">@weapon.Name</h6>
                                                                        @if (!string.IsNullOrEmpty(weapon.Description))
                                                                        {
                                                                            <span class="ms-2">@((MarkupString)string.Join("", weapon.Description.Split(",").Select(desc => $"<span class='badge bg-secondary me-1'>{desc.Trim()}</span>")))</span>
                                                                        }
                                                                    </div>
                                                                    <div class="row g-2 text-center small mt-2">
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">Range</div>
                                                                            <div class="fw-bold">@weapon.Range</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">A</div>
                                                                            <div class="fw-bold">@weapon.A</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">WS</div>
                                                                            <div class="fw-bold">@weapon.BsWs</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">S</div>
                                                                            <div class="fw-bold">@weapon.S</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">AP</div>
                                                                            <div class="fw-bold">@weapon.AP</div>
                                                                        </div>
                                                                        <div class="col-4 col-sm-2">
                                                                            <div class="text-muted">D</div>
                                                                            <div class="fw-bold">@weapon.D</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- RIGHT COLUMN: Abilities -->
                            <div class="p-1 col-12 col-lg-6">
                                @if (datasheet.Abilities.Count > 0)
                                {
                                    <div class="accordion">
                                        @foreach (var ability in datasheet.Abilities)
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button @("Datasheet|Wargear|Primarch|Fortification (левая колонка)".Contains(ability.Type) ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#ability-@(ability.Line)" aria-expanded="false">
                                                        @ability.Name
                                                        @if (!string.IsNullOrEmpty(ability.Type) && ability.Type != "Fortification (левая колонка)" && ability.Type != "Special (правая колонка)")
                                                        {
                                                            <span class="badge bg-secondary ms-2">@ability.Type</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(ability.Parameter))
                                                        {
                                                            <span class="badge bg-info ms-1">@ability.Parameter</span>
                                                        }
                                                    </button>
                                                </h2>
                                                <div id="ability-@(ability.Line)" class="accordion-collapse collapse @("Datasheet|Wargear|Primarch|Fortification (левая колонка)".Contains(ability.Type) ? "show" : "")">
                                                    <div class="accordion-body rule-content">
                                                        @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Wargear Options & Leader (Side by Side) -->
                            @if (datasheet.Options.Count > 0 || datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0)
                            {
                                <!-- Wargear Options -->
                                @if (datasheet.Options.Count > 0)
                                {
                                    <div class="p-1 col-12 @(datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0 ? "col-lg-6" : "")">
                                        <div class="accordion mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wargearOptions" aria-expanded="false">
                                                        Wargear Options
                                                        <span class="badge bg-info ms-2">@datasheet.Options.Count</span>
                                                    </button>
                                                </h2>
                                                <div id="wargearOptions" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2">
                                                        <ul class="list-group list-group-flush">
                                                            @foreach (var option in datasheet.Options)
                                                            {
                                                                <li class="list-group-item px-0">
                                                                    @if (option.Button != "*")
                                                                    {
                                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(@option.Button + " " + option.Description))</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Description + @option.Button))</div>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Leader Relationships -->
                                @if (datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0)
                                {
                                    <div class="p-1 col-12 @(datasheet.Options.Count > 0 ? "col-lg-6" : "")">
                                        <div class="accordion mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#leaderOptions" aria-expanded="false">
                                                        Leader
                                                        <span class="badge bg-info ms-2">@(datasheet.CanLead.Count + datasheet.LeadBy.Count)</span>
                                                    </button>
                                                </h2>
                                                <div id="leaderOptions" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2">
                                                        @if (!string.IsNullOrEmpty(datasheet.LeaderHead))
                                                        {
                                                            <div class="rule-content mb-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderHead))</div>
                                                        }
                                                        @if (datasheet.CanLead.Count > 0)
                                                        {
                                                            <div class="mb-3">
                                                                <strong class="d-block mb-2">Can lead:</strong>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @foreach (var unit in datasheet.CanLead)
                                                                    {
                                                                        <NavLink class="badge bg-primary text-decoration-none" href="@($"/faction/{FactionId}/unit/{unit.DatasheetId}")">@unit.Name</NavLink>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (datasheet.LeadBy.Count > 0)
                                                        {
                                                            <div class="mb-2">
                                                                <strong class="d-block mb-2">Can be led by:</strong>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @foreach (var unit in datasheet.LeadBy)
                                                                    {
                                                                        <NavLink class="badge bg-secondary text-decoration-none" href="@($"/faction/{FactionId}/unit/{unit.DatasheetId}")">@unit.Name</NavLink>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(datasheet.LeaderFooter))
                                                        {
                                                            <div class="rule-content mt-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderFooter))</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                            <!-- Transport -->
                            @if (!string.IsNullOrEmpty(datasheet.Transport))
                            {
                                <div class="p-1 col-12">
                                    <div class="accordion mb-2">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#transportInfo" aria-expanded="false">
                                                    Transport
                                                </button>
                                            </h2>
                                            <div id="transportInfo" class="accordion-collapse collapse">
                                                <div class="accordion-body p-2 rule-content">
                                                    @((MarkupString)WahaDataImporter.CleanHtml(datasheet.Transport))
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Damaged -->
                            @if (!string.IsNullOrEmpty(datasheet.DamagedW) || !string.IsNullOrEmpty(datasheet.DamagedDescription))
                            {
                                <div class="mb-4">
                                    <h5 class="text-primary">Damaged</h5>
                                    @if (!string.IsNullOrEmpty(datasheet.DamagedW))
                                    {
                                        <div><strong>Damaged:</strong> @datasheet.DamagedW</div>
                                    }
                                    @if (!string.IsNullOrEmpty(datasheet.DamagedDescription))
                                    {
                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.DamagedDescription))</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
                <!-- Keywords Footer -->
                @if (!loading && datasheet != null && (datasheet.FactionKeywords.Count > 0 || datasheet.Keywords.Count > 0))
                {
                    <div class="card-footer bg-secondary-subtle flex-shrink-0">
                        @if (datasheet.FactionKeywords.Count > 0)
                        {
                            <div class="mb-2">
                                <span class="text-muted me-2">Faction Keyword(s):</span>
                                @foreach (var kw in datasheet.FactionKeywords.OrderBy(k => k))
                                {
                                    <span class="badge bg-primary me-1">@kw</span>
                                }
                            </div>
                        }
                        @if (datasheet.Keywords.Count > 0)
                        {
                            <div class="@(datasheet.FactionKeywords.Count > 0 ? "" : "mb-0")">
                                <span class="text-muted me-2">Keywords:</span>
                                @foreach (var kw in datasheet.Keywords.OrderBy(k => k))
                                {
                                    <span class="badge bg-info me-1">@kw</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    <!-- Detachment Card -->
    @if (datasheet != null && (availableDetachments.Count > 0 || datasheet.DetachmentAbilities.Count > 0 || datasheet.Enhancements.Count > 0 || datasheet.Stratagems.Count > 0))
    {
        <div class="col-12 col-xxl-6 d-flex flex-column" style="min-height: 0; height: 100%; padding-bottom: 0.5rem;">
            <div class="card bg-secondary-subtle d-flex flex-column" style="min-height: 0; height: 100%;">
                <div class="card-header flex-shrink-0">
                    <h5 class="text-primary m-0">Detachment Rules</h5>
                </div>
                <div class="card-body overlay-scrollbar" style="overflow-y: auto; overflow-x: hidden; flex: 1 1 auto; min-height: 0;">
                    <div class="row">
                <!-- Detachment Selector -->
                    @if (availableDetachments.Count > 0)
                    {
                        <div class="p-1 col-12">
                            <select id="detachmentSelect" class="form-select" @bind="selectedDetachmentId" @bind:after="OnDetachmentChanged">
                                <option value="0">All Detachments</option>
                                @foreach (var d in availableDetachments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                    }

                        <!-- LEFT COLUMN: Detachment Abilities & Enhancements -->
                        <div class="p-1 col-12 col-lg-6">
                            <!-- Detachment Abilities -->
                            @if (datasheet.DetachmentAbilities.Count > 0)
                            {
                                <div class="mb-4">
                                    <h6 class="text-secondary mb-2">Detachment Abilitie(s)</h6>
                                    <div class="accordion">
                                        @foreach (var ability in datasheet.DetachmentAbilities)
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#det-ability-@(ability.Id)" aria-expanded="false">
                                                        @ability.Name
                                                    </button>
                                                </h2>
                                                 <div id="det-ability-@(ability.Id)" class="accordion-collapse collapse">
                                                    <div class="accordion-body rule-content">
                                                        @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Enhancements -->
                            @if (datasheet.Enhancements.Count > 0)
                            {
                                <div class="mb-4">
                                    <h6 class="text-secondary mb-2">Enhancements</h6>
                                    <div class="accordion">
                                        @foreach (var enhancement in datasheet.Enhancements)
                                        {
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#enh-@(enhancement.Id)" aria-expanded="false">
                                                        @enhancement.Name
                                                        <span class="badge bg-success text-white ms-2">@enhancement.Cost pts</span>
                                                    </button>
                                                </h2>
                                                <div id="enh-@(enhancement.Id)" class="accordion-collapse collapse">
                                                    <div class="accordion-body rule-content">
                                                        @((MarkupString)WahaDataImporter.CleanHtml(enhancement.Description))
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- RIGHT COLUMN: Stratagems -->
                        <div class="p-1 col-12 col-lg-6">
                            @if (datasheet.Stratagems.Count > 0)
                            {
                                var groupedStratagems = datasheet.Stratagems
                                    .GroupBy(s => new { 
                                        Name = s.Name?.Trim().ToUpperInvariant() ?? "",
                                        CpCost = s.CpCost?.Trim() ?? "",
                                        Phase = s.Phase?.Trim().ToUpperInvariant() ?? ""
                                    })
                                    .Select(g => new {
                                        Stratagem = g.First(),
                                        Detachments = g.Select(s => s.Detachment).Distinct().Where(d => !string.IsNullOrEmpty(d)).OrderBy(d => d).ToList(),
                                        AllStratagems = g.ToList()
                                    })
                                    .ToList();

                                var organizedStratagems = OrganizeStratagemsByPhase(groupedStratagems.Select(g => g.Stratagem).ToList());

                                <div class="mb-4">
                                    @foreach (var phaseGroup in organizedStratagems)
                                    {
                                        <div class="mb-3">
                                            <h6 class="text-secondary mb-2">@phaseGroup.Key</h6>
                                            <div class="accordion">
                                            @foreach (var strat in phaseGroup.Value.OrderBy(s => GetTurnSortOrder(s.Turn)).ThenBy(s => s.Name))
                                            {
                                                var group = groupedStratagems.First(g => g.Stratagem.Id == strat.Id);
                                                var turnBadgeClass = GetTurnBadgeClass(strat.Turn);

                                                <div class="accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button collapsed flex-wrap py-2" type="button" data-bs-toggle="collapse" data-bs-target="#strat-@(strat.Id)" aria-expanded="false">
                                                            <div class="d-flex flex-wrap justify-content-between" style="width: 90%; display: grid;">
                                                                <div class="d-inline-block text-nowrap my-1 me-2">
                                                                    @strat.Name
                                                                </div>
                                                                <div class="d-inline-block my-1 text-nowrap">
                                                                @if (!string.IsNullOrEmpty(strat.Turn))
                                                                {
                                                                    <span class="badge @turnBadgeClass me-2">@strat.Turn</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(strat.CpCost))
                                                                {
                                                                    <span class="badge bg-warning text-dark">@strat.CpCost CP</span>
                                                                }
                                                                </div>
                                                            </div>
                                                        </button>
                                                    </h2>
                                                    <div id="strat-@(strat.Id)" class="accordion-collapse collapse">
                                                        <div class="accordion-body rule-content">
                                                            <div class="mb-2">
                                                                @if (group.Detachments.Count > 1)
                                                                {
                                                                    <span class="badge bg-secondary me-1 mb-1">Found in @group.Detachments.Count detachments</span>
                                                                }
                                                                else if (!string.IsNullOrEmpty(strat.Type))
                                                                {
                                                                    <span class="badge bg-secondary me-1 mb-1">@strat.Type</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(strat.Phase))
                                                                {
                                                                    <span class="badge bg-info me-1">@strat.Phase</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(strat.Turn))
                                                                {
                                                                    <span class="badge @turnBadgeClass me-1">@strat.Turn</span>
                                                                }
                                                            </div>
                                                            @((MarkupString)WahaDataImporter.CleanHtml(strat.Description))
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>

    <ScrollToTopButton />
</div>

@code {
    [Parameter]
    public string FactionId { get; set; } = string.Empty;

    [Parameter]
    public string DatasheetIdStr { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "detachment")]
    public int? InitialDetachmentId { get; set; }

    private int datasheetId;
    private DatasheetDetail? datasheet;
    private List<Detachment> availableDetachments = new();
    private int selectedDetachmentId = 0;
    private bool loading = true;
    private string previousDatasheetIdStr = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload when navigating to a different unit (same page, different parameters)
        if (previousDatasheetIdStr != DatasheetIdStr && !string.IsNullOrEmpty(previousDatasheetIdStr))
        {
            await LoadPageAsync();
        }
        previousDatasheetIdStr = DatasheetIdStr;
    }

    private async Task LoadPageAsync()
    {
        loading = true;
        StateHasChanged();

        if (!DB.DatabaseExists || !int.TryParse(DatasheetIdStr, out datasheetId))
        {
            loading = false;
            return;
        }

        // If FactionId is not provided, fetch it from the datasheet
        if (string.IsNullOrEmpty(FactionId))
        {
            var basicDatasheet = await Data.GetDatasheetByIdAsync(datasheetId);
            if (basicDatasheet != null)
            {
                FactionId = basicDatasheet.FactionId;
            }
        }

        // Ensure state is for correct faction
        if (!string.IsNullOrEmpty(FactionId))
        {
            ViewerState.ResetForFaction(FactionId);
        }

        // Save current datasheet to state
        ViewerState.CurrentDatasheetId = datasheetId;

        // Load available detachments for the faction, filtered by keywords if any are selected
        // Note: Exclude keywords are handled at the database query level
        var includeKeywords = ViewerState.SelectedKeywords.Count > 0 ? ViewerState.SelectedKeywords : null;
        var excludeKeywords = ViewerState.ExcludedKeywords.Count > 0 ? ViewerState.ExcludedKeywords : null;

        if (!string.IsNullOrEmpty(FactionId))
        {
            var overview = await Data.GetFactionOverviewAsync(FactionId, includeKeywords, excludeKeywords, ViewerState.UseAndLogic);
            if (overview != null)
            {
                availableDetachments = overview.Detachments;
            }
        }

        // Priority for detachment selection:
        // 1. Query parameter (InitialDetachmentId)
        // 2. Shared state (ViewerState.SelectedDetachmentId)
        // 3. None (0)
        if (InitialDetachmentId.HasValue && availableDetachments.Any(d => d.Id == InitialDetachmentId.Value))
        {
            selectedDetachmentId = InitialDetachmentId.Value;
        }
        else if (ViewerState.SelectedDetachmentId.HasValue && availableDetachments.Any(d => d.Id == ViewerState.SelectedDetachmentId.Value))
        {
            selectedDetachmentId = ViewerState.SelectedDetachmentId.Value;
        }

        await LoadDatasheetAsync();
        loading = false;
        StateHasChanged();
    }

    private async Task LoadDatasheetAsync()
    {
        int? detachmentFilter = selectedDetachmentId > 0 ? selectedDetachmentId : null;
        datasheet = await Data.GetDatasheetDetailAsync(datasheetId, detachmentFilter);
    }

    private async Task OnDetachmentChanged()
    {
        loading = true;
        StateHasChanged();

        // Save to state
        ViewerState.SetDetachment(selectedDetachmentId > 0 ? selectedDetachmentId : null);

        await LoadDatasheetAsync();

        loading = false;
        StateHasChanged();
    }

    private Dictionary<string, List<Stratagem>> OrganizeStratagemsByPhase(List<Stratagem> stratagems)
    {
        return StratagemHelper.OrganizeStratagemsByPhase(stratagems);
    }

    private List<string> DeterminePhases(string phase)
    {
        return StratagemHelper.DeterminePhases(phase);
    }

    private string GetTurnBadgeClass(string turn)
    {
        return StratagemHelper.GetTurnBadgeClass(turn);
    }

    private int GetTurnSortOrder(string turn)
    {
        if (string.IsNullOrEmpty(turn)) return 99;

        var turnUpper = turn.Trim().ToUpperInvariant();

        // Priority order: Your Turn (1) -> Either Player's Turn (2) -> Opponent's Turn (3)
        if (turnUpper.Contains("YOUR TURN") || turnUpper.Contains("YOUR COMMAND PHASE") || 
            turnUpper.Contains("YOUR MOVEMENT PHASE") || turnUpper.Contains("YOUR SHOOTING PHASE") || 
            turnUpper.Contains("YOUR CHARGE PHASE") || turnUpper.Contains("YOUR FIGHT PHASE"))
            return 1;

        if (turnUpper.Contains("EITHER PLAYER") || turnUpper.Contains("ANY PHASE") || 
            turnUpper.Contains("EITHER PLAYERS"))
            return 2;

        if (turnUpper.Contains("OPPONENT") || turnUpper.Contains("OPPONENTS"))
            return 3;

        return 99; // Unknown/other turns go last
    }
}

