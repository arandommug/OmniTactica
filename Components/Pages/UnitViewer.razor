@page "/faction/{FactionId}/unit/{DatasheetIdStr}"
@page "/unit/{DatasheetIdStr}"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Data.Import
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core
@using OmniTactica.AppCode.Models.Rules
@using OmniTactica.AppCode.Helpers
@using OmniTactica.AppCode.Utilities
@using Microsoft.JSInterop
@using System.Text.RegularExpressions

@inject WahaSQLiteService DB
@inject WahaDataService Data
@inject NavigationManager Navigation
@inject FactionViewerState ViewerState
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    .unit-viewer-shell {
        height: 100vh;
        padding: 0.5rem;
    }

    .unit-viewer-column,
    .unit-viewer-card {
        min-height: 0;
        height: 100%;
    }

    .unit-viewer-scroll {
        overflow-y: auto;
        overflow-x: hidden;
        flex: 1 1 auto;
        min-height: 0;
    }

    @@media (max-width: 991.98px) {
        .unit-viewer-shell {
            height: auto;
            min-height: 100vh;
        }

        .unit-viewer-column,
        .unit-viewer-card {
            height: auto;
        }

        .unit-viewer-scroll {
            overflow: visible;
        }
    }
</style>

<div class="d-flex flex-column unit-viewer-shell" id="@weaponLayoutContainerId">
    <div class="row g-2 flex-grow-1" style="min-height: 0; margin: 0 0 0.5rem 0;">
        <!-- Unit Details Card -->
        <div class="col-12 col-xxl-6 d-flex flex-column unit-viewer-column" style="padding-bottom: 0.5rem;">
            <div class="card bg-secondary-subtle d-flex flex-column unit-viewer-card">
                <div class="card-header d-flex align-items-center justify-content-between flex-shrink-0">
                    <div class="d-flex align-items-center">
                        <BackButton FallbackHref="@(string.IsNullOrEmpty(FactionId) ? "/" : $"/faction/{FactionId}/units")" />

                        @if (loading || datasheet == null)
                        {
                            <h1 class="text-primary m-0 ms-3">Unit</h1>
                        }
                        else
                        {
                            <h1 class="text-primary m-0 ms-3">@datasheet.Name</h1>
                        }
                    </div>
                    @if (!loading && datasheet != null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <DatasheetBookmarkButton DatasheetId="@datasheetId" DatasheetName="@datasheet.Name" FactionId="@FactionId" />
                        </div>
                    }
                </div>
                <div class="card-body overlay-scrollbar unit-viewer-scroll">
                    <div class="row">
                        @if (loading)
                        {
                            <div class="d-flex align-items-center">
                                <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                                <div>Loading unit details...</div>
                            </div>
                        }
                        else if (datasheet == null)
                        {
                            <div class="alert alert-danger">Unit not found.</div>
                        }
                        else
                        {
                            <div class="d-none d-lg-block col-12 col-lg-6">
                                <div class="p-1">
                                    @if (uniqueStatlines.Count > 0)
                                    {
                                        <UnitStatlineTable Items="uniqueStatlines" />
                                    }

                                    @if (rangedWeapons.Count > 0 || meleeWeapons.Count > 0)
                                    {
                                        var expandRanged = rangedWeapons.Any();

                                        <div class="accordion mt-3" id="weaponsAccordion">
                                            @if (rangedWeapons.Any())
                                            {
                                                <div class="accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button @(expandRanged ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#rangedWeapons" aria-expanded="@expandRanged.ToString().ToLower()">
                                                            Ranged Weapons
                                                            <span class="badge bg-info ms-2">@rangedWeapons.Count</span>
                                                        </button>
                                                    </h2>
                                                    <div id="rangedWeapons" class="accordion-collapse collapse @(expandRanged ? "show" : "")" data-bs-parent="#weaponsAccordion">
                                                        <div class="accordion-body p-2">
                                                            <WeaponStatlineCards Weapons="rangedWeapons" StackAbilities="@stackWeaponAbilities" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (meleeWeapons.Any())
                                            {
                                                <div class="accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button @(expandRanged ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#meleeWeapons" aria-expanded="@(!expandRanged).ToString().ToLower()">
                                                            Melee Weapons
                                                            <span class="badge bg-info ms-2">@meleeWeapons.Count</span>
                                                        </button>
                                                    </h2>
                                                    <div id="meleeWeapons" class="accordion-collapse collapse @(expandRanged ? "" : "show")" data-bs-parent="#weaponsAccordion">
                                                        <div class="accordion-body p-2">
                                                            <WeaponStatlineCards Weapons="meleeWeapons" StackAbilities="@stackWeaponAbilities" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (datasheet.Options.Count > 0)
                                    {
                                        <div class="accordion mt-3 mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wargearOptions" aria-expanded="false">
                                                        Wargear Options
                                                        <span class="badge bg-info ms-2">@datasheet.Options.Count</span>
                                                    </button>
                                                </h2>
                                                <div id="wargearOptions" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2">
                                                        <ul class="list-group list-group-flush">
                                                            @foreach (var option in datasheet.Options)
                                                            {
                                                                <li class="list-group-item px-0">
                                                                    @if (option.Button != "*")
                                                                    {
                                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(@option.Button + " " + option.Description))</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Description + @option.Button))</div>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>

                            <div class="d-none d-lg-block col-12 col-lg-6">
                                <div class="p-1">
                                    @if (datasheet.Abilities.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                            <div class="fw-bold">Abilities</div>
                                        </div>
                                        <div class="accordion">
                                            @foreach (var ability in datasheet.Abilities)
                                            {
                                                var shouldExpand = ShouldExpandAbility(ability.Type);

                                                <div class="accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button @(shouldExpand ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#ability-@(ability.Line)" aria-expanded="@shouldExpand.ToString().ToLower()">
                                                            @ability.Name
                                                            @if (!string.IsNullOrEmpty(ability.Type) && ability.Type != "Fortification (левая колонка)" && ability.Type != "Special (правая колонка)")
                                                            {
                                                                <span class="badge bg-secondary ms-2">@ability.Type</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(ability.Parameter))
                                                            {
                                                                <span class="badge bg-info ms-1">@ability.Parameter</span>
                                                            }
                                                        </button>
                                                    </h2>
                                                    <div id="ability-@(ability.Line)" class="accordion-collapse collapse @(shouldExpand ? "show" : "")">
                                                        <div class="accordion-body rule-content">
                                                            @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(datasheet.Loadout) || unitConfigurations.Count > 0)
                                    {
                                        <div class="mt-3">
                                            <h5 class="text-primary mb-3">Unit Setup</h5>

                                            @if (!string.IsNullOrWhiteSpace(datasheet.Loadout))
                                            {
                                                <div class="mb-3">
                                                    <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Loadout</div>
                                                    <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.Loadout))</div>
                                                </div>
                                            }

                                            @if (unitConfigurations.Count > 0)
                                            {
                                                <div>
                                                    <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Unit Sizes & Points</div>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var configuration in unitConfigurations)
                                                        {
                                                            <div class="rounded-4 px-3 py-2 border border-success border-opacity-25 bg-success bg-opacity-10">
                                                                <div class="d-flex align-items-start justify-content-between gap-2 lh-sm">
                                                                    <div class="min-w-0 flex-grow-1">
                                                                        <div class="fw-semibold">@configuration.Title</div>
                                                                        @if (!string.IsNullOrWhiteSpace(configuration.Subtitle))
                                                                        {
                                                                            <div class="small text-secondary mt-1">@configuration.Subtitle</div>
                                                                        }
                                                                    </div>
                                                                    @if (configuration.Cost.HasValue)
                                                                    {
                                                                        <span class="badge bg-success text-nowrap flex-shrink-0">@configuration.Cost.Value pts</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                    @if (!string.IsNullOrEmpty(datasheet.Transport))
                                    {
                                        <div class="accordion mt-3 mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#transportInfoDesktop" aria-expanded="false">
                                                        Transport
                                                    </button>
                                                </h2>
                                                <div id="transportInfoDesktop" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2 rule-content">
                                                        @((MarkupString)WahaDataImporter.CleanHtml(datasheet.Transport))
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(datasheet.DamagedW) || !string.IsNullOrEmpty(datasheet.DamagedDescription))
                                    {
                                        <div class="mt-3">
                                            <h5 class="text-primary">Damaged</h5>
                                            @if (!string.IsNullOrEmpty(datasheet.DamagedW))
                                            {
                                                <div><strong>Damaged:</strong> @datasheet.DamagedW</div>
                                            }
                                            @if (!string.IsNullOrEmpty(datasheet.DamagedDescription))
                                            {
                                                <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.DamagedDescription))</div>
                                            }
                                        </div>
                                    }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0)
                                    {
                                        <div class="accordion mt-3 mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#leaderOptions" aria-expanded="false">
                                                        Leader
                                                        <span class="badge bg-info ms-2">@(datasheet.CanLead.Count + datasheet.LeadBy.Count)</span>
                                                    </button>
                                                </h2>
                                                <div id="leaderOptions" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2">
                                                        @if (!string.IsNullOrEmpty(datasheet.LeaderHead))
                                                        {
                                                            <div class="rule-content mb-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderHead))</div>
                                                        }
                                                        @if (datasheet.CanLead.Count > 0)
                                                        {
                                                            <div class="mb-3">
                                                                <strong class="d-block mb-2">Can lead:</strong>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @foreach (var unit in datasheet.CanLead)
                                                                    {
                                                                        <NavLink class="badge bg-primary text-decoration-none" href="@($"/faction/{FactionId}/unit/{unit.DatasheetId}")">@unit.Name</NavLink>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (datasheet.LeadBy.Count > 0)
                                                        {
                                                            <div class="mb-2">
                                                                <strong class="d-block mb-2">Can be led by:</strong>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @foreach (var unit in datasheet.LeadBy)
                                                                    {
                                                                        <NavLink class="badge bg-secondary text-decoration-none" href="@($"/faction/{FactionId}/unit/{unit.DatasheetId}")">@unit.Name</NavLink>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(datasheet.LeaderFooter))
                                                        {
                                                            <div class="rule-content mt-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderFooter))</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="d-lg-none col-12">
                                <div class="p-1">
                                    @if (uniqueStatlines.Count > 0)
                                    {
                                        <UnitStatlineTable Items="uniqueStatlines" />
                                    }

                                    @if (rangedWeapons.Count > 0 || meleeWeapons.Count > 0)
                                    {
                                        var expandRanged = rangedWeapons.Any();

                                        <div class="accordion mt-3" id="weaponsAccordionMobile">
                                            @if (rangedWeapons.Any())
                                            {
                                                <div class="accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button @(expandRanged ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#rangedWeaponsMobile" aria-expanded="@expandRanged.ToString().ToLower()">
                                                            Ranged Weapons
                                                            <span class="badge bg-info ms-2">@rangedWeapons.Count</span>
                                                        </button>
                                                    </h2>
                                                    <div id="rangedWeaponsMobile" class="accordion-collapse collapse @(expandRanged ? "show" : "")" data-bs-parent="#weaponsAccordionMobile">
                                                        <div class="accordion-body p-2">
                                                            <WeaponStatlineCards Weapons="rangedWeapons" StackAbilities="@stackWeaponAbilities" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (meleeWeapons.Any())
                                            {
                                                <div class="accordion-item">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button @(expandRanged ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#meleeWeaponsMobile" aria-expanded="@(!expandRanged).ToString().ToLower()">
                                                            Melee Weapons
                                                            <span class="badge bg-info ms-2">@meleeWeapons.Count</span>
                                                        </button>
                                                    </h2>
                                                    <div id="meleeWeaponsMobile" class="accordion-collapse collapse @(expandRanged ? "" : "show")" data-bs-parent="#weaponsAccordionMobile">
                                                        <div class="accordion-body p-2">
                                                            <WeaponStatlineCards Weapons="meleeWeapons" StackAbilities="@stackWeaponAbilities" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (datasheet.Abilities.Count > 0)
                                    {
                                        <div class="mt-3">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                                <div class="fw-bold">Abilities</div>
                                            </div>
                                            <div class="accordion">
                                                @foreach (var ability in datasheet.Abilities)
                                                {
                                                    var shouldExpand = ShouldExpandAbility(ability.Type);

                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button @(shouldExpand ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#ability-mobile-@(ability.Line)" aria-expanded="@shouldExpand.ToString().ToLower()">
                                                                @ability.Name
                                                                @if (!string.IsNullOrEmpty(ability.Type) && ability.Type != "Fortification (левая колонка)" && ability.Type != "Special (правая колонка)")
                                                                {
                                                                    <span class="badge bg-secondary ms-2">@ability.Type</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(ability.Parameter))
                                                                {
                                                                    <span class="badge bg-info ms-1">@ability.Parameter</span>
                                                                }
                                                            </button>
                                                        </h2>
                                                        <div id="ability-mobile-@(ability.Line)" class="accordion-collapse collapse @(shouldExpand ? "show" : "")">
                                                            <div class="accordion-body rule-content">
                                                                @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (datasheet.Options.Count > 0)
                                    {
                                        <div class="accordion mt-3 mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wargearOptionsMobile" aria-expanded="false">
                                                        Wargear Options
                                                        <span class="badge bg-info ms-2">@datasheet.Options.Count</span>
                                                    </button>
                                                </h2>
                                                <div id="wargearOptionsMobile" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2">
                                                        <ul class="list-group list-group-flush">
                                                            @foreach (var option in datasheet.Options)
                                                            {
                                                                <li class="list-group-item px-0">
                                                                    @if (option.Button != "*")
                                                                    {
                                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(@option.Button + " " + option.Description))</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Description + @option.Button))</div>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(datasheet.Loadout) || unitConfigurations.Count > 0)
                                    {
                                        <div class="mt-3">
                                            <h5 class="text-primary mb-3">Unit Setup</h5>

                                            @if (!string.IsNullOrWhiteSpace(datasheet.Loadout))
                                            {
                                                <div class="mb-3">
                                                    <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Loadout</div>
                                                    <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.Loadout))</div>
                                                </div>
                                            }

                                            @if (unitConfigurations.Count > 0)
                                            {
                                                <div>
                                                    <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Unit Sizes & Points</div>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var configuration in unitConfigurations)
                                                        {
                                                            <div class="rounded-4 px-3 py-2 border border-success border-opacity-25 bg-success bg-opacity-10">
                                                                <div class="d-flex align-items-start justify-content-between gap-2 lh-sm">
                                                                    <div class="min-w-0 flex-grow-1">
                                                                        <div class="fw-semibold">@configuration.Title</div>
                                                                        @if (!string.IsNullOrWhiteSpace(configuration.Subtitle))
                                                                        {
                                                                            <div class="small text-secondary mt-1">@configuration.Subtitle</div>
                                                                        }
                                                                    </div>
                                                                    @if (configuration.Cost.HasValue)
                                                                    {
                                                                        <span class="badge bg-success text-nowrap flex-shrink-0">@configuration.Cost.Value pts</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0)
                                    {
                                        <div class="accordion mt-3 mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#leaderOptionsMobile" aria-expanded="false">
                                                        Leader
                                                        <span class="badge bg-info ms-2">@(datasheet.CanLead.Count + datasheet.LeadBy.Count)</span>
                                                    </button>
                                                </h2>
                                                <div id="leaderOptionsMobile" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2">
                                                        @if (!string.IsNullOrEmpty(datasheet.LeaderHead))
                                                        {
                                                            <div class="rule-content mb-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderHead))</div>
                                                        }
                                                        @if (datasheet.CanLead.Count > 0)
                                                        {
                                                            <div class="mb-3">
                                                                <strong class="d-block mb-2">Can lead:</strong>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @foreach (var unit in datasheet.CanLead)
                                                                    {
                                                                        <NavLink class="badge bg-primary text-decoration-none" href="@($"/faction/{FactionId}/unit/{unit.DatasheetId}")">@unit.Name</NavLink>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (datasheet.LeadBy.Count > 0)
                                                        {
                                                            <div class="mb-2">
                                                                <strong class="d-block mb-2">Can be led by:</strong>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @foreach (var unit in datasheet.LeadBy)
                                                                    {
                                                                        <NavLink class="badge bg-secondary text-decoration-none" href="@($"/faction/{FactionId}/unit/{unit.DatasheetId}")">@unit.Name</NavLink>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(datasheet.LeaderFooter))
                                                        {
                                                            <div class="rule-content mt-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderFooter))</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(datasheet.Transport))
                                    {
                                        <div class="accordion mt-3 mb-2">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#transportInfoMobile" aria-expanded="false">
                                                        Transport
                                                    </button>
                                                </h2>
                                                <div id="transportInfoMobile" class="accordion-collapse collapse">
                                                    <div class="accordion-body p-2 rule-content">
                                                        @((MarkupString)WahaDataImporter.CleanHtml(datasheet.Transport))
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(datasheet.DamagedW) || !string.IsNullOrEmpty(datasheet.DamagedDescription))
                                    {
                                        <div class="mt-3">
                                            <h5 class="text-primary">Damaged</h5>
                                            @if (!string.IsNullOrEmpty(datasheet.DamagedW))
                                            {
                                                <div><strong>Damaged:</strong> @datasheet.DamagedW</div>
                                            }
                                            @if (!string.IsNullOrEmpty(datasheet.DamagedDescription))
                                            {
                                                <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.DamagedDescription))</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (datasheet.FactionKeywords.Count > 0 || datasheet.Keywords.Count > 0)
                        {
                            <div class="p-1 col-12">
                                <div class="d-flex flex-wrap align-items-start gap-3">
                                    @if (datasheet.FactionKeywords.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            <span class="text-muted small text-nowrap">Faction Keywords:</span>
                                            @foreach (var kw in sortedFactionKeywords)
                                            {
                                                <span class="badge bg-primary">@kw</span>
                                            }
                                        </div>
