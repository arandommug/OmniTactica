    private string GetModifierDescription(ConditionalModifier modifier)
    {
        var condition = modifier.Condition.Type switch
        {
            ConditionType.Always => "Always",
            ConditionType.UnitCharged => "When charged",
            ConditionType.TargetWithinHalfRange => "Within half range",
            ConditionType.TargetUnitSize5Plus => "Target 5+ models",
            ConditionType.TargetUnitSize10Plus => "Target 10+ models",
            ConditionType.CriticalHit => "On critical hit",
            ConditionType.CriticalWound => "On critical wound",
            _ => modifier.Condition.Type.ToString()
        };

        var effect = modifier.Effect.Type.ToString();
        if (modifier.Effect.Type == EffectType.ImproveBallisticSkill)
            effect = "Improve Ballistic Skill";
        else if (modifier.Effect.Type == EffectType.ImproveWeaponSkill)
            effect = "Improve Weapon Skill";
        else if (modifier.Effect.Type == EffectType.RerollDamage)
            effect = "Reroll Damage rolls";
        if (modifier.Effect.IntValue.HasValue)
            effect += $" {(modifier.Effect.IntValue.Value > 0 ? "+" : "")}{modifier.Effect.IntValue.Value}";

        return $"{condition} → {effect}";
    }

