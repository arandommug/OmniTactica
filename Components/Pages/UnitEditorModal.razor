@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core
@using OmniTactica.AppCode.Data.Import
@using OmniTactica.AppCode.Helpers
@using OmniTactica.AppCode.Utilities
@using Microsoft.JSInterop
@using System.Text.RegularExpressions

@inject VersusService VersusService
@inject AbilityRulesService AbilityRulesService
@inject IJSRuntime JS
@implements IDisposable

<style>
    /* Hide native number input spinners for stepper-hybrid controls */
    .stepper-input::-webkit-outer-spin-button,
    .stepper-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .stepper-input {
        -moz-appearance: textfield;
    }
</style>

<div class="modal fade" id="unitEditorModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header @(isAttacker ? "bg-danger" : "bg-primary") bg-opacity-10">
                <h5 class="modal-title">
                    <i class="fa fa-edit"></i> Edit @(editingUnit?.DatasheetName ?? "Unit")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="@weaponLayoutContainerId">
                @if (editingUnit != null && editingUnit.DatasheetDetail != null)
                {
                    var datasheet = editingUnit.DatasheetDetail;
                    var uniqueStatlines = StatlineDisplayFactory.CreateDatasheetStatlines(datasheet.Models);
                    var availableWeapons = StatlineDisplayFactory.CreateDatasheetWeapons(datasheet.Wargear);
                    var rangedWeapons = availableWeapons.Where(w => string.Equals(w.Type, "Ranged", StringComparison.OrdinalIgnoreCase)).ToList();
                    var meleeWeapons = availableWeapons.Where(w => string.Equals(w.Type, "Melee", StringComparison.OrdinalIgnoreCase)).ToList();
                    var unitConfigurations = BuildUnitConfigurations(datasheet);
                    var sortedFactionKeywords = datasheet.FactionKeywords.OrderBy(keyword => keyword).ToList();
                    var sortedKeywords = datasheet.Keywords.OrderBy(keyword => keyword).ToList();

                    <div class="row g-3">
                        <!-- LEFT COLUMN: Datasheet Reference -->
                        <div class="col-12 col-lg-6 order-2 order-lg-1">
                            <div class="pe-lg-2 overflow-visible overflow-lg-auto" style="max-height: none;">
                                <div class="row">
                                    <div class="d-none d-lg-block col-12 col-lg-6">
                                        <div class="p-1">
                                            @if (uniqueStatlines.Count > 0)
                                            {
                                                <UnitStatlineTable Items="uniqueStatlines" />
                                            }

                                            @if (rangedWeapons.Count > 0 || meleeWeapons.Count > 0)
                                            {
                                                var expandRanged = rangedWeapons.Any();

                                                <div class="accordion mt-3" id="unitEditorWeaponsAccordionDesktop">
                                                    @if (rangedWeapons.Any())
                                                    {
                                                        <div class="accordion-item">
                                                            <h2 class="accordion-header">
                                                                <button class="accordion-button @(expandRanged ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorRangedWeaponsDesktop" aria-expanded="@expandRanged.ToString().ToLower()">
                                                                    Ranged Weapons
                                                                    <span class="badge bg-info ms-2">@rangedWeapons.Count</span>
                                                                </button>
                                                            </h2>
                                                            <div id="unitEditorRangedWeaponsDesktop" class="accordion-collapse collapse @(expandRanged ? "show" : string.Empty)" data-bs-parent="#unitEditorWeaponsAccordionDesktop">
                                                                <div class="accordion-body p-2">
                                                                    <WeaponStatlineCards Weapons="rangedWeapons" StackAbilities="@stackWeaponAbilities" EnableAbilityTooltips="true" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (meleeWeapons.Any())
                                                    {
                                                        <div class="accordion-item">
                                                            <h2 class="accordion-header">
                                                                <button class="accordion-button @(expandRanged ? "collapsed" : string.Empty)" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorMeleeWeaponsDesktop" aria-expanded="@(!expandRanged).ToString().ToLower()">
                                                                    Melee Weapons
                                                                    <span class="badge bg-info ms-2">@meleeWeapons.Count</span>
                                                                </button>
                                                            </h2>
                                                            <div id="unitEditorMeleeWeaponsDesktop" class="accordion-collapse collapse @(expandRanged ? string.Empty : "show")" data-bs-parent="#unitEditorWeaponsAccordionDesktop">
                                                                <div class="accordion-body p-2">
                                                                    <WeaponStatlineCards Weapons="meleeWeapons" StackAbilities="@stackWeaponAbilities" EnableAbilityTooltips="true" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (datasheet.Options.Count > 0)
                                            {
                                                <div class="accordion mt-3 mb-2">
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorWargearOptionsDesktop" aria-expanded="false">
                                                                Wargear Options
                                                                <span class="badge bg-info ms-2">@datasheet.Options.Count</span>
                                                            </button>
                                                        </h2>
                                                        <div id="unitEditorWargearOptionsDesktop" class="accordion-collapse collapse">
                                                            <div class="accordion-body p-2">
                                                                <ul class="list-group list-group-flush">
                                                                    @foreach (var option in datasheet.Options)
                                                                    {
                                                                        <li class="list-group-item px-0">
                                                                            @if (option.Button != "*")
                                                                            {
                                                                                <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Button + " " + option.Description))</div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Description + option.Button))</div>
                                                                            }
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-none d-lg-block col-12 col-lg-6">
                                        <div class="p-1">
                                            @if (datasheet.Abilities.Count > 0)
                                            {
                                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                                    <div class="fw-bold">Abilities</div>
                                                </div>
                                                <div class="accordion">
                                                    @foreach (var ability in datasheet.Abilities)
                                                    {
                                                        var shouldExpand = ShouldExpandAbility(ability.Type);

                                                        <div class="accordion-item">
                                                            <h2 class="accordion-header">
                                                                <button class="accordion-button @(shouldExpand ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#unit-editor-ability-desktop-@(ability.Line)" aria-expanded="@shouldExpand.ToString().ToLower()">
                                                                    @ability.Name
                                                                    @if (!string.IsNullOrEmpty(ability.Type) && ability.Type != "Fortification (левая колонка)" && ability.Type != "Special (правая колонка)")
                                                                    {
                                                                        <span class="badge bg-secondary ms-2">@ability.Type</span>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(ability.Parameter))
                                                                    {
                                                                        <span class="badge bg-info ms-1">@ability.Parameter</span>
                                                                    }
                                                                </button>
                                                            </h2>
                                                            <div id="unit-editor-ability-desktop-@(ability.Line)" class="accordion-collapse collapse @(shouldExpand ? "show" : string.Empty)">
                                                                <div class="accordion-body rule-content">
                                                                    @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(datasheet.Loadout) || unitConfigurations.Count > 0)
                                            {
                                                <div class="mt-3">
                                                    <h5 class="text-primary mb-3">Unit Setup</h5>

                                                    @if (!string.IsNullOrWhiteSpace(datasheet.Loadout))
                                                    {
                                                        <div class="mb-3">
                                                            <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Loadout</div>
                                                            <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.Loadout))</div>
                                                        </div>
                                                    }

                                                    @if (unitConfigurations.Count > 0)
                                                    {
                                                        <div>
                                                            <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Unit Sizes & Points</div>
                                                            <div class="d-flex flex-column gap-2">
                                                                @foreach (var configuration in unitConfigurations)
                                                                {
                                                                    <div class="rounded-4 px-3 py-2 border border-success border-opacity-25 bg-success bg-opacity-10">
                                                                        <div class="d-flex align-items-start justify-content-between gap-2 lh-sm">
                                                                            <div class="min-w-0 flex-grow-1">
                                                                                <div class="fw-semibold">@configuration.Title</div>
                                                                                @if (!string.IsNullOrWhiteSpace(configuration.Subtitle))
                                                                                {
                                                                                    <div class="small text-secondary mt-1">@configuration.Subtitle</div>
                                                                                }
                                                                            </div>
                                                                            @if (configuration.Cost.HasValue)
                                                                            {
                                                                                <span class="badge bg-success text-nowrap flex-shrink-0">@configuration.Cost.Value pts</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0)
                                            {
                                                <div class="accordion mt-3 mb-2">
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorLeaderOptionsDesktop" aria-expanded="false">
                                                                Leader
                                                                <span class="badge bg-info ms-2">@(datasheet.CanLead.Count + datasheet.LeadBy.Count)</span>
                                                            </button>
                                                        </h2>
                                                        <div id="unitEditorLeaderOptionsDesktop" class="accordion-collapse collapse">
                                                            <div class="accordion-body p-2">
                                                                @if (!string.IsNullOrEmpty(datasheet.LeaderHead))
                                                                {
                                                                    <div class="rule-content mb-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderHead))</div>
                                                                }
                                                                @if (datasheet.CanLead.Count > 0)
                                                                {
                                                                    <div class="mb-3">
                                                                        <strong class="d-block mb-2">Can lead:</strong>
                                                                        <div class="d-flex flex-wrap gap-1">
                                                                            @foreach (var unit in datasheet.CanLead.OrderBy(unit => unit.Name))
                                                                            {
                                                                                <span class="badge bg-primary bg-opacity-10 text-primary-emphasis">@unit.Name</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (datasheet.LeadBy.Count > 0)
                                                                {
                                                                    <div class="mb-2">
                                                                        <strong class="d-block mb-2">Can be led by:</strong>
                                                                        <div class="d-flex flex-wrap gap-1">
                                                                            @foreach (var unit in datasheet.LeadBy.OrderBy(unit => unit.Name))
                                                                            {
                                                                                <span class="badge bg-secondary bg-opacity-10 text-secondary-emphasis">@unit.Name</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (!string.IsNullOrEmpty(datasheet.LeaderFooter))
                                                                {
                                                                    <div class="rule-content mt-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderFooter))</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(datasheet.Transport))
                                            {
                                                <div class="accordion mt-3 mb-2">
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorTransportDesktop" aria-expanded="false">
                                                                Transport
                                                            </button>
                                                        </h2>
                                                        <div id="unitEditorTransportDesktop" class="accordion-collapse collapse">
                                                            <div class="accordion-body p-2 rule-content">
                                                                @((MarkupString)WahaDataImporter.CleanHtml(datasheet.Transport))
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(datasheet.DamagedW) || !string.IsNullOrEmpty(datasheet.DamagedDescription))
                                            {
                                                <div class="mt-3">
                                                    <h5 class="text-primary">Damaged</h5>
                                                    @if (!string.IsNullOrEmpty(datasheet.DamagedW))
                                                    {
                                                        <div><strong>Damaged:</strong> @datasheet.DamagedW</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(datasheet.DamagedDescription))
                                                    {
                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.DamagedDescription))</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-lg-none col-12">
                                        <div class="p-1">
                                            @if (uniqueStatlines.Count > 0)
                                            {
                                                <UnitStatlineTable Items="uniqueStatlines" />
                                            }

                                            @if (rangedWeapons.Count > 0 || meleeWeapons.Count > 0)
                                            {
                                                var expandRanged = rangedWeapons.Any();

                                                <div class="accordion mt-3" id="unitEditorWeaponsAccordionMobile">
                                                    @if (rangedWeapons.Any())
                                                    {
                                                        <div class="accordion-item">
                                                            <h2 class="accordion-header">
                                                                <button class="accordion-button @(expandRanged ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorRangedWeaponsMobile" aria-expanded="@expandRanged.ToString().ToLower()">
                                                                    Ranged Weapons
                                                                    <span class="badge bg-info ms-2">@rangedWeapons.Count</span>
                                                                </button>
                                                            </h2>
                                                            <div id="unitEditorRangedWeaponsMobile" class="accordion-collapse collapse @(expandRanged ? "show" : string.Empty)" data-bs-parent="#unitEditorWeaponsAccordionMobile">
                                                                <div class="accordion-body p-2">
                                                                    <WeaponStatlineCards Weapons="rangedWeapons" StackAbilities="@stackWeaponAbilities" EnableAbilityTooltips="true" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (meleeWeapons.Any())
                                                    {
                                                        <div class="accordion-item">
                                                            <h2 class="accordion-header">
                                                                <button class="accordion-button @(expandRanged ? "collapsed" : string.Empty)" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorMeleeWeaponsMobile" aria-expanded="@(!expandRanged).ToString().ToLower()">
                                                                    Melee Weapons
                                                                    <span class="badge bg-info ms-2">@meleeWeapons.Count</span>
                                                                </button>
                                                            </h2>
                                                            <div id="unitEditorMeleeWeaponsMobile" class="accordion-collapse collapse @(expandRanged ? string.Empty : "show")" data-bs-parent="#unitEditorWeaponsAccordionMobile">
                                                                <div class="accordion-body p-2">
                                                                    <WeaponStatlineCards Weapons="meleeWeapons" StackAbilities="@stackWeaponAbilities" EnableAbilityTooltips="true" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (datasheet.Abilities.Count > 0)
                                            {
                                                <div class="mt-3">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                                        <div class="fw-bold">Abilities</div>
                                                    </div>
                                                    <div class="accordion">
                                                        @foreach (var ability in datasheet.Abilities)
                                                        {
                                                            var shouldExpand = ShouldExpandAbility(ability.Type);

                                                            <div class="accordion-item">
                                                                <h2 class="accordion-header">
                                                                    <button class="accordion-button @(shouldExpand ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#unit-editor-ability-mobile-@(ability.Line)" aria-expanded="@shouldExpand.ToString().ToLower()">
                                                                        @ability.Name
                                                                        @if (!string.IsNullOrEmpty(ability.Type) && ability.Type != "Fortification (левая колонка)" && ability.Type != "Special (правая колонка)")
                                                                        {
                                                                            <span class="badge bg-secondary ms-2">@ability.Type</span>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(ability.Parameter))
                                                                        {
                                                                            <span class="badge bg-info ms-1">@ability.Parameter</span>
                                                                        }
                                                                    </button>
                                                                </h2>
                                                                <div id="unit-editor-ability-mobile-@(ability.Line)" class="accordion-collapse collapse @(shouldExpand ? "show" : string.Empty)">
                                                                    <div class="accordion-body rule-content">
                                                                        @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (datasheet.Options.Count > 0)
                                            {
                                                <div class="accordion mt-3 mb-2">
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorWargearOptionsMobile" aria-expanded="false">
                                                                Wargear Options
                                                                <span class="badge bg-info ms-2">@datasheet.Options.Count</span>
                                                            </button>
                                                        </h2>
                                                        <div id="unitEditorWargearOptionsMobile" class="accordion-collapse collapse">
                                                            <div class="accordion-body p-2">
                                                                <ul class="list-group list-group-flush">
                                                                    @foreach (var option in datasheet.Options)
                                                                    {
                                                                        <li class="list-group-item px-0">
                                                                            @if (option.Button != "*")
                                                                            {
                                                                                <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Button + " " + option.Description))</div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(option.Description + option.Button))</div>
                                                                            }
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(datasheet.Loadout) || unitConfigurations.Count > 0)
                                            {
                                                <div class="mt-3">
                                                    <h5 class="text-primary mb-3">Unit Setup</h5>

                                                    @if (!string.IsNullOrWhiteSpace(datasheet.Loadout))
                                                    {
                                                        <div class="mb-3">
                                                            <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Loadout</div>
                                                            <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.Loadout))</div>
                                                        </div>
                                                    }

                                                    @if (unitConfigurations.Count > 0)
                                                    {
                                                        <div>
                                                            <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Unit Sizes & Points</div>
                                                            <div class="d-flex flex-column gap-2">
                                                                @foreach (var configuration in unitConfigurations)
                                                                {
                                                                    <div class="rounded-4 px-3 py-2 border border-success border-opacity-25 bg-success bg-opacity-10">
                                                                        <div class="d-flex align-items-start justify-content-between gap-2 lh-sm">
                                                                            <div class="min-w-0 flex-grow-1">
                                                                                <div class="fw-semibold">@configuration.Title</div>
                                                                                @if (!string.IsNullOrWhiteSpace(configuration.Subtitle))
                                                                                {
                                                                                    <div class="small text-secondary mt-1">@configuration.Subtitle</div>
                                                                                }
                                                                            </div>
                                                                            @if (configuration.Cost.HasValue)
                                                                            {
                                                                                <span class="badge bg-success text-nowrap flex-shrink-0">@configuration.Cost.Value pts</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            @if (datasheet.CanLead.Count > 0 || datasheet.LeadBy.Count > 0)
                                            {
                                                <div class="accordion mt-3 mb-2">
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorLeaderOptionsMobile" aria-expanded="false">
                                                                Leader
                                                                <span class="badge bg-info ms-2">@(datasheet.CanLead.Count + datasheet.LeadBy.Count)</span>
                                                            </button>
                                                        </h2>
                                                        <div id="unitEditorLeaderOptionsMobile" class="accordion-collapse collapse">
                                                            <div class="accordion-body p-2">
                                                                @if (!string.IsNullOrEmpty(datasheet.LeaderHead))
                                                                {
                                                                    <div class="rule-content mb-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderHead))</div>
                                                                }
                                                                @if (datasheet.CanLead.Count > 0)
                                                                {
                                                                    <div class="mb-3">
                                                                        <strong class="d-block mb-2">Can lead:</strong>
                                                                        <div class="d-flex flex-wrap gap-1">
                                                                            @foreach (var unit in datasheet.CanLead.OrderBy(unit => unit.Name))
                                                                            {
                                                                                <span class="badge bg-primary bg-opacity-10 text-primary-emphasis">@unit.Name</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (datasheet.LeadBy.Count > 0)
                                                                {
                                                                    <div class="mb-2">
                                                                        <strong class="d-block mb-2">Can be led by:</strong>
                                                                        <div class="d-flex flex-wrap gap-1">
                                                                            @foreach (var unit in datasheet.LeadBy.OrderBy(unit => unit.Name))
                                                                            {
                                                                                <span class="badge bg-secondary bg-opacity-10 text-secondary-emphasis">@unit.Name</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                                @if (!string.IsNullOrEmpty(datasheet.LeaderFooter))
                                                                {
                                                                    <div class="rule-content mt-3">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.LeaderFooter))</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(datasheet.Transport))
                                            {
                                                <div class="accordion mt-3 mb-2">
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#unitEditorTransportMobile" aria-expanded="false">
                                                                Transport
                                                            </button>
                                                        </h2>
                                                        <div id="unitEditorTransportMobile" class="accordion-collapse collapse">
                                                            <div class="accordion-body p-2 rule-content">
                                                                @((MarkupString)WahaDataImporter.CleanHtml(datasheet.Transport))
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(datasheet.DamagedW) || !string.IsNullOrEmpty(datasheet.DamagedDescription))
                                            {
                                                <div class="mt-3">
                                                    <h5 class="text-primary">Damaged</h5>
                                                    @if (!string.IsNullOrEmpty(datasheet.DamagedW))
                                                    {
                                                        <div><strong>Damaged:</strong> @datasheet.DamagedW</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(datasheet.DamagedDescription))
                                                    {
                                                        <div class="rule-content">@((MarkupString)WahaDataImporter.CleanHtml(datasheet.DamagedDescription))</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @if (sortedFactionKeywords.Count > 0 || sortedKeywords.Count > 0)
                                {
                                    <div class="p-1 mt-2">
                                        <div class="d-flex flex-wrap align-items-start gap-3">
                                            @if (sortedFactionKeywords.Count > 0)
                                            {
                                                <div class="d-flex flex-wrap align-items-center gap-1">
                                                    <span class="text-muted small text-nowrap">Faction Keywords:</span>
                                                    @foreach (var keyword in sortedFactionKeywords)
                                                    {
                                                        <span class="badge bg-primary">@keyword</span>
                                                    }
                                                </div>
                                            }

                                            @if (sortedKeywords.Count > 0)
                                            {
                                                <div class="d-flex flex-wrap align-items-center gap-1">
                                                    <span class="text-muted small text-nowrap">Keywords:</span>
                                                    @foreach (var keyword in sortedKeywords)
                                                    {
                                                        <span class="badge bg-info">@keyword</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Unit Configuration -->
                        <div class="col-12 col-lg-6 order-1 order-lg-2">
                            <div class="overflow-visible overflow-lg-auto" style="max-height: none;">

                                    <!-- Models Section -->
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2" style="border-bottom: 2px solid @(isAttacker ? "var(--bs-danger)" : "var(--bs-primary)"); padding-bottom: 0.4rem;">
                                            <div class="text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 0.08em; color: @(isAttacker ? "var(--bs-danger)" : "var(--bs-primary)");">Models</div>
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => showAddModelModal = true">
                                                <i class="fa fa-plus"></i> Add Model
                                            </button>
                                        </div>

                                        @if (!editingUnit.Models.Any())
                                        {
                                            <div class="text-muted small text-center py-3">No models added. Click "Add" to begin.</div>
                                        }
                                        else
                                        {
                                            @foreach (var model in editingUnit.Models)
                                            {
                                                <div class="mb-2 pb-2" style="border-bottom: 1px solid rgba(0,0,0,0.12);">
                                                    <div class="d-flex align-items-center gap-1 mb-1">
                                                        <strong style="font-size: 0.9rem;">@model.Name</strong>
                                                        <div class="d-inline-flex align-items-center border rounded" style="height: 1.6rem; overflow: hidden;">
                                                            <button class="btn btn-sm border-0 px-1 py-0 text-secondary" style="font-size: 0.7rem; line-height: 1;" @onclick="() => DecrementModelQuantity(model)" disabled="@(model.Quantity <= 1)">
                                                                <i class="fa fa-minus"></i>
                                                            </button>
                                                            <input type="number" class="stepper-input form-control form-control-sm border-0 border-start border-end text-center fw-semibold" 
                                                                   style="width: 2.2rem; height: 100%; font-size: 0.85rem; padding: 0; border-radius: 0;"
                                                                   @bind="model.Quantity" min="1" max="20" 
                                                                   @bind:event="oninput" @onchange="() => OnModelQuantityChanged(model)" />
                                                            <button class="btn btn-sm border-0 px-1 py-0 text-secondary" style="font-size: 0.7rem; line-height: 1;" @onclick="() => IncrementModelQuantity(model)" disabled="@(model.Quantity >= 20)">
                                                                <i class="fa fa-plus"></i>
                                                            </button>
                                                        </div>
                                                        <button class="btn btn-sm btn-outline-warning border-0 p-0 lh-1 ms-1" style="font-size: 0.7rem;" @onclick="() => ShowModifierModal(model, null, null, ModifierTarget.Model)" title="Add Modifier">
                                                            <i class="fa fa-magic"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger border-0 p-0 lh-1" style="font-size: 0.7rem;" @onclick="() => RemoveModel(model)" title="Remove">
                                                            <i class="fa fa-times"></i>
                                                        </button>
                                                        <span class="text-muted ms-2" style="font-size: 0.7rem;">T@(model.T) Sv@(model.Sv)+@(model.InvSv > 0 ? $" Inv{model.InvSv}++" : "") W@(model.W)</span>
                                                    </div>

                                                        <!-- Weapons -->
                                                        <div class="mb-1">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.6rem; letter-spacing: 0.05em;">Weapons</span>
                                                                <button class="btn btn-sm btn-outline-success border-0 py-0" style="font-size: 0.7rem;" @onclick="() => AddWeaponToModel(model)" title="Add Weapon">
                                                                    <i class="fa fa-plus"></i> Add Weapon
                                                                </button>
                                                            </div>
                                                            @if (model.Weapons.Any())
                                                            {
                                                                @foreach (var weapon in model.Weapons)
                                                                {
                                                                    @* ApplyBuiltInModifiers(weapon); *@
                                                                    <div class="d-flex align-items-center gap-2 py-1 @(weapon.IsSelected ? "" : "opacity-50")" style="font-size: 0.8rem;">
                                                                        <input type="checkbox" class="form-check-input flex-shrink-0" style="margin: 0;" @bind="weapon.IsSelected" />
                                                                        <span class="fw-semibold text-truncate" style="min-width: 0;">@weapon.Name</span>
                                                                        <span class="d-inline-flex align-items-center border rounded flex-shrink-0" style="height: 1.4rem; overflow: hidden;">
                                                                            <button class="btn btn-sm border-0 px-1 py-0 text-secondary" style="font-size: 0.6rem; line-height: 1;" @onclick="() => DecrementWeaponQuantity(model, weapon)" disabled="@(weapon.Quantity <= 1)">
                                                                                <i class="fa fa-minus"></i>
                                                                            </button>
                                                                            <input type="number" class="stepper-input form-control form-control-sm border-0 border-start border-end text-center p-0 flex-shrink-0"
                                                                                   style="width: 1.8rem; height: 100%; font-size: 0.75rem; border-radius: 0;"
                                                                                   @bind="weapon.Quantity" min="1" @bind:event="oninput" />
                                                                            <button class="btn btn-sm border-0 px-1 py-0 text-secondary" style="font-size: 0.6rem; line-height: 1;" @onclick="() => IncrementWeaponQuantity(weapon)">
                                                                                <i class="fa fa-plus"></i>
                                                                            </button>
                                                                        </span>
                                                                        <span class="badge @(weapon.Type == "Melee" ? "bg-danger" : "bg-primary") bg-opacity-75 flex-shrink-0" style="font-size: 0.55rem;">@weapon.Type</span>
                                                                        @if (weapon.Modifiers.Any(m => m.IsActive))
                                                                        {
                                                                            @foreach (var mod in weapon.Modifiers.Where(m => m.IsActive))
                                                                            {
                                                                                var modDisplayName = string.IsNullOrWhiteSpace(mod.Name) || mod.Name == "Custom" ? "Custom" : mod.Name.Replace(" (Built-in)", "");
                                                                                var capturedMod = mod;
                                                                                var capturedModel = model;
                                                                                var capturedWeapon = weapon;
                                                                                <span class="badge bg-warning bg-opacity-25 text-warning-emphasis d-inline-flex align-items-center gap-1 flex-shrink-0 text-nowrap lh-1 px-2 py-1" style="font-size: 0.55rem; font-weight: 500;">
                                                                                    @modDisplayName
                                                                                    <button class="d-inline-flex align-items-center justify-content-center p-0 border-0 bg-transparent text-warning-emphasis opacity-75 lh-1" style="font-size: 0.45rem;" @onclick:stopPropagation="true" @onclick="() => EditModifier(capturedModel, capturedWeapon, capturedMod, ModifierTarget.Weapon)" title="Edit"><i class="fa fa-pencil"></i></button>
                                                                                </span>
                                                                            }
                                                                        }
                                                                        <span class="flex-shrink-0 ms-auto d-flex gap-1">
                                                                            <button class="btn btn-sm btn-outline-warning border-0 p-0 lh-1" style="font-size: 0.7rem;" @onclick="() => ShowModifierModal(model, weapon, null, ModifierTarget.Weapon)" title="Modifier">
                                                                                <i class="fa fa-magic"></i>
                                                                            </button>
                                                                            <button class="btn btn-sm btn-outline-danger border-0 p-0 lh-1" style="font-size: 0.7rem;" @onclick="() => RemoveWeapon(model, weapon)" title="Remove">
                                                                                <i class="fa fa-times"></i>
                                                                            </button>
                                                                        </span>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted small fst-italic">No weapons equipped.</div>
                                                            }
                                                        </div>

                                                                        <!-- Model Modifiers -->
                                                                        @if (model.Modifiers.Any(m => m.IsActive))
                                                                        {
                                                                            <div>
                                                                                <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.65rem; letter-spacing: 0.05em;">Modifiers</span>
                                                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                                                    @foreach (var modifier in model.Modifiers.Where(m => m.IsActive))
                                                                                    {
                                                                                        var capturedMod = modifier;
                                                                                        var capturedModel = model;
                                                                                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis d-inline-flex align-items-center gap-1" style="font-size: 0.7rem; font-weight: 500;">
                                                                                            @modifier.Name
                                                                                            <button class="btn p-0 border-0 text-warning-emphasis opacity-75" style="font-size: 0.55rem; line-height:1;" @onclick="() => EditModifier(capturedModel, null, capturedMod, ModifierTarget.Model)" title="Edit"><i class="fa fa-pencil"></i></button>
                                                                                        </span>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            }
                                                        </div>

                                    <!-- Unit-Level Modifiers -->
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2" style="border-bottom: 2px solid var(--bs-warning); padding-bottom: 0.4rem;">
                                            <div class="text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 0.08em; color: var(--bs-warning);">Modifiers</div>
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowModifierModal(null, null, null, ModifierTarget.Unit)">
                                                <i class="fa fa-plus"></i> Add Modifier
                                            </button>
                                        </div>

                                        @if (!editingUnit.Modifiers.Any(m => m.IsActive))
                                        {
                                            <div class="text-muted small">No unit-level modifiers applied.</div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var modifier in editingUnit.Modifiers.Where(m => m.IsActive))
                                                {
                                                    var capturedMod = modifier;
                                                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis p-2 d-inline-flex flex-column" style="font-weight: 500;">
                                                        <span class="d-flex align-items-center gap-1">
                                                            @modifier.Name
                                                            <button class="btn p-0 border-0 text-warning-emphasis opacity-75 ms-1" style="font-size: 0.6rem; line-height:1;" @onclick="() => EditModifier(null, null, capturedMod, ModifierTarget.Unit)" title="Edit"><i class="fa fa-pencil"></i></button>
                                                        </span>
                                                        <span class="small" style="font-weight: 400; opacity: 0.8;">@GetModifierDescription(modifier)</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Combat Summary -->
                                    @{
                                        var totalModels = editingUnit.Models.Sum(m => m.Quantity);
                                        var selectedWeapons = editingUnit.Models.SelectMany(m => m.Weapons.Where(w => w.IsSelected)).ToList();
                                        var rangedSelected = selectedWeapons.Where(w => w.Type == "Ranged").ToList();
                                        var meleeSelected = selectedWeapons.Where(w => w.Type == "Melee").ToList();
                                    }
                                    @if (selectedWeapons.Any())
                                    {
                                        <div class="mb-4">
                                            <div class="text-uppercase fw-bold mb-2" style="font-size: 0.8rem; letter-spacing: 0.08em; color: var(--bs-success); border-bottom: 2px solid var(--bs-success); padding-bottom: 0.4rem;">Combat Summary</div>
                                            <div class="rounded p-2" style="background: rgba(var(--bs-success-rgb), 0.05); font-size: 0.8rem;">
                                                <div class="mb-1"><strong>@totalModels</strong> models</div>
                                                @if (rangedSelected.Any())
                                                {
                                                    <div class="text-muted" style="font-size: 0.75rem;">Ranged: @rangedSelected.Sum(w => ParseWeaponAttacks(w.A) * w.Quantity) attacks</div>
                                                }
                                                @if (meleeSelected.Any())
                                                {
                                                    <div class="text-muted" style="font-size: 0.75rem;">Melee: @meleeSelected.Sum(w => ParseWeaponAttacks(w.A) * w.Quantity) attacks</div>
                                                }
                                                @if (editingUnit.Modifiers.Any(m => m.IsActive))
                                                {
                                                    <div class="text-muted" style="font-size: 0.75rem;">@editingUnit.Modifiers.Count(m => m.IsActive) active modifier(s)</div>
                                                }
                                            </div>
                                        </div>
                                    }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>

            @* Render inside the Bootstrap modal element so the parent's focus trap doesn't block text input focus. *@
            <ModifierEditorModal @ref="modifierModal" OnModifierAdded="HandleModifierAdded" OnModifierDeleted="HandleModifierDeleted" />
        </div>
    </div>
</div>

<!-- Add Model Modal -->
@if (showAddModelModal && editingUnit?.DatasheetDetail != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Model</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddModelModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Select Model Type</label>
                    @foreach (var modelProfile in editingUnit.DatasheetDetail.Models)
                    {
                        <button class="btn btn-outline-primary w-100 mb-2" @onclick="() => AddModelFromProfile(modelProfile)">
                            @modelProfile.Name
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Weapon Modal -->
@if (showAddWeaponModal && editingUnit?.DatasheetDetail != null && selectedModel != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Weapon to @selectedModel.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddWeaponModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        @foreach (var weapon in editingUnit.DatasheetDetail.Wargear)
                        {
                            <div class="col-12">
                                <button class="btn btn-outline-primary w-100 text-start" @onclick="() => AddWeaponFromWargear(selectedModel, weapon)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@weapon.Name</strong>
                                            <span class="badge bg-secondary ms-2">@weapon.Type</span>
                                        </div>
                                        <div class="small">
                                            A:@weapon.A | S:@weapon.S | AP:@weapon.AP | D:@weapon.D
                                        </div>
                                    </div>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Edit Quantity Modal -->
@if (showQuantityModal && selectedModel != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Quantity</h5>
                    <button type="button" class="btn-close" @onclick="() => showQuantityModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Number of @selectedModel.Name models</label>
                    <input type="number" class="form-control" @bind="selectedModel.Quantity" min="1" max="20" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showQuantityModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="() => { showQuantityModal = false; StateHasChanged(); }">Done</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnClosed { get; set; }

    private ModifierEditorModal modifierModal = null!;

    private CombatUnit? editingUnit;
    private bool isAttacker;
    private bool showAddModelModal = false;
    private bool showAddWeaponModal = false;
    private bool showQuantityModal = false;
    private CombatModel? selectedModel;
    private ModifierTarget currentModifierTarget;
    private CombatModel? modifierTargetModel;
    private CombatWeapon? modifierTargetWeapon;
    private string? _editingModifierId;
    private DotNetObjectReference<UnitEditorModal>? _dotNetRef;
    private bool stackWeaponAbilities;
    private readonly string weaponLayoutContainerId = $"unit-editor-weapon-layout-{Guid.NewGuid():N}";
    private static readonly HashSet<string> ExpandedAbilityTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Datasheet",
        "Wargear",
        "Primarch",
        "Fortification (левая колонка)"
    };

    public async Task Show(CombatUnit unit, bool isAttacker)
    {
        this.editingUnit = unit;
        this.isAttacker = isAttacker;
        StateHasChanged();
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("bootstrapInterop.showModal", "unitEditorModal");
        await JS.InvokeVoidAsync("bootstrapInterop.onModalHidden", "unitEditorModal", _dotNetRef);
        await JS.InvokeVoidAsync("initTooltips");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (editingUnit?.DatasheetDetail == null || _dotNetRef == null)
        {
            return;
        }

        await JS.InvokeVoidAsync("weaponAbilityLayout.init", weaponLayoutContainerId, _dotNetRef);
        await JS.InvokeVoidAsync("initTooltips");
    }

    [JSInvokable]
    public async Task OnModalHidden()
    {
        await OnClosed.InvokeAsync();
    }

    [JSInvokable]
    public Task SetWeaponAbilityLayout(bool shouldStack)
    {
        if (stackWeaponAbilities == shouldStack)
        {
            return Task.CompletedTask;
        }

        stackWeaponAbilities = shouldStack;
        return InvokeAsync(StateHasChanged);
    }

    private void AddModelFromProfile(DatasheetModel profile)
    {
        if (editingUnit == null) return;

        var model = new CombatModel
        {
            Name = profile.Name,
            Quantity = 1,
            M = ParseStatValue(profile.M),
            T = ParseStatValue(profile.T),
            Sv = ParseStatValue(profile.Sv),
            InvSv = ParseStatValue(profile.InvSv),
            W = ParseStatValue(profile.W),
            Ld = ParseStatValue(profile.Ld),
            OC = ParseStatValue(profile.OC),
            DatasheetModel = profile
        };

        model.MaxWounds = model.W;
        model.CurrentWounds = model.W;

        // Copy weapons from an existing model of the same type (default loadout)
        var existingModel = editingUnit.Models.FirstOrDefault(m =>
            m.Name.Equals(profile.Name, StringComparison.OrdinalIgnoreCase) ||
            (m.DatasheetModel != null && m.DatasheetModel.Name.Equals(profile.Name, StringComparison.OrdinalIgnoreCase)));
        if (existingModel != null)
        {
            foreach (var existingWeapon in existingModel.Weapons)
            {
                var weaponCopy = new CombatWeapon
                {
                    Name = existingWeapon.Name,
                    Range = existingWeapon.Range,
                    Type = existingWeapon.Type,
                    A = existingWeapon.A,
                    BsWs = existingWeapon.BsWs,
                    S = existingWeapon.S,
                    AP = existingWeapon.AP,
                    D = existingWeapon.D,
                    DatasheetWargear = existingWeapon.DatasheetWargear,
                    Abilities = existingWeapon.Abilities,
                    IsSelected = existingWeapon.IsSelected,
                    Quantity = 1
                };
                // Copy built-in modifiers
                foreach (var mod in existingWeapon.Modifiers.Where(m => !m.IsCustom))
                {
                    weaponCopy.Modifiers.Add(new ConditionalModifier
                    {
                        Name = mod.Name,
                        Condition = mod.Condition,
                        Effect = mod.Effect,
                        IsActive = mod.IsActive,
                        IsCustom = mod.IsCustom
                    });
                }
                model.Weapons.Add(weaponCopy);
            }
        }

        VersusService.AddModelToUnit(editingUnit.Id, model);
        showAddModelModal = false;
        StateHasChanged();
    }

    private void RemoveModel(CombatModel model)
    {
        if (editingUnit == null) return;
        VersusService.RemoveModelFromUnit(editingUnit.Id, model.Id);
        StateHasChanged();
    }

    private void EditModelQuantity(CombatModel model)
    {
        selectedModel = model;
        showQuantityModal = true;
    }

    private void OnModelQuantityChanged(CombatModel model)
    {
        if (model.Quantity < 1) model.Quantity = 1;
        if (model.Quantity > 20) model.Quantity = 20;
        StateHasChanged();
    }

    private int ParseWeaponAttacks(string attacks)
    {
        if (string.IsNullOrWhiteSpace(attacks)) return 0;
        var cleaned = attacks.Replace("D", "").Replace("d", "").Replace("+", "").Trim();
        if (int.TryParse(cleaned, out var result)) return result;
        return 1;
    }

    private void IncrementModelQuantity(CombatModel model)
    {
        if (model.Quantity < 20) // Reasonable max limit
        {
            var oldQuantity = model.Quantity;
            model.Quantity++;
            // Auto-scale weapon quantities that match model count (1-per-model weapons)
            foreach (var weapon in model.Weapons)
            {
                if (weapon.Quantity == oldQuantity)
                {
                    weapon.Quantity++;
                }
            }
            StateHasChanged();
        }
    }

    private void DecrementModelQuantity(CombatModel model)
    {
        if (model.Quantity > 1)
        {
            var oldQuantity = model.Quantity;
            model.Quantity--;
            // Auto-scale weapon quantities that match model count (1-per-model weapons)
            foreach (var weapon in model.Weapons)
            {
                if (weapon.Quantity == oldQuantity)
                {
                    weapon.Quantity--;
                }
            }
            StateHasChanged();
        }
    }

    private void IncrementWeaponQuantity(CombatWeapon weapon)
    {
        weapon.Quantity++;
        StateHasChanged();
    }

    private void DecrementWeaponQuantity(CombatModel model, CombatWeapon weapon)
    {
        if (weapon.Quantity > 1)
        {
            weapon.Quantity--;
            StateHasChanged();
        }
    }

    private void AddWeaponToModel(CombatModel model)
    {
        selectedModel = model;
        showAddWeaponModal = true;
    }

    private void AddWeaponFromWargear(CombatModel model, DatasheetWargear wargear)
    {
        if (editingUnit == null) return;

        // Check if this weapon already exists on the model - if so, increment its quantity
        var existingWeapon = model.Weapons.FirstOrDefault(w =>
            w.Name.Equals(wargear.Name, StringComparison.OrdinalIgnoreCase));
        if (existingWeapon != null)
        {
            existingWeapon.Quantity += model.Quantity;
            showAddWeaponModal = false;
            StateHasChanged();
            return;
        }

        var weapon = new CombatWeapon
        {
            Name = wargear.Name,
            Range = wargear.Range,
            Type = wargear.Type,
            A = wargear.A,
            BsWs = ParseStatValue(wargear.BsWs),
            S = ParseStatValue(wargear.S),
            AP = ParseStatValue(wargear.AP),
            D = wargear.D,
            DatasheetWargear = wargear,
            Abilities = ParseWeaponAbilities(wargear.Description),
            IsSelected = true,
            Quantity = model.Quantity
        };

        // Auto-apply built-in modifiers from abilities
        ApplyBuiltInModifiers(weapon);

        VersusService.AddWeaponToModel(editingUnit.Id, model.Id, weapon);
        showAddWeaponModal = false;
        StateHasChanged();
    }

    private void RemoveWeapon(CombatModel model, CombatWeapon weapon)
    {
        if (editingUnit == null) return;
        VersusService.RemoveWeaponFromModel(editingUnit.Id, model.Id, weapon.Id);
        StateHasChanged();
    }

    private async Task ShowModifierModal(CombatModel? model, CombatWeapon? weapon, ConditionalModifier? existingModifier, ModifierTarget target)
    {
        currentModifierTarget = target;
        modifierTargetModel = model;
        modifierTargetWeapon = weapon;
        _editingModifierId = existingModifier?.Id;
        await modifierModal.Show(existingModifier);
    }

    private async Task EditModifier(CombatModel? model, CombatWeapon? weapon, ConditionalModifier modifier, ModifierTarget target)
    {
        await ShowModifierModal(model, weapon, modifier, target);
    }

    private void HandleModifierAdded(ConditionalModifier modifier)
    {
        if (editingUnit == null) return;

        // Editing existing modifier — update in-place
        if (_editingModifierId != null)
        {
            switch (currentModifierTarget)
            {
                case ModifierTarget.Unit:
                {
                    var existing = editingUnit.Modifiers.FirstOrDefault(m => m.Id == _editingModifierId);
                    if (existing != null) { existing.Name = modifier.Name; existing.Condition = modifier.Condition; existing.Effect = modifier.Effect; }
                    break;
                }
                case ModifierTarget.Model when modifierTargetModel != null:
                {
                    var existing = modifierTargetModel.Modifiers.FirstOrDefault(m => m.Id == _editingModifierId);
                    if (existing != null) { existing.Name = modifier.Name; existing.Condition = modifier.Condition; existing.Effect = modifier.Effect; }
                    break;
                }
                case ModifierTarget.Weapon when modifierTargetWeapon != null:
                {
                    var existing = modifierTargetWeapon.Modifiers.FirstOrDefault(m => m.Id == _editingModifierId);
                    if (existing != null) { existing.Name = modifier.Name; existing.Condition = modifier.Condition; existing.Effect = modifier.Effect; }
                    break;
                }
            }
            _editingModifierId = null;
            StateHasChanged();
            return;
        }

        // Adding new modifier
        switch (currentModifierTarget)
        {
            case ModifierTarget.Unit:
                VersusService.AddUnitModifier(editingUnit.Id, modifier);
                break;
            case ModifierTarget.Model when modifierTargetModel != null:
                VersusService.AddModelModifier(editingUnit.Id, modifierTargetModel.Id, modifier);
                break;
            case ModifierTarget.Weapon when modifierTargetModel != null && modifierTargetWeapon != null:
                VersusService.AddWeaponModifier(editingUnit.Id, modifierTargetModel.Id, modifierTargetWeapon.Id, modifier);
                break;
        }

        StateHasChanged();
    }

    private void HandleModifierDeleted(ConditionalModifier modifier)
    {
        RemoveModifier(modifierTargetModel, modifierTargetWeapon, modifier, currentModifierTarget);
    }

    private void RemoveModifier(CombatModel? model, CombatWeapon? weapon, ConditionalModifier modifier, ModifierTarget target)
    {
        if (editingUnit == null) return;

        switch (target)
        {
            case ModifierTarget.Unit:
                VersusService.RemoveUnitModifier(editingUnit.Id, modifier.Id);
                break;
            case ModifierTarget.Model when model != null:
                VersusService.RemoveModelModifier(editingUnit.Id, model.Id, modifier.Id);
                break;
            case ModifierTarget.Weapon when model != null && weapon != null:
                VersusService.RemoveWeaponModifier(editingUnit.Id, model.Id, weapon.Id, modifier.Id);
                break;
        }

        StateHasChanged();
    }

    private void ApplyBuiltInModifiers(CombatWeapon weapon)
    {
        // Apply modifiers that are built into the weapon abilities
        if (weapon.Abilities.Torrent)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = "Torrent (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.Always },
                Effect = new ModifierEffect { Type = EffectType.AddHitModifier, IntValue = 100 },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.TwinLinked)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = "Twin-Linked (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.Always },
                Effect = new ModifierEffect { Type = EffectType.RerollWounds },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.LethalHits)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = "Lethal Hits (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.CriticalHit },
                Effect = new ModifierEffect { Type = EffectType.AutoWoundOnCrit },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.DevastatingWounds)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = "Devastating Wounds (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.CriticalWound },
                Effect = new ModifierEffect { Type = EffectType.ConvertToMortalWounds },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.SustainedHits.HasValue)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = $"Sustained Hits {weapon.Abilities.SustainedHits} (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.CriticalHit },
                Effect = new ModifierEffect { Type = EffectType.AddExtraHitsOnCrit, IntValue = weapon.Abilities.SustainedHits.Value },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.RapidFire.HasValue)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = $"Rapid Fire {weapon.Abilities.RapidFire} (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.TargetWithinHalfRange },
                Effect = new ModifierEffect { Type = EffectType.AddAttacks, IntValue = weapon.Abilities.RapidFire.Value },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.Melta.HasValue)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = $"Melta {weapon.Abilities.Melta} (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.TargetWithinHalfRange },
                Effect = new ModifierEffect { Type = EffectType.AddDamageModifier, IntValue = weapon.Abilities.Melta.Value },
                IsActive = true,
                IsCustom = false
            });
        }

        if (weapon.Abilities.IgnoresCover)
        {
            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = "Ignores Cover (Built-in)",
                Condition = new ModifierCondition { Type = ConditionType.Always },
                Effect = new ModifierEffect { Type = EffectType.IgnoreCover },
                IsActive = true,
                IsCustom = false
            });
        }

        // Anti-X Y+ (generic keyword support) - Handle multiple Anti keywords
        foreach (var antiAbility in weapon.Abilities.GetAntiAbilities())
        {
            // Extract keyword from the ability ID (e.g., "anti_vehicle" -> "vehicle")
            var keyword = antiAbility.Id.Replace("anti_", "").Replace("_", " ");
            var threshold = antiAbility.Value ?? 4; // Default to 4+ if not specified

            weapon.Modifiers.Add(new ConditionalModifier
            {
                Name = $"{antiAbility.DisplayName} (Built-in)",
                Condition = new ModifierCondition 
                { 
                    Type = ConditionType.TargetHasKeyword,
                    Value = keyword
                },
                Effect = new ModifierEffect { Type = EffectType.CriticalWoundOn, IntValue = threshold },
                IsActive = true,
                IsCustom = false
            });
        }
    }

    private WeaponAbilities ParseWeaponAbilities(string description)
    {
