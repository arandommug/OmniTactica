    private static List<UnitConfigurationView> BuildUnitConfigurations(DatasheetDetail datasheet)
    {
        var configurations = new List<UnitConfigurationView>();
        var compositionOptions = ParseCompositionOptions(datasheet.UnitComposition);
        var usedCompositionIndexes = new HashSet<int>();

        foreach (var cost in datasheet.Costs)
        {
            var description = NormalizeDisplayText(cost.Description);
            var matchingOption = FindMatchingCompositionOption(compositionOptions, usedCompositionIndexes, description);

            if (matchingOption != null)
            {
                usedCompositionIndexes.Add(matchingOption.Index);
                configurations.Add(new UnitConfigurationView(
                    matchingOption.DisplayText,
                    string.Equals(matchingOption.DisplayText, description, StringComparison.OrdinalIgnoreCase) ? string.Empty : description,
                    cost.Cost));
                continue;
            }

            configurations.Add(new UnitConfigurationView(
                string.IsNullOrWhiteSpace(description) ? "Configuration" : description,
                string.Empty,
                cost.Cost));
        }

        foreach (var option in compositionOptions.Where(option => !usedCompositionIndexes.Contains(option.Index)))
        {
            configurations.Add(new UnitConfigurationView(option.DisplayText, string.Empty, null));
        }

        return configurations;
    }

    private static List<CompositionOptionView> ParseCompositionOptions(IEnumerable<DatasheetUnitComposition> compositionEntries)
    {
        var options = new List<CompositionOptionView>();
        var currentEntries = new List<UnitCompositionEntry>();
        var currentDescriptions = new List<string>();
        var index = 0;

        foreach (var compositionEntry in compositionEntries)
        {
            var description = NormalizeDisplayText(compositionEntry.Description);
            if (string.IsNullOrWhiteSpace(description))
            {
                continue;
            }

            if (description.Equals("OR", StringComparison.OrdinalIgnoreCase))
            {
                AddCompositionOption(options, currentEntries, currentDescriptions, ref index);
                currentEntries = new List<UnitCompositionEntry>();
                currentDescriptions = new List<string>();
                continue;
            }

            currentDescriptions.Add(description);
            currentEntries.AddRange(ParseCompositionEntries(description));
        }

        AddCompositionOption(options, currentEntries, currentDescriptions, ref index);
        return options;
    }

    private static void AddCompositionOption(List<CompositionOptionView> options, List<UnitCompositionEntry> entries, List<string> descriptions, ref int index)
    {
        if (entries.Count == 0 && descriptions.Count == 0)
        {
            return;
        }

        var displayText = entries.Count > 0
            ? FormatComposition(entries)
            : string.Join(" • ", descriptions);

        options.Add(new CompositionOptionView(index++, entries, displayText));
    }

    private static CompositionOptionView? FindMatchingCompositionOption(
        IEnumerable<CompositionOptionView> options,
        HashSet<int> usedCompositionIndexes,
        string costDescription)
    {
        var availableOptions = options
            .Where(option => !usedCompositionIndexes.Contains(option.Index))
            .ToList();

        if (availableOptions.Count == 0)
        {
            return null;
        }

        var costEntries = ParseCostDescriptionEntries(costDescription);
        if (costEntries.Count > 0)
        {
            var exactMatch = availableOptions.FirstOrDefault(option => option.Entries.Count > 0 && MatchesCompositionOption(option.Entries, costEntries));
            if (exactMatch != null)
            {
                return exactMatch;
            }

            var targetTotal = costEntries.Sum(entry => entry.Quantity);
            var countMatch = availableOptions.FirstOrDefault(option => option.Entries.Count > 0 && option.Entries.Sum(entry => entry.Quantity) == targetTotal);
            if (countMatch != null)
            {
                return countMatch;
            }
        }

        return availableOptions.Count == 1 ? availableOptions[0] : null;
    }

    private static List<UnitCompositionEntry> ParseCompositionEntries(string description)
    {
        var matches = Regex.Matches(description, @"(\d+)(?:-(\d+))?\s+(.+?)(?=(?:\s+and\s+\d)|$)", RegexOptions.IgnoreCase);
        var entries = new List<UnitCompositionEntry>();

        foreach (Match match in matches)
        {
            if (!match.Success)
            {
                continue;
            }

            var minQuantity = int.Parse(match.Groups[1].Value);
            var maxQuantity = match.Groups[2].Success ? int.Parse(match.Groups[2].Value) : minQuantity;
            var name = match.Groups[3].Value.Trim();
            entries.Add(new UnitCompositionEntry(name, minQuantity, maxQuantity));
        }

        return entries;
    }

    private static List<CostDescriptionEntry> ParseCostDescriptionEntries(string description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return [];
        }

        return description.Split(new[] { " and ", "," }, StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Trim())
            .Select(ParseCostDescriptionEntry)
            .Where(entry => entry != null)
            .Cast<CostDescriptionEntry>()
            .ToList();
    }

    private static CostDescriptionEntry? ParseCostDescriptionEntry(string text)
    {
        var match = Regex.Match(text, @"^(\d+)\s+(.+)$", RegexOptions.IgnoreCase);
        if (!match.Success)
        {
            return null;
        }

        var quantity = int.Parse(match.Groups[1].Value);
        var name = match.Groups[2].Value.Trim();
        var normalizedName = NormalizeName(name);

        return new CostDescriptionEntry(
            quantity,
            name,
            normalizedName is "model" or "models");
    }

    private static bool MatchesCompositionOption(IEnumerable<UnitCompositionEntry> option, IEnumerable<CostDescriptionEntry> costEntries)
    {
        var optionList = option.ToList();
        var costList = costEntries.ToList();

        if (costList.Count == 1 && costList[0].IsGenericModelCount)
        {
            return optionList.Sum(entry => entry.Quantity) == costList[0].Quantity;
        }

        if (optionList.Count != costList.Count)
        {
            return false;
        }

        foreach (var costEntry in costList)
        {
            var matchingEntry = optionList.FirstOrDefault(entry => NamesMatch(entry.Name, costEntry.Name));
            if (matchingEntry == null || matchingEntry.Quantity != costEntry.Quantity)
            {
                return false;
            }
        }

        return true;
    }

    private static string FormatComposition(IEnumerable<UnitCompositionEntry> entries)
        => string.Join(" and ", entries.Select(entry => $"{entry.Quantity} {entry.Name}"));

    private static bool NamesMatch(string modelName, string costName)
    {
        var normalizedModel = NormalizeName(modelName);
        var normalizedCost = NormalizeName(costName);

        return normalizedModel == normalizedCost
               || normalizedModel.Contains(normalizedCost, StringComparison.OrdinalIgnoreCase)
               || normalizedCost.Contains(normalizedModel, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeName(string value)
    {
        var normalizedWords = Regex.Replace(value.ToLowerInvariant(), @"[^a-z0-9\s]", " ")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => word.Length > 3 && word.EndsWith('s') ? word[..^1] : word);

        return string.Join(' ', normalizedWords);
    }

    private static string NormalizeDisplayText(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : HtmlUtility.ConvertHtmlToPlainText(value).Trim();

    private enum ModifierTarget
    {
        Unit,
        Model,
        Weapon
    }

    private sealed record UnitConfigurationView(string Title, string Subtitle, int? Cost);
    private sealed record CompositionOptionView(int Index, List<UnitCompositionEntry> Entries, string DisplayText);
    private sealed record CostDescriptionEntry(int Quantity, string Name, bool IsGenericModelCount);
    private sealed record UnitCompositionEntry(string Name, int MinQuantity, int MaxQuantity)
    {
        public int Quantity => MinQuantity;
    }

