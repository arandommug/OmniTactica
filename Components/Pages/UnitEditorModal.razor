    }

    private int ParseStatValue(string value)
    {
        if (string.IsNullOrEmpty(value) || value == "-" || value == "N/A")
            return 0;

        value = value.Replace("+", "").Replace("\"", "").Replace("'", "").Trim();

        if (int.TryParse(value, out var result))
            return result;

        return 0;
    }

