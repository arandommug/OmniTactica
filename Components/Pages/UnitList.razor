@page "/faction/{FactionId}/units"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core
@using Microsoft.JSInterop

@inject WahaSQLiteService DB
@inject WahaDataService Data
@inject NavigationManager Navigation
@inject FactionViewerState ViewerState
@inject IJSRuntime JS
@implements IDisposable

<style>
    .unit-list-group {
        border: 1px solid rgba(var(--bs-border-color-rgb, 255, 255, 255), 0.2);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .unit-list-item {
        border: 0;
        border-bottom: 1px solid rgba(var(--bs-border-color-rgb, 255, 255, 255), 0.2);
        background: transparent;
    }

    .unit-list-item:last-child {
        border-bottom: 0;
    }
</style>

<div class="p-2">
    <div class="card bg-secondary-subtle">
        <div class="card-header d-flex align-items-center">
            <BackButton FallbackHref="@($"/faction/{FactionId}")" />

            <h1 class="text-primary m-0 ms-3">Units</h1>
        </div>
        <div class="card-body">
            @if (loading)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                    <div>Loading units...</div>
                </div>
            }
            else
            {
                <!-- Keyword Filter Component -->
                <div class="mb-3">
                    <KeywordFilterModal 
                        FactionId="@FactionId"
                        InitialIncludeKeywords="@includeKeywords"
                        InitialExcludeKeywords="@excludeKeywords"
                        InitialUseAndLogic="@useAndLogic"
                        OnApplyFilter="@HandleKeywordFilterApplied" />
                </div>

                <!-- Units List -->
                <div class="mb-2">
                    <strong>@datasheets.Count @(datasheets.Count == 1 ? "Unit" : "Units") Found</strong>
                </div>

                @if (datasheets.Count == 0)
                {
                    <div class="text-muted">No units found @((includeKeywords.Count > 0 || excludeKeywords.Count > 0) ? "matching the selected keywords" : "for this faction").</div>
                }
                else
                {
                    <div class="list-group unit-list-group">
                        <Virtualize Items="datasheets" Context="unit" ItemSize="88" OverscanCount="4">
                            <a href="@($"/faction/{FactionId}/unit/{unit.Id}")" class="list-group-item list-group-item-action unit-list-item" @key="unit.Id" @onclick="@(() => SaveScrollPosition())" @onclick:preventDefault="false">
                                <div class="d-flex w-100 justify-content-between align-items-start gap-2">
                                    <div class="flex-grow-1 min-w-0">
                                        <h5 class="mb-1">@unit.Name</h5>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        @if (unit.PointsCost.HasValue)
                                        {
                                            <span class="badge bg-success">@unit.PointsCost pts</span>
                                        }
                                        <i class="fa fa-chevron-right text-muted"></i>
                                    </div>
                                </div>
                            </a>
                        </Virtualize>
                    </div>
                }
            }
        </div>
    </div>
    <ScrollToTopButton />
</div>

@code {
    [Parameter]
    public string FactionId { get; set; } = string.Empty;

    private List<Datasheet> datasheets = new();
    private bool loading = true;

    // Keyword filtering
    private List<string> includeKeywords = new();
    private List<string> excludeKeywords = new();
    private bool useAndLogic = false;

    protected override async Task OnInitializedAsync()
    {
        if (!DB.DatabaseExists)
        {
            loading = false;
            return;
        }

        // Ensure state is for correct faction
        ViewerState.ResetForFaction(FactionId);

        // Load state from service
        includeKeywords = new List<string>(ViewerState.SelectedKeywords);
        excludeKeywords = new List<string>(ViewerState.ExcludedKeywords);
        useAndLogic = ViewerState.UseAndLogic;

        await LoadUnitsAsync();
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore scroll position if returning from unit viewer
            await JS.InvokeVoidAsync("restoreScrollPosition", $"unitlist_{FactionId}");
        }
    }

    private void SaveScrollPosition()
    {
        // Save scroll position before navigating away
        _ = JS.InvokeVoidAsync("saveScrollPosition", $"unitlist_{FactionId}");
    }

    private async Task LoadUnitsAsync()
    {
        datasheets = await Data.GetDatasheetsByFactionAsync(
            FactionId, 
            includeKeywords.Count > 0 ? includeKeywords : null, 
            excludeKeywords.Count > 0 ? excludeKeywords : null,
            useAndLogic);
    }

    private async Task HandleKeywordFilterApplied((List<string> IncludeKeywords, List<string> ExcludeKeywords, bool UseAndLogic) filterValues)
    {
        includeKeywords = filterValues.IncludeKeywords;
        excludeKeywords = filterValues.ExcludeKeywords;
        useAndLogic = filterValues.UseAndLogic;

        // Save to state
        ViewerState.SetKeywordFilter(includeKeywords, excludeKeywords, useAndLogic);

        loading = true;
        StateHasChanged();

        await LoadUnitsAsync();

        loading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}
