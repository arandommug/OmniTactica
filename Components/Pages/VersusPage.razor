@page "/versus"
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core
@using Microsoft.JSInterop

@inject VersusService VersusService
@inject BookmarkService BookmarkService
@inject IJSRuntime JS
@implements IDisposable

<style>
    .unit-summary-card {
        transition: background 0.15s ease;
        cursor: pointer;
        border-left: 3px solid transparent;
    }
    .unit-summary-card:hover {
        background: rgba(0, 0, 0, 0.04);
    }
    .unit-summary-card.border-danger { border-left-color: var(--bs-danger); }
    .unit-summary-card.border-primary { border-left-color: var(--bs-primary); }
    .unit-weapon-summary { font-size: 0.75rem; color: var(--bs-secondary); line-height: 1.6; }
    .unit-weapon-summary .weapon-line { display: flex; align-items: center; gap: 0.25rem; }
</style>

<div class="p-2">

    <!-- Setup card -->
    <div class="card bg-secondary-subtle mb-3">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h1 class="text-primary mb-0" style="font-size: 1.4rem;">
                <i class="fa fa-fist-raised me-2"></i>Versus Calculator
            </h1>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" @onclick="SwapSides" title="Swap Attacker and Defender">
                    <i class="fa fa-exchange-alt"></i> Swap
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ShowSettings">
                    <i class="fa fa-cog"></i>
                </button>
                <button class="btn btn-sm btn-success" @onclick="Calculate" disabled="@(!CanCalculate())">
                    <i class="fa fa-calculator"></i> Calculate
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="ClearAll">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">

                <!-- ATTACKER -->
                <div class="col-12 col-md-6">
                    <div class="card border-danger h-100">
                        <div class="card-header d-flex justify-content-between align-items-center py-2 text-danger">
                            <span class="fw-semibold"><i class="fa fa-crosshairs me-1"></i> Attacker</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowUnitPicker(true)">
                                    <i class="fa fa-plus"></i> Add
                                </button>
                                @if (BookmarkService.GetBookmarksByType(BookmarkType.Datasheet).Any())
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            <i class="fa fa-bookmark"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @foreach (var bookmark in BookmarkService.GetBookmarksByType(BookmarkType.Datasheet))
                                            {
                                                <li>
                                                    <a class="dropdown-item" @onclick="() => AddFromBookmark(int.Parse(bookmark.EntityId), true)">
                                                        <i class="fa fa-bookmark me-2"></i>@bookmark.Name
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-body p-2">
                            @if (!context.AttackingUnits.Any())
                            {
                                <div class="text-muted small text-center py-4">
                                    <i class="fa fa-crosshairs fa-2x mb-2 d-block opacity-25"></i>
                                    No attacker selected. Click "Add" to begin.
                                </div>
                            }
                            else
                            {
                                @foreach (var unit in context.AttackingUnits)
                                {
                                    <div class="unit-summary-card border-danger rounded p-2 mb-2" @onclick="() => EditUnit(unit, true)">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong style="font-size: 0.9rem;">@unit.DatasheetName</strong>
                                                <div class="text-muted" style="font-size: 0.75rem;">@unit.Models.Sum(m => m.Quantity) models</div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger border-0 py-0" @onclick:stopPropagation="true" @onclick="() => RemoveUnit(unit.Id, true)">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                        @{ var attackerWeapons = unit.Models.SelectMany(m => m.Weapons.Where(w => w.IsSelected)).ToList(); }
                                        @if (attackerWeapons.Any())
                                        {
                                            <div class="unit-weapon-summary mt-1">
                                                @foreach (var wg in attackerWeapons.GroupBy(w => w.Type))
                                                {
                                                    <div class="weapon-line">
                                                        <span class="badge @(wg.Key == "Melee" ? "bg-danger" : "bg-primary") bg-opacity-75" style="font-size: 0.6rem;">@wg.Key</span>
                                                        <span>@wg.Sum(w => ParseAttacks(w.A) * w.Quantity) attacks</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (unit.Modifiers.Any(m => m.IsActive))
                                        {
                                            <div class="mt-1">
                                                @foreach (var mod in unit.Modifiers.Where(m => m.IsActive).Take(3))
                                                {
                                                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis" style="font-size: 0.65rem;">@mod.Name</span>
                                                }
                                                @if (unit.Modifiers.Count(m => m.IsActive) > 3)
                                                {
                                                    <span class="text-muted" style="font-size: 0.65rem;">+@(unit.Modifiers.Count(m => m.IsActive) - 3) more</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- DEFENDER -->
                <div class="col-12 col-md-6">
                    <div class="card border-primary h-100">
                        <div class="card-header d-flex justify-content-between align-items-center py-2 text-primary">
                            <span class="fw-semibold"><i class="fa fa-shield-alt me-1"></i> Defender</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowUnitPicker(false)">
                                    <i class="fa fa-plus"></i> Add
                                </button>
                                @if (BookmarkService.GetBookmarksByType(BookmarkType.Datasheet).Any())
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            <i class="fa fa-bookmark"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @foreach (var bookmark in BookmarkService.GetBookmarksByType(BookmarkType.Datasheet))
                                            {
                                                <li>
                                                    <a class="dropdown-item" @onclick="() => AddFromBookmark(int.Parse(bookmark.EntityId), false)">
                                                        <i class="fa fa-bookmark me-2"></i>@bookmark.Name
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-body p-2">
                            @if (!context.DefendingUnits.Any())
                            {
                                <div class="text-muted small text-center py-4">
                                    <i class="fa fa-shield-alt fa-2x mb-2 d-block opacity-25"></i>
                                    No defender selected. Click "Add" to begin.
                                </div>
                            }
                            else
                            {
                                @foreach (var unit in context.DefendingUnits)
                                {
                                    <div class="unit-summary-card border-primary rounded p-2 mb-2" @onclick="() => EditUnit(unit, false)">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong style="font-size: 0.9rem;">@unit.DatasheetName</strong>
                                                <div class="text-muted" style="font-size: 0.75rem;">@unit.Models.Sum(m => m.Quantity) models</div>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger border-0 py-0" @onclick:stopPropagation="true" @onclick="() => RemoveUnit(unit.Id, false)">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </div>
                                        @if (unit.Modifiers.Any(m => m.IsActive))
                                        {
                                            <div class="mt-1">
                                                @foreach (var mod in unit.Modifiers.Where(m => m.IsActive).Take(3))
                                                {
                                                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis" style="font-size: 0.65rem;">@mod.Name</span>
                                                }
                                                @if (unit.Modifiers.Count(m => m.IsActive) > 3)
                                                {
                                                    <span class="text-muted" style="font-size: 0.65rem;">+@(unit.Modifiers.Count(m => m.IsActive) - 3) more</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Calculating spinner -->
    @if (calculating)
    {
        <div class="card bg-secondary-subtle mb-3">
            <div class="card-body text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="text-muted mt-2 small">Calculating @context.SimulationSettings.Iterations.ToString("N0") simulations...</div>
            </div>
        </div>
    }

    <!-- Results card -->
    @if (result != null && !calculating)
    {
        <div class="card bg-secondary-subtle mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="fw-semibold text-success"><i class="fa fa-chart-bar me-1"></i> Results</span>
                <span class="text-muted small">@result.SimulationCount.ToString("N0") simulations</span>
            </div>
            <div class="card-body">

                <!-- Summary stat tiles -->
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 text-center p-2" style="background: rgba(var(--bs-primary-rgb), 0.08);">
                            <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Avg Damage</div>
                            <div class="fw-bold text-primary" style="font-size: 1.5rem;">@result.AverageDamage.ToString("F1")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 text-center p-2" style="background: rgba(var(--bs-info-rgb), 0.08);">
                            <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Median</div>
                            <div class="fw-bold text-info" style="font-size: 1.5rem;">@result.MedianDamage</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 text-center p-2" style="background: rgba(var(--bs-warning-rgb), 0.08);">
                            <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Models Killed</div>
                            <div class="fw-bold text-warning" style="font-size: 1.5rem;">@result.AverageModelsKilled.ToString("F1")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 text-center p-2" style="background: rgba(var(--bs-danger-rgb), 0.08);">
                            <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Wipeout</div>
                            <div class="fw-bold text-danger" style="font-size: 1.5rem;">@result.WipeoutProbability.ToString("F0")%</div>
                        </div>
                    </div>
                </div>

                <!-- Stage Breakdown + Damage Distribution -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header py-2">
                                <span class="fw-semibold small text-secondary">Stage Breakdown</span>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr>
                                            <td>Total Attacks:</td>
                                            <td class="text-end"><strong>@result.Stages.TotalAttacks.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Total Hits:</td>
                                            <td class="text-end"><strong>@result.Stages.TotalHits.ToString("F1")</strong> (@((result.Stages.TotalHits / result.Stages.TotalAttacks * 100).ToString("F1"))%)</td>
                                        </tr>
                                        <tr>
                                            <td>Critical Hits:</td>
                                            <td class="text-end"><strong>@result.Stages.CriticalHits.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Total Wounds:</td>
                                            <td class="text-end"><strong>@result.Stages.TotalWounds.ToString("F1")</strong> (@((result.Stages.TotalWounds / result.Stages.TotalHits * 100).ToString("F1"))%)</td>
                                        </tr>
                                        <tr>
                                            <td>Critical Wounds:</td>
                                            <td class="text-end"><strong>@result.Stages.CriticalWounds.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Mortal Wounds:</td>
                                            <td class="text-end"><strong>@result.Stages.MortalWounds.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Failed Saves:</td>
                                            <td class="text-end"><strong>@result.Stages.FailedSaves.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Successful Saves:</td>
                                            <td class="text-end"><strong>@result.Stages.SuccessfulSaves.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Invulnerable Saves:</td>
                                            <td class="text-end"><strong>@result.Stages.InvulnerableSaves.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Feel No Pain Saves:</td>
                                            <td class="text-end"><strong>@result.Stages.FeelNoPainSaves.ToString("F1")</strong></td>
                                        </tr>
                                        <tr class="table-primary">
                                            <td><strong>Total Damage Dealt:</strong></td>
                                            <td class="text-end"><strong>@result.Stages.TotalDamageDealt.ToString("F1")</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Damage Prevented:</td>
                                            <td class="text-end"><strong>@result.Stages.TotalDamagePrevented.ToString("F1")</strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header py-2">
                                <span class="fw-semibold small text-secondary">Damage Distribution</span>
                            </div>
                            <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>Damage</th>
                                            <th>Probability</th>
                                            <th>Chart</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in result.DamageDistribution.OrderBy(kvp => kvp.Key))
                                        {
                                            <tr>
                                                <td>@entry.Key</td>
                                                <td>@entry.Value.ToString("F2")%</td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar" style="width: @entry.Value%"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Combat Log -->
                @if (result.SampleCombatLog.Any())
                {
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span class="fw-semibold small text-secondary"><i class="fa fa-scroll me-1"></i> Combat Log</span>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="verboseModeSwitch"
                                           checked="@verboseMode" @onchange="ToggleVerboseMode">
                                    <label class="form-check-label small" for="verboseModeSwitch">
                                        <i class="fa fa-dice"></i> Verbose
                                    </label>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleLogExpanded">
                                    <i class="fa @(logExpanded ? "fa-compress" : "fa-expand")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0" style="@(logExpanded ? "" : "max-height: 600px; overflow-y: auto;")">
                            <CombatLogViewer Entries="@result.SampleCombatLog" VerboseMode="@verboseMode" />
                        </div>
                    </div>
                }

            </div>
        </div>
    }

</div>

<!-- Unit Picker Modal -->
<UnitPickerModal @ref="unitPickerModal" OnUnitSelected="HandleUnitSelected" />

<!-- Unit Editor Modal -->
<UnitEditorModal @ref="unitEditorModal" OnClosed="HandleUnitEditorClosed" />

<!-- Settings Modal -->
<SimulationSettingsModal @ref="settingsModal" Settings="@context.SimulationSettings" OnSettingsChanged="HandleSettingsChanged" />

@code {
    private VersusContext context = new();
    private VersusResult? result;
    private UnitPickerModal unitPickerModal = null!;
    private UnitEditorModal unitEditorModal = null!;
    private SimulationSettingsModal settingsModal = null!;
    private bool calculating = false;
    private bool isAddingAttacker = true;
    private bool logExpanded = false;
    private bool verboseMode = false;

    protected override void OnInitialized()
    {
        context = VersusService.GetContext();
        VersusService.OnContextChanged += HandleContextChanged;
    }

    private void HandleContextChanged()
    {
        context = VersusService.GetContext();
        StateHasChanged();
    }

    private async Task ShowUnitPicker(bool isAttacker)
    {
        isAddingAttacker = isAttacker;
        await unitPickerModal.Show();
    }

    private async Task HandleUnitSelected(int datasheetId)
    {
        try
        {
            if (isAddingAttacker)
                await VersusService.AddAttackingUnitAsync(datasheetId);
            else
                await VersusService.AddDefendingUnitAsync(datasheetId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error adding unit: {ex.Message}");
        }
    }

    private async Task AddFromBookmark(int datasheetId, bool isAttacker)
    {
        try
        {
            if (isAttacker)
                await VersusService.AddAttackingUnitAsync(datasheetId);
            else
                await VersusService.AddDefendingUnitAsync(datasheetId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error adding unit from bookmark: {ex.Message}");
        }
    }

    private async Task EditUnit(CombatUnit unit, bool isAttacker)
    {
        await unitEditorModal.Show(unit, isAttacker);
    }

    private void HandleUnitEditorClosed()
    {
        StateHasChanged();
    }

    private void RemoveUnit(string unitId, bool isAttacker)
    {
        if (isAttacker)
            VersusService.RemoveAttackingUnit(unitId);
        else
            VersusService.RemoveDefendingUnit(unitId);
    }

    private async Task Calculate()
    {
        calculating = true;
        result = null;
        StateHasChanged();

        await Task.Delay(10);

        try
        {
            result = await Task.Run(() => VersusCalculator.Calculate(context));
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error calculating: {ex.Message}");
        }
        finally
        {
            calculating = false;
            StateHasChanged();
        }
    }

    private bool CanCalculate()
    {
        return context.AttackingUnits.Any() &&
               context.DefendingUnits.Any() &&
               context.AttackingUnits.Any(u => u.Models.Any(m => m.Weapons.Any(w => w.IsSelected)));
    }

    private void SwapSides()
    {
        VersusService.SwapAttackerDefender();
    }

    private async Task ShowSettings()
    {
        await settingsModal.Show();
    }

    private void HandleSettingsChanged(SimulationSettings settings)
    {
        VersusService.UpdateSimulationSettings(settings);
    }

    private void ClearAll()
    {
        VersusService.ClearAll();
        result = null;
    }

    private void ToggleLogExpanded()
    {
        logExpanded = !logExpanded;
    }

    private void ToggleVerboseMode(ChangeEventArgs e)
    {
        verboseMode = (bool)(e.Value ?? false);
        StateHasChanged();
    }

    private int ParseAttacks(string attacks)
    {
        if (string.IsNullOrWhiteSpace(attacks)) return 0;
        var cleaned = attacks.Replace("D", "").Replace("d", "").Replace("+", "").Trim();
        if (int.TryParse(cleaned, out var result)) return result;
        return 1;
    }

    public void Dispose()
    {
        VersusService.OnContextChanged -= HandleContextChanged;
    }
}
