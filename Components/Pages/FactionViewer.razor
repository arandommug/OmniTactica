@page "/faction/{FactionId}"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Data.Import
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Models.Core
@using OmniTactica.AppCode.Models.Rules
@using OmniTactica.AppCode.Helpers

@inject WahaSQLiteService DB
@inject WahaDataService Data
@inject FactionViewerState ViewerState

<div class="p-2">
    <div class="card bg-secondary-subtle">
        <div class="card-header d-flex align-items-center">
            <NavLink class="btn btn-dark btn-sm w-auto" href="/">
                <i class="fa fa-chevron-left" aria-hidden="true"></i>
            </NavLink>

            <h1 class="text-primary m-0 ms-3">@faction?.Name</h1>

            <NavLink class="btn btn-outline-primary ms-auto" href="@($"/faction/{FactionId}/units")">
                Units<i class="fa fa-chevron-right ms-2" aria-hidden="true"></i>
            </NavLink>
        </div>
        <div class="card-body">
            @if (loading)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                    <div>Loading faction data...</div>
                </div>
            }
            else if (faction == null)
            {
                <div class="alert alert-danger">Faction not found.</div>
            }
            else
            {
                <!-- Keyword Filter Component -->
                <div class="mb-3">
                    <KeywordFilterModal 
                        FactionId="@FactionId"
                        InitialIncludeKeywords="@selectedKeywords"
                        InitialExcludeKeywords="@excludedKeywords"
                        InitialUseAndLogic="@useAndLogic"
                        OnApplyFilter="@HandleKeywordFilterApplied" />
                </div>

                <!-- Army Abilities Section -->
                <div class="h4 text-primary">Army Abilities</div>
                @if (faction.Abilities.Count == 0)
                {
                    <div class="text-muted mb-3">No army abilities available @(selectedKeywords.Count > 0 ? "matching the selected keywords" : "").</div>
                }
                else
                {
                    <div class="accordion mb-4">
                    @foreach (var a in faction.Abilities)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ability-@(a.Id)" aria-expanded="false" aria-controls="ability-@(a.Id)">
                                    @a.Name
                                </button>
                            </h2>
                            <div id="ability-@(a.Id)" class="accordion-collapse collapse">
                                <div class="accordion-body rule-content">
                                    @((MarkupString)WahaDataImporter.CleanHtml(a.Description))                                
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                }

                <hr />

                <!-- Detachments Section -->
                <div class="h4 text-primary">Detachments</div>
                @if (detachments.Count == 0)
                {
                    <div class="text-muted">No detachments available @(selectedKeywords.Count > 0 ? "matching the selected keywords" : "for this faction").</div>
                }
                else
                {
                    <div class="mb-3">
                        <label for="detachmentSelect" class="form-label">Select a Detachment</label>
                        <select id="detachmentSelect" class="form-select" @bind="selectedDetachmentId" @bind:after="OnDetachmentChanged">
                            <option value="0">-- Choose Detachment --</option>
                            @foreach (var d in detachments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>

                    @if (loadingDetachment)
                    {
                        <div class="d-flex align-items-center">
                            <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
                            <div>Loading detachment details...</div>
                        </div>
                    }
                    else if (selectedDetachment != null)
                    {
                        <!-- Detachment Details -->
                        <div class="card mb-3">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">@selectedDetachment.Name</h5>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(selectedDetachment.Legend))
                                {
                                    <div class="mb-3">
                                        <h6 class="text-secondary">Description</h6>
                                        <div class="rule-content">
                                            @((MarkupString)WahaDataImporter.CleanHtml(selectedDetachment.Legend))
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(selectedDetachment.Type))
                                {
                                    <div class="mb-2">
                                        <strong>Type:</strong> @selectedDetachment.Type
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Detachment Abilities -->
                        @if (selectedDetachment.Abilities.Count > 0)
                        {
                            <div class="mb-4">
                                <h5 class="text-primary">Detachment Abilities</h5>
                                <div class="accordion">
                                @foreach (var ability in selectedDetachment.Abilities)
                                {
                                    var combinedText = $"{ability.Legend} {ability.Description}";
                                    var matchesFilter = KeywordFilterHelper.MatchesKeywordFilter(combinedText, selectedKeywords, excludedKeywords, useAndLogic);
                                    var matchedKeywords = matchesFilter ? KeywordFilterHelper.GetMatchedKeywords(combinedText, selectedKeywords) : new List<string>();
                                    var passesFilter = KeywordFilterHelper.PassesFilter(combinedText, selectedKeywords, excludedKeywords, useAndLogic);

                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#det-ability-@(ability.Id)" aria-expanded="false">
                                                @ability.Name
                                                @if (matchesFilter)
                                                {
                                                    <span class="badge bg-success ms-2" title="Matches: @string.Join(", ", matchedKeywords)">
                                                        <i class="fa fa-filter me-1"></i>@matchedKeywords.Count keyword@(matchedKeywords.Count == 1 ? "" : "s")
                                                    </span>
                                                }
                                            </button>
                                        </h2>
                                        <div id="det-ability-@(ability.Id)" class="accordion-collapse collapse">
                                            <div class="accordion-body rule-content">
                                                @if (!string.IsNullOrEmpty(ability.Legend))
                                                {
                                                    <div class="text-muted mb-2"><small>@ability.Legend</small></div>
                                                }
                                                @((MarkupString)WahaDataImporter.CleanHtml(ability.Description))
                                            </div>
                                        </div>
                                    </div>
                                }
                                </div>
                            </div>
                        }

                        <!-- Stratagems -->
                        @if (selectedDetachment.Stratagems.Count > 0)
                        {
                            <div class="mb-4">
                                <h5 class="text-primary">Stratagems</h5>
                                <div class="accordion">
                                @foreach (var strat in selectedDetachment.Stratagems)
                                {
                                    var combinedText = $"{strat.Legend} {strat.Description}";
                                    var matchesFilter = KeywordFilterHelper.MatchesKeywordFilter(combinedText, selectedKeywords, excludedKeywords, useAndLogic);
                                    var matchedKeywords = matchesFilter ? KeywordFilterHelper.GetMatchedKeywords(combinedText, selectedKeywords) : new List<string>();
                                    var passesFilter = KeywordFilterHelper.PassesFilter(combinedText, selectedKeywords, excludedKeywords, useAndLogic);

                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#strat-@(strat.Id)" aria-expanded="false">
                                                @strat.Name
                                                @if (!string.IsNullOrEmpty(strat.CpCost))
                                                {
                                                    <span class="badge bg-warning text-dark ms-2">@strat.CpCost CP</span>
                                                }
                                                @if (matchesFilter)
                                                {
                                                    <span class="badge bg-success ms-2" title="Matches: @string.Join(", ", matchedKeywords)">
                                                        <i class="fa fa-filter me-1"></i>@matchedKeywords.Count keyword@(matchedKeywords.Count == 1 ? "" : "s")
                                                    </span>
                                                }
                                            </button>
                                        </h2>
                                        <div id="strat-@(strat.Id)" class="accordion-collapse collapse">
                                            <div class="accordion-body rule-content">
                                                <div class="mb-2">
                                                    @if (!string.IsNullOrEmpty(strat.Type))
                                                    {
                                                        <span class="badge bg-secondary me-1">@strat.Type</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(strat.Phase))
                                                    {
                                                        <span class="badge bg-info me-1">@strat.Phase</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(strat.Legend))
                                                {
                                                    <div class="text-muted mb-2"><small>@strat.Legend</small></div>
                                                }
                                                @((MarkupString)WahaDataImporter.CleanHtml(strat.Description))
                                            </div>
                                        </div>
                                    </div>
                                }
                                </div>
                            </div>
                        }

                        <!-- Enhancements -->
                        @if (selectedDetachment.Enhancements.Count > 0)
                        {
                            <div class="mb-4">
                                <h5 class="text-primary">Enhancements</h5>
                                <div class="accordion">
                                @foreach (var enhancement in selectedDetachment.Enhancements)
                                {
                                    var combinedText = $"{enhancement.Legend} {enhancement.Description}";
                                    var matchesFilter = KeywordFilterHelper.MatchesKeywordFilter(combinedText, selectedKeywords, excludedKeywords, useAndLogic);
                                    var matchedKeywords = matchesFilter ? KeywordFilterHelper.GetMatchedKeywords(combinedText, selectedKeywords) : new List<string>();
                                    var passesFilter = KeywordFilterHelper.PassesFilter(combinedText, selectedKeywords, excludedKeywords, useAndLogic);

                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#enh-@(enhancement.Id)" aria-expanded="false">
                                                @enhancement.Name
                                                <span class="badge bg-success text-white ms-2">@enhancement.Cost pts</span>
                                                @if (matchesFilter)
                                                {
                                                    <span class="badge bg-success ms-2" title="Matches: @string.Join(", ", matchedKeywords)">
                                                        <i class="fa fa-filter me-1"></i>@matchedKeywords.Count keyword@(matchedKeywords.Count == 1 ? "" : "s")
                                                    </span>
                                                }
                                            </button>
                                        </h2>
                                        <div id="enh-@(enhancement.Id)" class="accordion-collapse collapse">
                                            <div class="accordion-body rule-content">
                                                @if (!string.IsNullOrEmpty(enhancement.Legend))
                                                {
                                                    <div class="text-muted mb-2"><small>@enhancement.Legend</small></div>
                                                }
                                                @((MarkupString)WahaDataImporter.CleanHtml(enhancement.Description))
                                            </div>
                                        </div>
                                    </div>
                                }
                                </div>
                            </div>
                        }
                    }
                }
            }
        </div>
    </div>
    <ScrollToTopButton />
</div>

@code {
    [Parameter]
    public string FactionId { get; set; } = string.Empty;

    private Faction? faction;
    private List<Detachment> detachments = new();
    private Detachment? selectedDetachment;
    private int selectedDetachmentId = 0;
    private bool loading = true;
    private bool loadingDetachment = false;

    // Keyword filtering
    private List<string> selectedKeywords = new();
    private List<string> excludedKeywords = new();
    private bool useAndLogic = false;

    protected override async Task OnInitializedAsync()
    {
        if (!DB.DatabaseExists)
        {
            loading = false;
            return;
        }

        // Initialize or reset state for this faction
        ViewerState.ResetForFaction(FactionId);

        // Load state from service
        selectedKeywords = new List<string>(ViewerState.SelectedKeywords);
        excludedKeywords = new List<string>(ViewerState.ExcludedKeywords);
        useAndLogic = ViewerState.UseAndLogic;
        selectedDetachmentId = ViewerState.SelectedFactionDetachmentId ?? 0;

        await LoadFactionDataAsync();

        // If we had a detachment selected, reload it
        if (selectedDetachmentId > 0)
        {
            await OnDetachmentChanged();
        }

        loading = false;
    }

    private async Task LoadFactionDataAsync()
    {
        var overview = await Data.GetFactionOverviewAsync(FactionId, selectedKeywords.Count > 0 ? selectedKeywords : null, useAndLogic);
        if (overview != null)
        {
            faction = overview.Faction;
            detachments = overview.Detachments;
        }
    }

    private async Task HandleKeywordFilterApplied((List<string> IncludeKeywords, List<string> ExcludeKeywords, bool UseAndLogic) filterValues)
    {
        selectedKeywords = filterValues.IncludeKeywords;
        excludedKeywords = filterValues.ExcludeKeywords;
        useAndLogic = filterValues.UseAndLogic;

        // Save to state
        ViewerState.SetKeywordFilter(selectedKeywords, excludedKeywords, useAndLogic);

        // Remember the currently selected detachment
        var previousDetachmentId = selectedDetachmentId;

        loading = true;
        StateHasChanged();

        await LoadFactionDataAsync();

        // Check if the previously selected detachment is still available after filtering
        if (previousDetachmentId > 0)
        {
            var stillAvailable = detachments.Any(d => d.Id == previousDetachmentId);

            if (stillAvailable)
            {
                // Keep the selection and reload the detachment details
                selectedDetachmentId = previousDetachmentId;
                await OnDetachmentChanged();
            }
            else
            {
                // Clear the selection since it's no longer available
                selectedDetachment = null;
                selectedDetachmentId = 0;
                ViewerState.SelectedFactionDetachmentId = null;
                ViewerState.SetDetachment(null);
            }
        }

        loading = false;
        StateHasChanged();
    }

    private async Task OnDetachmentChanged()
    {
        if (selectedDetachmentId == 0)
        {
            selectedDetachment = null;
            ViewerState.SelectedFactionDetachmentId = null;
            ViewerState.SetDetachment(null);
            return;
        }

        loadingDetachment = true;
        StateHasChanged();

        selectedDetachment = await Data.GetDetachmentDetailsAsync(selectedDetachmentId);

        // Save to state
        ViewerState.SelectedFactionDetachmentId = selectedDetachmentId;
        ViewerState.SetDetachment(selectedDetachmentId);

        loadingDetachment = false;
        StateHasChanged();
    }
}
