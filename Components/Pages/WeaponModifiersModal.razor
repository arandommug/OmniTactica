@using OmniTactica.AppCode.Models.Core

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Weapon Modifiers: @Weapon.WeaponProfile?.Name</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">

                    <!-- Hit Modifiers -->
                    <div class="col-12">
                        <h6 class="border-bottom pb-2">Hit Roll Modifiers</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Hit Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.HitModifier" min="-3" max="3" />
                        <small class="text-muted">Positive values make hits easier</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Critical Hit Value:</label>
                        <input type="number" class="form-control" @bind="modifiers.CriticalHit" min="2" max="6" />
                        <small class="text-muted">Unmodified roll needed for critical hit</small>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.RerollHits" id="rerollHits" />
                            <label class="form-check-label" for="rerollHits">
                                Re-roll All Hits
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.RerollOnes" id="rerollOnes" />
                            <label class="form-check-label" for="rerollOnes">
                                Re-roll Hit 1s
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.Torrent" id="torrent" />
                            <label class="form-check-label" for="torrent">
                                Torrent (Auto-hit)
                            </label>
                        </div>
                    </div>

                    <!-- Wound Modifiers -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Wound Roll Modifiers</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Wound Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.WoundModifier" min="-3" max="3" />
                        <small class="text-muted">Positive values make wounds easier</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Critical Wound Value:</label>
                        <input type="number" class="form-control" @bind="modifiers.CriticalWound" min="2" max="6" />
                        <small class="text-muted">Unmodified roll needed for critical wound</small>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.RerollWounds" id="rerollWounds" />
                            <label class="form-check-label" for="rerollWounds">
                                Re-roll All Wounds
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.TwinLinked" id="twinLinked" />
                            <label class="form-check-label" for="twinLinked">
                                Twin-Linked (Re-roll Wounds)
                            </label>
                        </div>
                    </div>

                    <!-- Critical Effects -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Critical Effects</h6>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Sustained Hits:</label>
                        <input type="number" class="form-control" @bind="modifiers.SustainedHits" min="0" max="5" />
                        <small class="text-muted">Extra hits on critical</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Lethal Hits:</label>
                        <input type="number" class="form-control" @bind="modifiers.LethalHits" min="0" max="1" />
                        <small class="text-muted">Auto-wound on critical hit</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Devastating Wounds:</label>
                        <input type="number" class="form-control" @bind="modifiers.DevastatingWounds" min="0" max="1" />
                        <small class="text-muted">Mortal wounds on critical wound</small>
                    </div>

                    <!-- Damage & Penetration -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Damage & Penetration</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">AP Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.APModifier" min="-3" max="3" />
                        <small class="text-muted">Increases armor penetration (negative AP)</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Damage Modifier:</label>
                        <input type="number" class="form-control" @bind="modifiers.DamageModifier" min="-3" max="10" />
                        <small class="text-muted">Added to each damage roll</small>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.IgnoreInvulnerable" id="ignoreInvuln" />
                            <label class="form-check-label" for="ignoreInvuln">
                                Ignore Invulnerable Saves
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="modifiers.IgnoreCover" id="ignoreCover" />
                            <label class="form-check-label" for="ignoreCover">
                                Ignore Cover
                            </label>
                        </div>
                    </div>

                    <!-- Attacks -->
                    <div class="col-12 mt-3">
                        <h6 class="border-bottom pb-2">Attack Volume</h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Extra Attacks:</label>
                        <input type="number" class="form-control" @bind="modifiers.ExtraAttacks" min="0" max="20" />
                        <small class="text-muted">Additional attacks per model</small>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CombatWeapon Weapon { get; set; } = null!;
    [Parameter] public CombatUnit Unit { get; set; } = null!;
    [Parameter] public CombatModel Model { get; set; } = null!;
    [Parameter] public EventCallback<WeaponModifiers> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private WeaponModifiers modifiers = new();

    protected override void OnInitialized()
    {
        // Clone the current modifiers
        modifiers = new WeaponModifiers
        {
            HitModifier = Weapon.WeaponModifiers.HitModifier,
            WoundModifier = Weapon.WeaponModifiers.WoundModifier,
            APModifier = Weapon.WeaponModifiers.APModifier,
            DamageModifier = Weapon.WeaponModifiers.DamageModifier,
            ExtraAttacks = Weapon.WeaponModifiers.ExtraAttacks,
            RerollHits = Weapon.WeaponModifiers.RerollHits,
            RerollOnes = Weapon.WeaponModifiers.RerollOnes,
            RerollWounds = Weapon.WeaponModifiers.RerollWounds,
            SustainedHits = Weapon.WeaponModifiers.SustainedHits,
            LethalHits = Weapon.WeaponModifiers.LethalHits,
            DevastatingWounds = Weapon.WeaponModifiers.DevastatingWounds,
            CriticalHit = Weapon.WeaponModifiers.CriticalHit,
            CriticalWound = Weapon.WeaponModifiers.CriticalWound,
            IgnoreInvulnerable = Weapon.WeaponModifiers.IgnoreInvulnerable,
            IgnoreCover = Weapon.WeaponModifiers.IgnoreCover,
            TwinLinked = Weapon.WeaponModifiers.TwinLinked,
            Torrent = Weapon.WeaponModifiers.Torrent
        };
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync(modifiers);
    }
}
