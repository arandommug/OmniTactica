        loadoutEditorLoading = false;
        editingLoadoutUnitId = string.Empty;
        await JS.InvokeVoidAsync("unlockBodyScroll");
    }

    private async Task OpenPlayModeAsync()
    {
        playModeLoading = true;
        playModeOpen = true;
        StateHasChanged();

        foreach (var datasheetId in armyList.Units.Select(unit => unit.DatasheetId).Distinct())
        {
            await EnsureDatasheetDetailLoadedAsync(datasheetId);
        }

        if (armyList.DetachmentId.HasValue && !detachmentStratagems.Any())
        {
            await LoadEnhancementsAsync(armyList.DetachmentId.Value);
        }

        // Load core stratagems once for play mode (e.g., Command Re-roll)
        coreStratagems.Clear();
        try
        {
            await using var conn = DB.CreateConnection();
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = @"SELECT id, faction_id, name, type, cp_cost, legend, turn, phase, description, detachment, detachment_id FROM Stratagems WHERE (faction_id IS NULL OR faction_id = '') ORDER BY name";
            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                coreStratagems.Add(new Stratagem
                {
                    Id = reader.IsDBNull(0) ? 0 : reader.GetInt32(0),
                    FactionId = reader.IsDBNull(1) ? string.Empty : reader.GetString(1),
                    Name = reader.IsDBNull(2) ? string.Empty : reader.GetString(2),
                    Type = reader.IsDBNull(3) ? string.Empty : reader.GetString(3),
                    CpCost = reader.IsDBNull(4) ? string.Empty : reader.GetString(4),
                    Legend = reader.IsDBNull(5) ? string.Empty : reader.GetString(5),
                    Turn = reader.IsDBNull(6) ? string.Empty : reader.GetString(6),
                    Phase = reader.IsDBNull(7) ? string.Empty : reader.GetString(7),
                    Description = reader.IsDBNull(8) ? string.Empty : reader.GetString(8),
                    Detachment = reader.IsDBNull(9) ? string.Empty : reader.GetString(9),
                    DetachmentId = reader.IsDBNull(10) ? 0 : reader.GetInt32(10)
                });
            }
        }
        catch
        {
            // ignore DB errors; coreStratagems will remain empty
        }

        // Deduplicate core stratagems by Id
        coreStratagems = coreStratagems.DistinctBy(s => s.Id).ToList();

        // Load army rules (faction-level abilities)
        armyRules.Clear();
        if (!string.IsNullOrWhiteSpace(armyList.FactionId))
        {
            try
            {
                await using var armyConn = DB.CreateConnection();
                await armyConn.OpenAsync();
                using var armyCmd = armyConn.CreateCommand();
                armyCmd.CommandText = @"SELECT id, name, legend, faction_id, description FROM Abilities WHERE faction_id = @factionId ORDER BY name";
                var factionParam = armyCmd.CreateParameter();
                factionParam.ParameterName = "@factionId";
                factionParam.Value = armyList.FactionId;
                armyCmd.Parameters.Add(factionParam);
                await using var armyReader = await armyCmd.ExecuteReaderAsync();
                while (await armyReader.ReadAsync())
                {
                    armyRules.Add(new DetachmentAbility
                    {
                        Id = armyReader.IsDBNull(0) ? 0 : armyReader.GetInt32(0),
                        Name = armyReader.IsDBNull(1) ? string.Empty : armyReader.GetString(1),
                        Legend = armyReader.IsDBNull(2) ? string.Empty : armyReader.GetString(2),
                        FactionId = armyReader.IsDBNull(3) ? string.Empty : armyReader.GetString(3),
                        Description = armyReader.IsDBNull(4) ? string.Empty : armyReader.GetString(4)
                    });
                }
            }
            catch
            {
                // ignore DB errors
            }
        }

        // Initialize simple play-tracking state for units
        unitModelsRemaining.Clear();
        destroyedUnits.Clear();
        foreach (var unit in armyList.Units)
        {
            unitModelsRemaining[unit.Id] = unit.TotalModels > 0 ? unit.TotalModels : 0;
        }

        playModeLoading = false;
        playMobileTab = "units";
        await JS.InvokeVoidAsync("lockBodyScroll");
    }

    private async void ClosePlayMode()
    {
        playModeOpen = false;
        await JS.InvokeVoidAsync("unlockBodyScroll");
    }

    private IEnumerable<IGrouping<string, Stratagem>> GetSortedStratagemPhaseGroups()
        => detachmentStratagems
            .GroupBy(stratagem => string.IsNullOrWhiteSpace(stratagem.Phase) ? "Any phase" : stratagem.Phase)
            .OrderBy(group => GetPhaseSortOrder(group.Key))
            .ThenBy(group => group.Key);

    private IEnumerable<Stratagem> GetPhaseStratagems()
    {
        var phaseList = detachmentStratagems.Concat(coreStratagems ?? Enumerable.Empty<Stratagem>());
        return phaseList
            .Where(s => StratagemMatchesPhase(s.Phase, currentPhase))
            .DistinctBy(s => s.Id)
            .OrderBy(s => GetTurnSortOrder(s.Turn))
            .ThenBy(s => s.Name);
    }

    private static bool StratagemMatchesPhase(string? stratagemPhase, string currentPhase)
    {
        if (string.IsNullOrWhiteSpace(stratagemPhase))
        {
            return true;
        }

        if (stratagemPhase.Equals("Any phase", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // Handle compound phases like "Shooting or Fight phase"
        var parts = stratagemPhase.Split(" or ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var part in parts)
        {
            var normalized = part.EndsWith(" phase", StringComparison.OrdinalIgnoreCase) ? part : part + " phase";
            if (normalized.Equals(currentPhase, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private void IncreaseCP() => commandPoints++;
    private void DecreaseCP() { if (commandPoints > 0) commandPoints--; }
    private void SetPhase(string phase)
    {
        currentPhase = phase;
        StateHasChanged();
    }

    private int GetModelsRemaining(string unitId) => unitModelsRemaining.TryGetValue(unitId, out var v) ? v : 0;
    private void DecreaseModelsRemaining(string unitId)
    {
        if (!unitModelsRemaining.ContainsKey(unitId)) return;
        unitModelsRemaining[unitId] = Math.Max(0, unitModelsRemaining[unitId] - 1);
    }
    private void IncreaseModelsRemaining(string unitId)
    {
        if (!unitModelsRemaining.ContainsKey(unitId)) unitModelsRemaining[unitId] = 0;
        unitModelsRemaining[unitId]++;
    }

    private void ToggleDestroyed(string unitId)
    {
        if (destroyedUnits.Contains(unitId)) destroyedUnits.Remove(unitId);
        else destroyedUnits.Add(unitId);
    }

    private bool IsDestroyed(string unitId) => destroyedUnits.Contains(unitId);

    private static int GetPhaseSortOrder(string phase)
    {
        var normalized = phase.Trim();
        var orderedPhases = new[]
        {
            "Command phase",
            "Movement phase",
            "Shooting phase",
            "Charge phase",
            "Fight phase",
            "Any phase"
        };

        var index = Array.FindIndex(orderedPhases, existingPhase => existingPhase.Equals(normalized, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : orderedPhases.Length;
    }

    private static int GetTurnSortOrder(string? turn)
    {
        if (string.IsNullOrWhiteSpace(turn))
        {
            return 2;
        }

        return turn.Trim().ToLowerInvariant() switch
        {
            "your turn" => 0,
            "opponent's turn" => 1,
            _ => 2
        };
    }

    private static string FormatTurn(string? turn)
        => string.IsNullOrWhiteSpace(turn) ? "Any turn" : turn;

    private async Task ResetListAsync()
    {
        expandedUnits.Clear();
        unitSearch = string.Empty;
        selectedRole = string.Empty;
        playModeSearch = string.Empty;
        playModeRoleFilter = string.Empty;
        detachmentStratagems.Clear();
        datasheetDetailCache.Clear();
        pendingWeapons.Clear();
        collapsedRoleSections.Clear();
        CloseLoadoutEditor();
        await ArmyListService.ResetAsync();
        await SyncActiveListAsync();
        ApplyPanelDefaults(true);
    }

