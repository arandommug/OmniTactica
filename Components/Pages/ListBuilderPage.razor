    private static List<UnitConfigurationView> BuildLoadoutEditorConfigurations(DatasheetDetail datasheet)
    {
        var configurations = new List<UnitConfigurationView>();
        var compositionOptions = ParseLoadoutEditorCompositionOptions(datasheet.UnitComposition);
        var usedCompositionIndexes = new HashSet<int>();

        foreach (var cost in datasheet.Costs)
        {
            var description = NormalizeLoadoutEditorDisplayText(cost.Description);
            var matchingOption = FindMatchingLoadoutEditorCompositionOption(compositionOptions, usedCompositionIndexes, description);

            if (matchingOption != null)
            {
                usedCompositionIndexes.Add(matchingOption.Index);
                configurations.Add(new UnitConfigurationView(
                    matchingOption.DisplayText,
                    string.Equals(matchingOption.DisplayText, description, StringComparison.OrdinalIgnoreCase) ? string.Empty : description,
                    cost.Cost));
                continue;
            }

            configurations.Add(new UnitConfigurationView(
                string.IsNullOrWhiteSpace(description) ? "Configuration" : description,
                string.Empty,
                cost.Cost));
        }

        foreach (var option in compositionOptions.Where(option => !usedCompositionIndexes.Contains(option.Index)))
        {
            configurations.Add(new UnitConfigurationView(option.DisplayText, string.Empty, null));
        }

        return configurations;
    }

    private static List<LoadoutEditorCompositionOptionView> ParseLoadoutEditorCompositionOptions(IEnumerable<DatasheetUnitComposition> compositionEntries)
    {
        var options = new List<LoadoutEditorCompositionOptionView>();
        var currentEntries = new List<LoadoutEditorUnitCompositionEntry>();
        var currentDescriptions = new List<string>();
        var index = 0;

        foreach (var compositionEntry in compositionEntries)
        {
            var description = NormalizeLoadoutEditorDisplayText(compositionEntry.Description);
            if (string.IsNullOrWhiteSpace(description))
            {
                continue;
            }

            if (description.Equals("OR", StringComparison.OrdinalIgnoreCase))
            {
                AddLoadoutEditorCompositionOption(options, currentEntries, currentDescriptions, ref index);
                currentEntries = new List<LoadoutEditorUnitCompositionEntry>();
                currentDescriptions = new List<string>();
                continue;
            }

            currentDescriptions.Add(description);
            currentEntries.AddRange(ParseLoadoutEditorCompositionEntries(description));
        }

        AddLoadoutEditorCompositionOption(options, currentEntries, currentDescriptions, ref index);
        return options;
    }

    private static void AddLoadoutEditorCompositionOption(List<LoadoutEditorCompositionOptionView> options, List<LoadoutEditorUnitCompositionEntry> entries, List<string> descriptions, ref int index)
    {
        if (entries.Count == 0 && descriptions.Count == 0)
        {
            return;
        }

        var displayText = entries.Count > 0
            ? FormatLoadoutEditorComposition(entries)
            : string.Join(" \u2022 ", descriptions);

        options.Add(new LoadoutEditorCompositionOptionView(index++, entries, displayText));
    }

    private static LoadoutEditorCompositionOptionView? FindMatchingLoadoutEditorCompositionOption(IEnumerable<LoadoutEditorCompositionOptionView> options, HashSet<int> usedCompositionIndexes, string costDescription)
    {
        var availableOptions = options.Where(option => !usedCompositionIndexes.Contains(option.Index)).ToList();
        if (availableOptions.Count == 0)
        {
            return null;
        }

        var costEntries = ParseLoadoutEditorCostDescriptionEntries(costDescription);
        if (costEntries.Count > 0)
        {
            var exactMatch = availableOptions.FirstOrDefault(option => option.Entries.Count > 0 && MatchesLoadoutEditorCompositionOption(option.Entries, costEntries));
            if (exactMatch != null)
            {
                return exactMatch;
            }

            var targetTotal = costEntries.Sum(entry => entry.Quantity);
            var countMatch = availableOptions.FirstOrDefault(option => option.Entries.Count > 0 && option.Entries.Sum(entry => entry.Quantity) == targetTotal);
            if (countMatch != null)
            {
                return countMatch;
            }
        }

        return availableOptions.Count == 1 ? availableOptions[0] : null;
    }

    private static List<LoadoutEditorUnitCompositionEntry> ParseLoadoutEditorCompositionEntries(string description)
    {
        var matches = global::System.Text.RegularExpressions.Regex.Matches(description, @"(\d+)(?:-(\d+))?\s+(.+?)(?=(?:\s+and\s+\d)|$)", global::System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var entries = new List<LoadoutEditorUnitCompositionEntry>();

        foreach (global::System.Text.RegularExpressions.Match match in matches)
        {
            if (!match.Success)
            {
                continue;
            }

            var minQuantity = int.Parse(match.Groups[1].Value);
            var maxQuantity = match.Groups[2].Success ? int.Parse(match.Groups[2].Value) : minQuantity;
            var name = match.Groups[3].Value.Trim();
            entries.Add(new LoadoutEditorUnitCompositionEntry(name, minQuantity, maxQuantity));
        }

        return entries;
    }

    private static List<LoadoutEditorCostDescriptionEntry> ParseLoadoutEditorCostDescriptionEntries(string description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return [];
        }

        return description.Split(new[] { " and ", "," }, StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Trim())
            .Select(ParseLoadoutEditorCostDescriptionEntry)
            .Where(entry => entry != null)
            .Cast<LoadoutEditorCostDescriptionEntry>()
            .ToList();
    }

    private static LoadoutEditorCostDescriptionEntry? ParseLoadoutEditorCostDescriptionEntry(string text)
    {
        var match = global::System.Text.RegularExpressions.Regex.Match(text, @"^(\d+)\s+(.+)$", global::System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!match.Success)
        {
            return null;
        }

        var quantity = int.Parse(match.Groups[1].Value);
        var name = match.Groups[2].Value.Trim();
        var normalizedName = NormalizeLoadoutEditorName(name);

        return new LoadoutEditorCostDescriptionEntry(quantity, name, normalizedName is "model" or "models");
    }

    private static bool MatchesLoadoutEditorCompositionOption(IEnumerable<LoadoutEditorUnitCompositionEntry> option, IEnumerable<LoadoutEditorCostDescriptionEntry> costEntries)
    {
        var optionList = option.ToList();
        var costList = costEntries.ToList();

        if (costList.Count == 1 && costList[0].IsGenericModelCount)
        {
            return optionList.Sum(entry => entry.Quantity) == costList[0].Quantity;
        }

        if (optionList.Count != costList.Count)
        {
            return false;
        }

        foreach (var costEntry in costList)
        {
            var matchingEntry = optionList.FirstOrDefault(entry => LoadoutEditorNamesMatch(entry.Name, costEntry.Name));
            if (matchingEntry == null || matchingEntry.Quantity != costEntry.Quantity)
            {
                return false;
            }
        }

        return true;
    }

    private static string FormatLoadoutEditorComposition(IEnumerable<LoadoutEditorUnitCompositionEntry> entries)
        => string.Join(" and ", entries.Select(entry => $"{entry.Quantity} {entry.Name}"));

    private static bool LoadoutEditorNamesMatch(string modelName, string costName)
    {
        var normalizedModel = NormalizeLoadoutEditorName(modelName);
        var normalizedCost = NormalizeLoadoutEditorName(costName);

        return normalizedModel == normalizedCost
               || normalizedModel.Contains(normalizedCost, StringComparison.OrdinalIgnoreCase)
               || normalizedCost.Contains(normalizedModel, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeLoadoutEditorName(string value)
    {
        var normalizedWords = global::System.Text.RegularExpressions.Regex.Replace(value.ToLowerInvariant(), @"[^a-z0-9\s]", " ")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => word.Length > 3 && word.EndsWith('s') ? word[..^1] : word);

        return string.Join(' ', normalizedWords);
    }

    private static string NormalizeLoadoutEditorDisplayText(string? value)
        => string.IsNullOrWhiteSpace(value) ? string.Empty : global::OmniTactica.AppCode.Utilities.HtmlUtility.ConvertHtmlToPlainText(value).Trim();

    private async Task OpenLoadoutEditorAsync(string unitId)
    {
        var unit = armyList.Units.FirstOrDefault(existingUnit => existingUnit.Id == unitId);
        if (unit == null)
        {
            return;
        }

        editingLoadoutUnitId = unitId;
        initializedLoadoutEditorWeaponLayoutUnitId = string.Empty;
        loadoutEditorLoading = true;
        loadoutEditorOpen = true;
        await JS.InvokeVoidAsync("lockBodyScroll");
        StateHasChanged();

        await EnsureDatasheetDetailLoadedAsync(unit.DatasheetId);

        loadoutEditorLoading = false;
    }

    private async void CloseLoadoutEditor()
    {
        loadoutEditorOpen = false;
        loadoutEditorLoading = false;
        loadoutEditorStackWeaponAbilities = false;
        initializedLoadoutEditorWeaponLayoutUnitId = string.Empty;
        editingLoadoutUnitId = string.Empty;
        await JS.InvokeVoidAsync("weaponAbilityLayout.dispose", loadoutEditorWeaponLayoutContainerId);
        await JS.InvokeVoidAsync("unlockBodyScroll");
    }

    private void NavigateToPlayMode()
    {
        Navigation.NavigateTo($"/play-mode/{armyList.Id}");
    }

    private async Task ResetListAsync()
    {
        expandedUnits.Clear();
        unitSearch = string.Empty;
        selectedRole = string.Empty;
        detachmentStratagems.Clear();
        datasheetDetailCache.Clear();
        editingUnitNotes.Clear();
        unitNoteDrafts.Clear();
        pendingWeapons.Clear();
        collapsedRoleSections.Clear();
        CloseLoadoutEditor();
        await ArmyListService.ResetAsync();
        await SyncActiveListAsync();
        ApplyPanelDefaults(true);
    }

