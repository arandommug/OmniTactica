    private async Task ToggleUnitAsync(string unitId, int datasheetId)
    {
        if (!expandedUnits.Add(unitId))
        {
            expandedUnits.Remove(unitId);
            return;
        }

        await EnsureDatasheetDetailLoadedAsync(datasheetId);
    }

    private void NavigateToFactionRules()
    {
        if (string.IsNullOrWhiteSpace(armyList.FactionId))
        {
            return;
        }

        ViewerState.SetFactionContext(armyList.FactionId, armyList.DetachmentId);
        Navigation.NavigateTo($"/faction/{armyList.FactionId}");
    }

    private string FormatListOption(ArmyList list)
    {
        var factionPart = string.IsNullOrWhiteSpace(list.FactionName) ? "Unassigned" : list.FactionName;
        return $"{list.Name} — {factionPart} — {list.TotalPoints}/{list.PointsLimit} pts";
    }

    private static string GetRoleDisplay(string? role)
    {
        if (string.IsNullOrWhiteSpace(role))
        {
            return "Other Datasheets";
        }

        var normalizedRole = role.Trim().ToLowerInvariant();

        if (normalizedRole is "character" or "characters" or "epic hero")
        {
            return "Characters";
        }

        if (normalizedRole == "battleline")
        {
            return "Battleline";
        }

        if (normalizedRole is "dedicated transport" or "dedicated transports")
        {
            return "Dedicated Transports";
        }

        return "Other Datasheets";
    }

    private static int GetRoleSortOrder(string role)
    {
        var index = Array.FindIndex(PreferredRoleOrder, existingRole => existingRole.Equals(role, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : PreferredRoleOrder.Length;
    }

    private string ResolveSelectedRole(string? requestedRole)
    {
        var availableRoles = datasheets
            .Select(datasheet => GetRoleDisplay(datasheet.Role))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(role => GetRoleSortOrder(role))
            .ThenBy(role => role)
            .ToList();

        if (!availableRoles.Any())
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(requestedRole) && availableRoles.Contains(requestedRole, StringComparer.OrdinalIgnoreCase))
        {
            return requestedRole;
        }

        return string.Empty;
    }

    private void OpenRolePicker(string role)
    {
        selectedRole = role;
        unitSearch = string.Empty;
    }

    private void CloseRolePicker()
    {
        selectedRole = string.Empty;
        unitSearch = string.Empty;
    }

    private async Task AddUnitFromRolePickerAsync(Datasheet datasheet)
    {
        await AddUnitAsync(datasheet);
        CloseRolePicker();
    }

    private void ResetRoleSectionState()
    {
        selectedRole = string.Empty;
        unitSearch = string.Empty;
        collapsedRoleSections = RolePickerGroups
            .Where(group => !GetUnitsForRole(group.Role).Any())
            .Select(group => group.Role)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private bool IsRoleSectionExpanded(string role)
        => !collapsedRoleSections.Contains(role);

    private void ToggleRoleSection(string role)
    {
        if (!collapsedRoleSections.Add(role))
        {
            collapsedRoleSections.Remove(role);
            return;
        }

        if (string.Equals(selectedRole, role, StringComparison.OrdinalIgnoreCase))
        {
            CloseRolePicker();
        }
    }

    private void HandleRoleHeaderKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, string role)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            ToggleRoleSection(role);
        }
    }

    private Task HandleAddUnitCardKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, Datasheet datasheet)
        => args.Key is "Enter" or " " or "Spacebar"
            ? AddUnitFromRolePickerAsync(datasheet)
            : Task.CompletedTask;

    private void ToggleManageListPanel()
    {
        showManageListPanel = !showManageListPanel;
    }

    private void ApplyPanelDefaults(bool expandPanels)
    {
        showManageListPanel = expandPanels;
    }

    private static bool IsFreshList(ArmyList list)
        => string.IsNullOrWhiteSpace(list.FactionId)
            && !list.Units.Any()
            && string.IsNullOrWhiteSpace(list.DetachmentName)
            && list.TotalPoints == 0;

    private IEnumerable<ArmyListUnit> GetUnitsForRole(string role)
        => armyList.Units.Where(unit => string.Equals(GetRoleDisplay(unit.Role), role, StringComparison.OrdinalIgnoreCase));

    private int GetRosterUnitCount(int datasheetId)
        => armyList.Units.Count(unit => unit.DatasheetId == datasheetId);

    private string GetUnitSizeSummary(ArmyListUnit unit)
        => unit.TotalModels > 0
            ? $"{unit.TotalModels} model{(unit.TotalModels == 1 ? string.Empty : "s")} \u00B7 {unit.SelectedCostDescription}"
            : unit.SelectedCostDescription;

    private static string GetModelStatline(ArmyListUnitModel model)
        => $"M {model.M} \u00B7 T {model.T} \u00B7 Sv {FormatSave(model)} \u00B7 W {model.W} \u00B7 Ld {model.Ld} \u00B7 OC {model.OC}";

    private static string GetCompactWeaponProfile(ArmyListUnitWeapon weapon)
        => $"{weapon.Range} \u00B7 A {weapon.A} \u00B7 BS/WS {weapon.BsWs} \u00B7 S {weapon.S} \u00B7 AP {weapon.AP} \u00B7 D {weapon.D}";

    private static string FormatSave(ArmyListUnitModel model)
        => string.IsNullOrWhiteSpace(model.InvSv) || model.InvSv == "-"
            ? model.Sv
            : $"{model.Sv}/{model.InvSv}++";

    private async Task EnsureDatasheetDetailLoadedAsync(int datasheetId)
    {
        if (datasheetDetailCache.ContainsKey(datasheetId))
        {
            return;
        }

        var detail = await Data.GetDatasheetDetailAsync(datasheetId, armyList.DetachmentId);
        if (detail != null)
        {
            datasheetDetailCache[datasheetId] = detail;
        }
    }

