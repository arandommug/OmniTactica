                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                        <select class="form-select form-select-sm"
                                                style="min-width: 180px;"
                                                value="@GetPendingWeaponName(LoadoutEditorUnit.Id, model.Id)"
                                                @onchange="args => SetPendingWeapon(LoadoutEditorUnit.Id, model.Id, args.Value?.ToString())">
                                            <option value="">Add weapon...</option>
                                            @foreach (var weaponChoice in GetAvailableWeaponChoices(LoadoutEditorUnit))
                                            {
                                                <option value="@weaponChoice">@weaponChoice</option>
                                            }
                                        </select>
                                        <button class="btn btn-sm btn-outline-success"
                                                @onclick="() => AddWeaponToModelAsync(LoadoutEditorUnit, model)"
                                                disabled="@string.IsNullOrWhiteSpace(GetPendingWeaponName(LoadoutEditorUnit.Id, model.Id))">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                        <span class="small text-muted">@model.MinQuantity-@model.MaxQuantity</span>
                                        <div class="qty-stepper">
                                            <button type="button"
                                                    @onclick="() => ChangeModelQuantityAsync(LoadoutEditorUnit.Id, model, -1)"
                                                    disabled="@(model.Quantity <= model.MinQuantity)">
                                                <i class="fa fa-minus"></i>
                                            </button>
                                            <span class="value">@model.Quantity</span>
                                            <button type="button"
                                                    @onclick="() => ChangeModelQuantityAsync(LoadoutEditorUnit.Id, model, 1)"
                                                    disabled="@(model.Quantity >= model.MaxQuantity)">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                @if (model.Weapons.Any())
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var weapon in model.Weapons)
                                        {
                                            <div class="d-flex justify-content-between align-items-center gap-3 p-2 border rounded-3">
                                                <div class="min-w-0 flex-grow-1 d-flex flex-column gap-1">
                                                    <div class="fw-semibold">@weapon.Name</div>
                                                    <div class="small text-muted">@GetCompactWeaponProfile(weapon)</div>
                                                    @if (!string.IsNullOrWhiteSpace(weapon.Description))
                                                    {
                                                        <div class="small text-muted">@weapon.Description</div>
                                                    }
                                                </div>

                                                <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                                    <div class="form-check m-0">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@weapon.IsSelected"
                                                               @onchange="args => UpdateWeaponSelectedAsync(LoadoutEditorUnit.Id, model.Id, weapon.Id, args)" />
                                                        <label class="form-check-label small">Equipped</label>
                                                    </div>

                                                    <div class="qty-stepper">
                                                        <button type="button"
                                                                @onclick="() => ChangeWeaponQuantityAsync(LoadoutEditorUnit.Id, model.Id, weapon, -1)"
                                                                disabled="@(weapon.Quantity <= 1)">
                                                            <i class="fa fa-minus"></i>
                                                        </button>
                                                        <span class="value">@weapon.Quantity</span>
                                                        <button type="button"
                                                                @onclick="() => ChangeWeaponQuantityAsync(LoadoutEditorUnit.Id, model.Id, weapon, 1)">
                                                            <i class="fa fa-plus"></i>
                                                        </button>
                                                    </div>

                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => RemoveWeaponAsync(LoadoutEditorUnit.Id, model.Id, weapon.Id)">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fst-italic">No weapons configured yet.</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                </div>
            }
        </div>
    </div>
}

