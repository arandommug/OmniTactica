    }

    private async Task UpdateUnitNotesAsync(string unitId, string? notes)
    {
        await ArmyListService.SetUnitNotesAsync(unitId, notes);
        RefreshArmyListState();
    }

    private bool IsEnhancementAssignedElsewhere(ArmyListUnit unit, int enhancementId)
        => armyList.Units.Any(existingUnit => existingUnit.Id != unit.Id && existingUnit.EnhancementId == enhancementId);

    private async Task ToggleUnitAsync(string unitId, int datasheetId)
    {
        if (!expandedUnits.Add(unitId))
        {
            expandedUnits.Remove(unitId);
            return;
        }

        await EnsureDatasheetDetailLoadedAsync(datasheetId);
    }

    private Task ToggleUnit(string unitId)
    {
        var datasheetId = armyList.Units.FirstOrDefault(unit => unit.Id == unitId)?.DatasheetId ?? 0;
        return datasheetId > 0 ? ToggleUnitAsync(unitId, datasheetId) : Task.CompletedTask;
    }

    private string GetDatasheetRoute(ArmyListUnit unit)
        => string.IsNullOrWhiteSpace(armyList.FactionId)
            ? $"/unit/{unit.DatasheetId}"
            : $"/faction/{armyList.FactionId}/unit/{unit.DatasheetId}";

    private void NavigateToFactionRules()
    {
        if (string.IsNullOrWhiteSpace(armyList.FactionId))
        {
            return;
        }

        ViewerState.SetFactionContext(armyList.FactionId, armyList.DetachmentId);
        Navigation.NavigateTo($"/faction/{armyList.FactionId}");
    }

    private string FormatListOption(ArmyList list)
    {
        var factionPart = string.IsNullOrWhiteSpace(list.FactionName) ? "Unassigned" : list.FactionName;
        return $"{list.Name} — {factionPart} — {list.TotalPoints}/{list.PointsLimit} pts";
    }

    private static string GetRoleDisplay(string? role)
    {
        if (string.IsNullOrWhiteSpace(role))
        {
            return "Other Datasheets";
        }

        var normalizedRole = role.Trim().ToLowerInvariant();

        if (normalizedRole is "character" or "characters" or "epic hero")
        {
            return "Characters";
        }

        if (normalizedRole == "battleline")
        {
            return "Battleline";
        }

        if (normalizedRole is "dedicated transport" or "dedicated transports")
        {
            return "Dedicated Transports";
        }

        return "Other Datasheets";
    }

    private static int GetRoleSortOrder(string role)
    {
        var index = Array.FindIndex(PreferredRoleOrder, existingRole => existingRole.Equals(role, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : PreferredRoleOrder.Length;
    }

    private string ResolveSelectedRole(string? requestedRole)
    {
        var availableRoles = datasheets
            .Select(datasheet => GetRoleDisplay(datasheet.Role))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(role => GetRoleSortOrder(role))
            .ThenBy(role => role)
            .ToList();

        if (!availableRoles.Any())
        {
            return string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(requestedRole) && availableRoles.Contains(requestedRole, StringComparer.OrdinalIgnoreCase))
        {
            return requestedRole;
        }

        return string.Empty;
    }

    private void SelectRole(string role)
    {
        if (!string.Equals(selectedRole, role, StringComparison.OrdinalIgnoreCase))
        {
            unitSearch = string.Empty;
        }

        collapsedRoleSections.Remove(role);

        selectedRole = string.Equals(selectedRole, role, StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : role;
    }

    private void CloseRolePicker()
    {
        selectedRole = string.Empty;
        unitSearch = string.Empty;
    }

    private bool IsRoleSectionExpanded(string role)
        => !collapsedRoleSections.Contains(role);

    private void ToggleRoleSection(string role)
    {
        if (!collapsedRoleSections.Add(role))
        {
            collapsedRoleSections.Remove(role);
            return;
        }

        if (string.Equals(selectedRole, role, StringComparison.OrdinalIgnoreCase))
        {
            CloseRolePicker();
        }
    }

    private void ToggleSavedListsPanel()
    {
        showSavedListsPanel = !showSavedListsPanel;
    }

    private void ToggleArmySetupPanel()
    {
        showArmySetupPanel = !showArmySetupPanel;
    }

    private void ApplyPanelDefaults(bool expandPanels)
    {
        showSavedListsPanel = expandPanels;
        showArmySetupPanel = expandPanels;
    }

    private static bool IsFreshList(ArmyList list)
        => string.IsNullOrWhiteSpace(list.FactionId)
            && !list.Units.Any()
            && string.IsNullOrWhiteSpace(list.DetachmentName)
            && list.TotalPoints == 0;

    private IEnumerable<ArmyListUnit> GetUnitsForRole(string role)
        => armyList.Units.Where(unit => string.Equals(GetRoleDisplay(unit.Role), role, StringComparison.OrdinalIgnoreCase));

    private string GetUnitSizeSummary(ArmyListUnit unit)
        => unit.TotalModels > 0
            ? $"{unit.TotalModels} model{(unit.TotalModels == 1 ? string.Empty : "s")} · {unit.SelectedCostDescription}"
            : unit.SelectedCostDescription;

    private string GetUnitSizeHint(ArmyListUnit unit)
    {
        if (!unit.Models.Any() || string.IsNullOrWhiteSpace(unit.SelectedCostDescription))
        {
            return string.Empty;
        }

        return unit.SelectedCostDescription.Contains(unit.TotalModels.ToString(), StringComparison.OrdinalIgnoreCase)
            ? "Points match current model count"
            : "Check the selected points bracket";
    }

    private static string GetModelStatline(ArmyListUnitModel model)
        => $"M {model.M} · T {model.T} · Sv {FormatSave(model)} · W {model.W} · Ld {model.Ld} · OC {model.OC}";

    private static string GetWeaponProfile(ArmyListUnitWeapon weapon)
        => $"{weapon.Type} · Range {weapon.Range} · A {weapon.A} · BS/WS {weapon.BsWs} · S {weapon.S} · AP {weapon.AP} · D {weapon.D}";

    private static string GetCompactWeaponProfile(ArmyListUnitWeapon weapon)
        => $"{weapon.Range} · A {weapon.A} · BS/WS {weapon.BsWs} · S {weapon.S} · AP {weapon.AP} · D {weapon.D}";

    private static string FormatSave(ArmyListUnitModel model)
        => string.IsNullOrWhiteSpace(model.InvSv) || model.InvSv == "-"
            ? model.Sv
            : $"{model.Sv}/{model.InvSv}++";

    private async Task EnsureDatasheetDetailLoadedAsync(int datasheetId)
    {
        if (datasheetDetailCache.ContainsKey(datasheetId))
        {
            return;
        }

        var detail = await Data.GetDatasheetDetailAsync(datasheetId, armyList.DetachmentId);
        if (detail != null)
        {
            datasheetDetailCache[datasheetId] = detail;
        }
    }

    private DatasheetDetail? GetDatasheetDetail(int datasheetId)
        => datasheetDetailCache.TryGetValue(datasheetId, out var detail) ? detail : null;

    private IEnumerable<string> GetAvailableWeaponChoices(ArmyListUnit unit)
        => GetDatasheetDetail(unit.DatasheetId)?.Wargear
               .Select(wargear => wargear.Name)
               .Distinct(StringComparer.OrdinalIgnoreCase)
               .OrderBy(name => name)
           ?? Enumerable.Empty<string>();

    private string GetPendingWeaponKey(string unitId, string modelId)
        => $"{unitId}:{modelId}";

    private string GetPendingWeaponName(string unitId, string modelId)
        => pendingWeapons.TryGetValue(GetPendingWeaponKey(unitId, modelId), out var value) ? value : string.Empty;

    private void SetPendingWeapon(string unitId, string modelId, string? weaponName)
    {
        pendingWeapons[GetPendingWeaponKey(unitId, modelId)] = weaponName ?? string.Empty;
    }

    private IEnumerable<EquippedWeaponView> GetEquippedWeapons(ArmyListUnit unit)
        => unit.Models
            .SelectMany(model => model.Weapons
                .Where(weapon => weapon.IsSelected)
                .Select(weapon => new EquippedWeaponView(
                    model.Name,
                    weapon.Name,
                    weapon.Quantity,
                    weapon.Range,
                    weapon.A,
                    weapon.BsWs,
                    weapon.S,
                    weapon.AP,
                    weapon.D,
                    weapon.Description)));

    private IEnumerable<string> GetLoadoutSummary(ArmyListUnit unit)
    {
        return unit.Models
            .SelectMany(model => model.Weapons)
            .Where(weapon => weapon.IsSelected)
            .GroupBy(weapon => weapon.Name, StringComparer.OrdinalIgnoreCase)
            .Select(group => $"{group.Sum(weapon => weapon.Quantity)}x {group.First().Name}");
    }

    private Enhancement? GetSelectedEnhancement(ArmyListUnit unit)
        => unit.EnhancementId.HasValue
            ? availableEnhancements.FirstOrDefault(enhancement => enhancement.Id == unit.EnhancementId.Value)
              ?? new Enhancement
              {
                  Id = unit.EnhancementId.Value,
                  Name = unit.EnhancementName,
                  Cost = unit.EnhancementCost
              }
            : null;

    private ArmyListUnit? EditingLoadoutUnit
        => armyList.Units.FirstOrDefault(unit => unit.Id == editingLoadoutUnitId);

    private ArmyListUnit? LoadoutEditorUnit => EditingLoadoutUnit;

    private DatasheetDetail? LoadoutEditorDetail
        => LoadoutEditorUnit == null ? null : GetDatasheetDetail(LoadoutEditorUnit.DatasheetId);

    private List<DatasheetWargear> LoadoutEditorRangedWeapons
        => LoadoutEditorDetail?.Wargear.Where(wargear => wargear.Type == "Ranged").ToList() ?? new List<DatasheetWargear>();

    private List<DatasheetWargear> LoadoutEditorMeleeWeapons
        => LoadoutEditorDetail?.Wargear.Where(wargear => wargear.Type == "Melee").ToList() ?? new List<DatasheetWargear>();

    private async Task OpenLoadoutEditorAsync(string unitId)
    {
        var unit = armyList.Units.FirstOrDefault(existingUnit => existingUnit.Id == unitId);
        if (unit == null)
        {
            return;
        }

        editingLoadoutUnitId = unitId;
        loadoutEditorLoading = true;
        loadoutEditorOpen = true;
        StateHasChanged();

        await EnsureDatasheetDetailLoadedAsync(unit.DatasheetId);

        loadoutEditorLoading = false;
    }

    private void CloseLoadoutEditor()
    {
        loadoutEditorOpen = false;
        loadoutEditorLoading = false;
        editingLoadoutUnitId = string.Empty;
    }

    private async Task OpenPlayModeAsync()
    {
        playModeLoading = true;
        playModeOpen = true;
        StateHasChanged();

        foreach (var datasheetId in armyList.Units.Select(unit => unit.DatasheetId).Distinct())
        {
            await EnsureDatasheetDetailLoadedAsync(datasheetId);
        }

        if (armyList.DetachmentId.HasValue && !detachmentStratagems.Any())
        {
            await LoadEnhancementsAsync(armyList.DetachmentId.Value);
        }

        playModeLoading = false;
    }

    private void ClosePlayMode()
    {
        playModeOpen = false;
    }

    private IEnumerable<IGrouping<string, Stratagem>> GetSortedStratagemPhaseGroups()
        => detachmentStratagems
            .GroupBy(stratagem => string.IsNullOrWhiteSpace(stratagem.Phase) ? "Any phase" : stratagem.Phase)
            .OrderBy(group => GetPhaseSortOrder(group.Key))
            .ThenBy(group => group.Key);

    private static int GetPhaseSortOrder(string phase)
    {
        var normalized = phase.Trim();
        var orderedPhases = new[]
        {
            "Command phase",
            "Movement phase",
            "Shooting phase",
            "Charge phase",
            "Fight phase",
            "Any phase"
        };

        var index = Array.FindIndex(orderedPhases, existingPhase => existingPhase.Equals(normalized, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : orderedPhases.Length;
    }

    private static int GetTurnSortOrder(string? turn)
    {
        if (string.IsNullOrWhiteSpace(turn))
        {
            return 2;
        }

        return turn.Trim().ToLowerInvariant() switch
        {
            "your turn" => 0,
            "opponent's turn" => 1,
            _ => 2
        };
    }

    private static string FormatTurn(string? turn)
        => string.IsNullOrWhiteSpace(turn) ? "Any turn" : turn;

    private async Task ResetListAsync()
    {
        expandedUnits.Clear();
        unitSearch = string.Empty;
        selectedRole = string.Empty;
        playModeSearch = string.Empty;
        playModeRoleFilter = string.Empty;
        detachmentStratagems.Clear();
        datasheetDetailCache.Clear();
        pendingWeapons.Clear();
        collapsedRoleSections.Clear();
        CloseLoadoutEditor();
        await ArmyListService.ResetAsync();
        await SyncActiveListAsync();
        ApplyPanelDefaults(true);
    }

    public void Dispose()
    {
        ArmyListService.OnListChanged -= HandleArmyListChanged;
    }

