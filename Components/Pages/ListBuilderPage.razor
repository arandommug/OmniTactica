    public void Dispose()
    {
        ArmyListService.OnListChanged -= HandleArmyListChanged;
        try
        {
            _ = JS.InvokeVoidAsync("weaponAbilityLayout.dispose", loadoutEditorWeaponLayoutContainerId);
        }
        catch
        {
        }

        loadoutEditorDotNetRef?.Dispose();
    }

