    protected override async Task OnInitializedAsync()
    {
        RefreshArmyListState();
        ApplyPanelDefaults(IsFreshList(armyList));
        ArmyListService.OnListChanged += HandleArmyListChanged;

        if (!DB.DatabaseExists)
        {
            loading = false;
            initialized = true;
            return;
        }

        factions = await Data.GetAllFactionsAsync();
        selectedFactionId = armyList.FactionId;
        selectedDetachmentId = armyList.DetachmentId?.ToString() ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(selectedFactionId))
        {
            await LoadFactionDataAsync(selectedFactionId);
            ResetRoleSectionState();
        }

        if (!string.IsNullOrWhiteSpace(FactionId) && !string.Equals(FactionId, selectedFactionId, StringComparison.OrdinalIgnoreCase))
        {
            await SelectFactionAsync(FactionId);
        }

        loading = false;
        initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!initialized || string.IsNullOrWhiteSpace(FactionId) || !DB.DatabaseExists)
        {
            return;
        }

        if (!string.Equals(FactionId, armyList.FactionId, StringComparison.OrdinalIgnoreCase))
        {
            await SelectFactionAsync(FactionId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loadoutEditorOpen || loadoutEditorLoading || LoadoutEditorDetail == null)
        {
            return;
        }

        if (string.Equals(initializedLoadoutEditorWeaponLayoutUnitId, editingLoadoutUnitId, StringComparison.Ordinal))
        {
            return;
        }

        loadoutEditorDotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("weaponAbilityLayout.init", loadoutEditorWeaponLayoutContainerId, loadoutEditorDotNetRef);
        initializedLoadoutEditorWeaponLayoutUnitId = editingLoadoutUnitId;
    }

    private void HandleArmyListChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshArmyListState();
            StateHasChanged();
        });
    }

    private void RefreshArmyListState()
    {
        armyList = ArmyListService.GetArmyList();
        armyLists = ArmyListService.GetArmyLists();
        activeListId = armyList.Id;
        selectedFactionId = armyList.FactionId;
        selectedDetachmentId = armyList.DetachmentId?.ToString() ?? string.Empty;
    }

    private async Task HandleListNameChanged(ChangeEventArgs args)
    {
        await ArmyListService.SetListNameAsync(args.Value?.ToString());
    }

    private async Task HandlePointsLimitChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pointsLimit))
        {
            await ArmyListService.SetPointsLimitAsync(pointsLimit);
        }
    }

    private async Task HandleActiveListChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(activeListId))
        {
            return;
        }

        await ArmyListService.SetActiveListAsync(activeListId);
        expandedUnits.Clear();
        await SyncActiveListAsync();
        ApplyPanelDefaults(IsFreshList(armyList));
    }

    private async Task CreateNewListAsync()
    {
        await ArmyListService.CreateListAsync();
        expandedUnits.Clear();
        await SyncActiveListAsync();
        ApplyPanelDefaults(true);
    }

    private async Task DuplicateActiveListAsync()
    {
        await ArmyListService.DuplicateActiveListAsync();
        expandedUnits.Clear();
        await SyncActiveListAsync();
        ApplyPanelDefaults(false);
    }

    private async Task DeleteActiveListAsync()
    {
        await ArmyListService.DeleteActiveListAsync();
        expandedUnits.Clear();
        await SyncActiveListAsync();
        ApplyPanelDefaults(IsFreshList(armyList));
    }

    private async Task HandleFactionChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedFactionId))
        {
            await ResetListAsync();
            return;
        }

        await SelectFactionAsync(selectedFactionId);
    }

    private async Task SyncActiveListAsync()
    {
        RefreshArmyListState();

        if (string.IsNullOrWhiteSpace(armyList.FactionId))
        {
            detachments.Clear();
            datasheets.Clear();
            availableEnhancements.Clear();
            detachmentStratagems.Clear();
            datasheetDetailCache.Clear();
            editingUnitNotes.Clear();
            unitNoteDrafts.Clear();
            unitSearch = string.Empty;
            selectedRole = string.Empty;
            editingLoadoutUnitId = string.Empty;
            loadoutEditorOpen = false;
            collapsedRoleSections.Clear();
            Navigation.NavigateTo("/list-builder", false);
            StateHasChanged();
            return;
        }

        await LoadFactionDataAsync(armyList.FactionId);
        ResetRoleSectionState();
        Navigation.NavigateTo($"/list-builder/{armyList.FactionId}", false);
        StateHasChanged();
    }

    private async Task SelectFactionAsync(string factionId)
    {
        loading = true;
        StateHasChanged();

        var faction = factions.FirstOrDefault(existingFaction => existingFaction.Id == factionId);
        if (faction == null)
        {
            loading = false;
            return;
        }

        await ArmyListService.SetFactionAsync(faction.Id, faction.Name);
        RefreshArmyListState();
        selectedFactionId = faction.Id;
        selectedDetachmentId = string.Empty;
        unitSearch = string.Empty;
        selectedRole = string.Empty;
        detachmentStratagems.Clear();
        datasheetDetailCache.Clear();
        editingUnitNotes.Clear();
        unitNoteDrafts.Clear();
        pendingWeapons.Clear();
        expandedUnits.Clear();
        collapsedRoleSections.Clear();
        editingLoadoutUnitId = string.Empty;
        loadoutEditorOpen = false;
        await LoadFactionDataAsync(faction.Id);
        ResetRoleSectionState();
        Navigation.NavigateTo($"/list-builder/{faction.Id}", false);
        loading = false;
    }

    private async Task LoadFactionDataAsync(string factionId)
    {
        var detachmentsTask = Data.GetDetachmentsByFactionAsync(factionId);
        var datasheetsTask = Data.GetDatasheetsByFactionAsync(factionId);
        await Task.WhenAll(detachmentsTask, datasheetsTask);

        detachments = detachmentsTask.Result;
        datasheets = datasheetsTask.Result;
        selectedRole = ResolveSelectedRole(selectedRole);
        collapsedRoleSections.RemoveWhere(role => !RolePickerGroups.Any(group => group.Role.Equals(role, StringComparison.OrdinalIgnoreCase)));

        if (armyList.DetachmentId.HasValue && detachments.Any(detachment => detachment.Id == armyList.DetachmentId.Value))
        {
            selectedDetachmentId = armyList.DetachmentId.Value.ToString();
            await LoadEnhancementsAsync(armyList.DetachmentId.Value);
        }
        else
        {
            selectedDetachmentId = string.Empty;
            availableEnhancements.Clear();
            await ArmyListService.SetDetachmentAsync(null, null);
        }
    }

    private async Task HandleDetachmentChangedAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDetachmentId))
        {
            availableEnhancements.Clear();
            detachmentStratagems.Clear();
            datasheetDetailCache.Clear();
            await ArmyListService.SetDetachmentAsync(null, null);
            RefreshArmyListState();
            return;
        }

        if (!int.TryParse(selectedDetachmentId, out var detachmentId))
        {
            return;
        }

        var detachment = detachments.FirstOrDefault(existingDetachment => existingDetachment.Id == detachmentId);
        await LoadEnhancementsAsync(detachmentId);
        await ArmyListService.SetDetachmentAsync(detachmentId, detachment?.Name, availableEnhancements);
        datasheetDetailCache.Clear();
        RefreshArmyListState();
    }

    private async Task LoadEnhancementsAsync(int detachmentId)
    {
        var detachment = await Data.GetDetachmentDetailsAsync(detachmentId);
        availableEnhancements = detachment?.Enhancements
            .OrderBy(enhancement => enhancement.Name)
            .ToList() ?? [];
        detachmentStratagems = detachment?.Stratagems
            .DistinctBy(s => s.Name)
            .ToList() ?? [];
    }

    private async Task AddUnitAsync(Datasheet datasheet)
    {
        await ArmyListService.AddUnitAsync(datasheet, armyList.DetachmentId);
        await EnsureDatasheetDetailLoadedAsync(datasheet.Id);
        RefreshArmyListState();
    }

    private async Task DuplicateUnitAsync(string unitId)
    {
        await ArmyListService.DuplicateUnitAsync(unitId);
        RefreshArmyListState();
    }

    private async Task RemoveUnitAsync(string unitId)
    {
        expandedUnits.Remove(unitId);
        editingUnitNotes.Remove(unitId);
        unitNoteDrafts.Remove(unitId);
        await ArmyListService.RemoveUnitAsync(unitId);
        if (editingLoadoutUnitId == unitId)
        {
            CloseLoadoutEditor();
        }
        RefreshArmyListState();
    }

    private async Task ChangeModelQuantityAsync(string unitId, ArmyListUnitModel model, int delta)
    {
        await ArmyListService.SetModelQuantityAsync(unitId, model.Id, model.Quantity + delta);
        RefreshArmyListState();
    }

    private async Task AddWeaponToModelAsync(ArmyListUnit unit, ArmyListUnitModel model)
    {
        var weaponName = GetPendingWeaponName(unit.Id, model.Id);
        if (string.IsNullOrWhiteSpace(weaponName))
        {
            return;
        }

        await ArmyListService.AddWeaponAsync(unit.Id, model.Id, weaponName);
        pendingWeapons[GetPendingWeaponKey(unit.Id, model.Id)] = string.Empty;
        RefreshArmyListState();
    }

    private async Task RemoveWeaponAsync(string unitId, string modelId, string weaponId)
    {
        await ArmyListService.RemoveWeaponAsync(unitId, modelId, weaponId);
        RefreshArmyListState();
    }

    private async Task ChangeWeaponQuantityAsync(string unitId, string modelId, ArmyListUnitWeapon weapon, int delta)
    {
        await ArmyListService.SetWeaponQuantityAsync(unitId, modelId, weapon.Id, weapon.Quantity + delta);
        RefreshArmyListState();
    }

    private async Task UpdateWeaponSelectedAsync(string unitId, string modelId, string weaponId, ChangeEventArgs args)
    {
        var isSelected = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        await ArmyListService.SetWeaponSelectedAsync(unitId, modelId, weaponId, isSelected);
        RefreshArmyListState();
    }

    private async Task UpdateUnitCostAsync(string unitId, string? selectedCostLine)
    {
        if (int.TryParse(selectedCostLine, out var costLine))
        {
            await ArmyListService.SetUnitCostAsync(unitId, costLine);
            RefreshArmyListState();
        }
    }

    private async Task UpdateUnitEnhancementAsync(ArmyListUnit unit, string? enhancementValue)
    {
        if (!unit.CanTakeEnhancement)
        {
            await ArmyListService.SetUnitEnhancementAsync(unit.Id, null);
            RefreshArmyListState();
            return;
        }

        Enhancement? enhancement = null;
        if (int.TryParse(enhancementValue, out var enhancementId))
        {
            enhancement = availableEnhancements.FirstOrDefault(existingEnhancement => existingEnhancement.Id == enhancementId);
        }

        await ArmyListService.SetUnitEnhancementAsync(unit.Id, enhancement);
        RefreshArmyListState();
    }

    private async Task UpdateUnitNotesAsync(string unitId, string? notes)
    {
        await ArmyListService.SetUnitNotesAsync(unitId, notes);
        RefreshArmyListState();
    }

    private bool IsEditingUnitNotes(string unitId)
        => editingUnitNotes.Contains(unitId);

    private string GetUnitNotesDraft(ArmyListUnit unit)
        => unitNoteDrafts.TryGetValue(unit.Id, out var draft) ? draft : unit.Notes ?? string.Empty;

    private string GetUnitNotesDisplayText(ArmyListUnit unit)
    {
        var notes = GetUnitNotesDraft(unit);
        return string.IsNullOrWhiteSpace(notes) ? "None" : notes;
    }

    private void SetUnitNotesDraft(string unitId, string? notes)
    {
        unitNoteDrafts[unitId] = notes ?? string.Empty;
    }

    private void ToggleUnitNotesEditor(ArmyListUnit unit)
    {
        if (!editingUnitNotes.Add(unit.Id))
        {
