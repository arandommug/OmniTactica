    private const string LoadoutFortificationAbilityType = "Fortification (Ð»ÐµÐ²Ð°Ñ ÐºÐ¾Ð»Ð¾Ð½ÐºÐ°)";
    private const string LoadoutSpecialAbilityType = "Special (Ð¿Ñ€Ð°Ð²Ð°Ñ ÐºÐ¾Ð»Ð¾Ð½ÐºÐ°)";

    private static readonly HashSet<string> ExpandedLoadoutAbilityTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "Datasheet",
