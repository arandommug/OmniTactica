@page "/list-builder"
@page "/list-builder/{FactionId}"
@using OmniTactica.AppCode.Data.Database
@using OmniTactica.AppCode.Data.Import
@using OmniTactica.AppCode.Helpers
@using OmniTactica.AppCode.Models.Core
@using OmniTactica.AppCode.Models.Rules
@using OmniTactica.AppCode.Services
@using OmniTactica.AppCode.Utilities

@inject WahaSQLiteService DB
@inject WahaDataService Data
@inject ArmyListService ArmyListService
@inject FactionViewerState ViewerState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<style>
    .unit-browser-list {
        max-height: 60vh;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .unit-browser-list > * {
        content-visibility: auto;
        contain: layout paint style;
    }

    .qty-stepper {
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 999px;
        overflow: hidden;
    }

    .qty-stepper button {
        border: 0;
        background: transparent;
        width: 2rem;
        height: 2rem;
    }

    .qty-stepper .value {
        min-width: 2rem;
        text-align: center;
        font-weight: 600;
    }

    .fullscreen-overlay.modal-fullscreen {
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        overflow-x: hidden;
        padding-bottom: var(--app-bottom-height);
    }

    .fullscreen-overlay.modal-fullscreen .modal-body,
    .loadout-editor-body {
        flex: 1 1 auto;
        overflow: visible;
        min-height: 0;
        padding-bottom: calc(var(--app-bottom-height) + 1.5rem);
    }

    .loadout-editor-shell {
        height: auto;
        overflow: visible;
        min-height: 0;
    }

    .loadout-editor-shell > [class*='col-'] {
        min-height: 0;
    }

    .loadout-editor-panel,
    .loadout-editor-panel-right {
        max-height: none;
        overflow: visible;
        min-height: 0;
    }

    .loadout-editor-panel {
        padding-right: 0.5rem;
    }


    .roster-unit-card {
        transition: transform 0.08s ease, box-shadow 0.12s ease, border-color 0.12s ease, background 0.12s ease;
        overflow: visible;
        position: relative;
        z-index: 0;
        contain: none !important;
    }

    .roster-unit-card:hover,
    .roster-unit-card:focus-within {
        box-shadow: 0 0.5rem 1.25rem rgba(0,0,0,0.16);
        transform: scale(1.002) !important;
        z-index: 30;
    }

    .roster-unit-card .card-header,
    .roster-unit-card .card-body {
        overflow: visible;
    }

    .roster-unit-card .clickable-card:hover,
    .roster-unit-card .clickable-card:focus-within {
        box-shadow: none;
        transform: none !important;
    }

    .roster-unit-actions {
        margin-right: -0.35rem;
    }

    .roster-unit-actions .dropdown-menu {
        z-index: 1100;
    }

    .roster-unit-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        min-height: 1.5rem;
        padding: 0;
        color: var(--bs-light);
        background: transparent;
        border: 0;
        box-shadow: none;
    }

    .roster-unit-action-button:hover,
    .roster-unit-action-button:focus,
    .roster-unit-action-button.show {
        color: var(--bs-light);
        background: rgba(255, 255, 255, 0.08);
    }

    .unit-click-indicator {
        position: absolute;
        left: 50%;
        bottom: 0.3rem;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: auto;
        min-width: max-content;
        color: rgba(var(--bs-secondary-rgb), 0.9);
        gap: 0.05rem;
        font-size: 0.95rem;
        line-height: 1;
        pointer-events: none;
    }

    .fullscreen-overlay {
        position: fixed;
        inset: 0;
        z-index: 1250;
        background: var(--bs-body-bg);
        overflow-y: auto;
    }

    .fullscreen-toolbar {
        position: sticky;
        top: 0;
        z-index: 5;
        padding-top: env(safe-area-inset-top, 0px);
        backdrop-filter: blur(12px);
        background: rgba(var(--bs-body-bg-rgb), 0.94);
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .reference-panel {
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0.85rem;
        padding: 1rem;
        background: rgba(var(--bs-primary-rgb), 0.03);
    }

    .list-builder-toolbar {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
        background: rgba(var(--bs-body-bg-rgb), 0.94);
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        padding-top: 0;
    }

    @@media (max-width: 991.98px) {
        .unit-browser-list {
            max-height: none;
        }

        .sticky-play-panel {
            position: static;
        }
    }

    @@media (max-width: 640px) {
        .fullscreen-toolbar {
            backdrop-filter: none;
        }

        .list-builder-toolbar {
            padding-top: 1.5rem;
        }

        .fullscreen-overlay.modal-fullscreen {
            overflow-y: auto;
            padding-bottom: calc(var(--app-bottom-height) + 1rem);
        }

        .fullscreen-overlay.modal-fullscreen .modal-body,
        .loadout-editor-body {
            overflow: visible;
            padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem) !important;
        }

        .loadout-editor-shell {
            height: auto;
            overflow: visible;
        }

        .loadout-editor-panel,
        .loadout-editor-panel-right {
            max-height: none;
            overflow: visible;
            padding-right: 0;
        }

        .reference-panel,
        .loadout-model-card {
            overflow-x: hidden;
        }
    }
</style>

<div class="list-builder-toolbar">
    <div class="d-flex justify-content-between align-items-center gap-2 px-3 py-2">
        <div class="fw-semibold text-truncate">@armyList.Name</div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(armyList.RemainingPoints < 0 ? "bg-danger" : "bg-success") fs-6">
                @armyList.TotalPoints / @armyList.PointsLimit pts
            </span>
            <button class="btn btn-sm btn-outline-primary" @onclick="NavigateToPlayMode" disabled="@(loading || !armyList.Units.Any())">
                <i class="fa fa-display me-1"></i>Play
            </button>
        </div>
    </div>
</div>

<div class="p-2 pb-4">

    @if (!DB.DatabaseExists)
    {
        <div class="alert alert-warning">
            Database not installed. Go to Settings to download data before building a list.
        </div>
    }
    else if (loading)
    {
        <div class="d-flex align-items-center py-4">
            <div class="spinner-border text-primary me-2" role="status"></div>
            <div>Loading army builder data...</div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            <div class="card">
                <div class="card-header py-0">
                    <button type="button" class="btn btn-link w-100 d-flex justify-content-between align-items-center gap-3 text-start text-decoration-none text-body p-0" @onclick="ToggleManageListPanel">
                        <span class="fw-semibold text-body">Manage List(s)</span>
                        <i class="fa @(showManageListPanel ? "fa-chevron-up" : "fa-chevron-down")"></i>
                    </button>
                </div>
                @if (showManageListPanel)
                {
                    <div class="card-body d-flex flex-column gap-3">
                        <div>
                            <label class="form-label">Active list</label>
                            <select class="form-select" @bind="activeListId" @bind:after="HandleActiveListChangedAsync">
                                @foreach (var list in armyLists)
                                {
                                    <option value="@list.Id">@FormatListOption(list)</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-primary flex-fill" @onclick="CreateNewListAsync">
                                <i class="fa fa-plus me-1"></i>New
                            </button>
                            <button class="btn btn-outline-secondary flex-fill" @onclick="DuplicateActiveListAsync">
                                <i class="fa fa-copy me-1"></i>Duplicate
                            </button>
                            <button class="btn btn-outline-danger flex-fill" @onclick="DeleteActiveListAsync" disabled="@(armyLists.Count <= 1)">
                                <i class="fa fa-trash me-1"></i>Delete
                            </button>
                        </div>

                        <div class="small text-muted">
                            Last updated @armyList.UpdatedUtc.ToLocalTime().ToString("g")
                        </div>

                        <hr class="my-1" />

                        <div>
                            <label class="form-label">List name</label>
                            <input class="form-control"
                                   value="@armyList.Name"
                                   @onchange="HandleListNameChanged" />
                        </div>

                        <div>
                            <label class="form-label">Points limit</label>
                            <input class="form-control"
                                   type="number"
                                   min="500"
                                   step="50"
                                   value="@armyList.PointsLimit"
                                   @onchange="HandlePointsLimitChanged" />
                        </div>

                        <div>
                            <label class="form-label">Faction</label>
                            <select class="form-select" @bind="selectedFactionId" @bind:after="HandleFactionChangedAsync">
                                <option value="">-- Choose faction --</option>
                                @foreach (var faction in factions)
                                {
                                    <option value="@faction.Id">@faction.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Detachment</label>
                            <select class="form-select"
                                    @bind="selectedDetachmentId"
                                    @bind:after="HandleDetachmentChangedAsync"
                                    disabled="@(detachments.Count == 0)">
                                <option value="">-- Optional --</option>
                                @foreach (var detachment in detachments)
                                {
                                    <option value="@detachment.Id.ToString()">@detachment.Name</option>
                                }
                            </select>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(armyList.FactionId))
                        {
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-primary" @onclick="NavigateToFactionRules">
                                    <i class="fa fa-book-open me-2"></i>Browse faction rules
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap py-1">
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-3 py-2">@armyList.TotalPoints pts</span>
                <span class="badge rounded-pill @(armyList.RemainingPoints < 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success") fw-semibold px-3 py-2">@armyList.RemainingPoints remaining</span>
                <span class="badge rounded-pill bg-secondary bg-opacity-10 text-body-secondary fw-semibold px-3 py-2">@armyList.Units.Count unit@(armyList.Units.Count == 1 ? string.Empty : "s")</span>
                @if (armyList.Units.Any())
                {
                    <span class="badge rounded-pill bg-secondary bg-opacity-10 text-body-secondary fw-semibold px-3 py-2">@string.Join(" | ", RoleGroups.Select(g => $"{g.Key}: {g.Count()}"))</span>
                }
            </div>
            @if (armyList.RemainingPoints < 0)
            {
                <div class="alert alert-danger py-2 mb-0">The roster is over the selected points limit.</div>
            }
            else if (armyList.RemainingPoints == 0 && armyList.Units.Any())
            {
                <div class="alert alert-success py-2 mb-0">The roster is exactly on target.</div>
            }
            else if (string.IsNullOrWhiteSpace(armyList.FactionId))
            {
                <div class="alert alert-info py-2 mb-0">Choose a faction to start adding units.</div>
            }

            <div class="d-flex flex-column gap-2">
                @if (string.IsNullOrWhiteSpace(armyList.FactionId))
                {
                    <div class="text-center text-muted py-4">
                        <i class="fa fa-layer-group fa-2x d-block mb-2 opacity-50"></i>
                        Choose a faction first, then add units from each role section.
                    </div>
                }
                else
                {
                    @foreach (var roleGroup in RolePickerGroups)
                    {
                        var roleUnits = GetUnitsForRole(roleGroup.Role).ToList();

                        <div class="mb-4">
                            <div class="pb-3 border-bottom border-secondary-subtle position-relative"
                                 role="button"
                                 tabindex="0"
                                 @onclick="() => ToggleRoleSection(roleGroup.Role)"
                                 @onkeydown="args => HandleRoleHeaderKeyDown(args, roleGroup.Role)">
                                <div class="d-flex align-items-center justify-content-between gap-2">
                                    
                                    <div class="text-muted">
                                        <i class="fa @(IsRoleSectionExpanded(roleGroup.Role) ? "fa-chevron-down" : "fa-chevron-right")"></i>
                                    </div>

                                    <div class="flex-grow-1 min-w-0">
                                        <div class="h5 mb-1 fw-bold">@roleGroup.Role</div>
                                        <div class="small text-muted">@roleUnits.Count unit@(roleUnits.Count == 1 ? string.Empty : "s") in roster &middot; @roleGroup.Count available@(roleGroup.Count == 1 ? string.Empty : "s")</div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-shrink-0" @onclick:stopPropagation="true">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenRolePicker(roleGroup.Role)"
                                                aria-label="Add @roleGroup.Role unit">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                    @* <div class="unit-click-indicator text-muted">
                                        <i class="fa @(IsRoleSectionExpanded(roleGroup.Role)? "fa-chevron-up" : "fa-chevron-down")"></i>
                                    </div> *@
                                </div>
                            </div>

                            @if (IsRoleSectionExpanded(roleGroup.Role))
                            {
                                <div class="pt-3">
                                    @if (!roleUnits.Any())
                                    {
                                        <div class="text-muted small fst-italic">No @roleGroup.Role units added yet.</div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var unit in roleUnits)
                                            {
                                                    <div class="card roster-unit-card bg-secondary-subtle shadow-sm" @key="unit.Id">
                                                        <div class="card-header clickable-card" @onclick="() => ToggleUnitAsync(unit.Id, unit.DatasheetId)">
                                                                <div class="d-flex justify-content-between align-items-center flex-nowrap gap-2">
                                                                    <div class="text-muted">
                                                                        <i class="fa @(expandedUnits.Contains(unit.Id) ? "fa-chevron-down" : "fa-chevron-right")"></i>
                                                                    </div>

                                                                    <div class="flex-grow-1 min-w-0 d-flex align-items-center column-gap-2 row-gap-1 flex-wrap">
                                                                        <span class="fw-semibold text-body fs-6">@unit.DatasheetName</span>
                                                                        <div class="d-inline-flex align-items-center flex-wrap gap-1">
                                                                            <span class="badge text-bg-primary">@unit.SelectedPoints pts</span>
                                                                            @if (unit.HasEnhancement)
                                                                            {
                                                                                <span class="badge text-bg-warning">@unit.EnhancementName (+@unit.EnhancementCost)</span>
                                                                            }
                                                                        </div>
                                                                    </div>

                                                                    <div class="roster-unit-actions flex-shrink-0" @onclick:stopPropagation="true">
                                                                        <div class="dropdown">
                                                                            <button class="btn roster-unit-action-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open actions for @unit.DatasheetName">
                                                                                <i class="fa fa-ellipsis-vertical"></i>
                                                                            </button>
                                                                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                                                                <li>
                                                                                    <a class="dropdown-item" @onclick="() => OpenLoadoutEditorAsync(unit.Id)">
                                                                                        <i class="fa fa-pen me-2"></i>Edit
                                                                                    </a>
                                                                                </li>
                                                                                <li>
                                                                                    <a class="dropdown-item" @onclick="() => DuplicateUnitAsync(unit.Id)">
                                                                                        <i class="fa fa-copy me-2"></i>Duplicate
                                                                                    </a>
                                                                                </li>
                                                                                <li>
                                                                                    <a class="dropdown-item text-danger" @onclick="() => RemoveUnitAsync(unit.Id)">
                                                                                        <i class="fa fa-trash me-2"></i>Remove
                                                                                    </a>
                                                                                </li>
                                                                            </ul>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                        </div>

                                                    @if (expandedUnits.Contains(unit.Id))
                                                    {
                                                        <div class="card-body d-flex flex-column gap-3" @onclick:stopPropagation="true">
                                                            <div>
                                                                @if (unit.Composition.Any())
                                                                {
                                                                    <div class="text-muted small mt-2">@unit.Composition.First()</div>
                                                                }

                                                                @if (GetLoadoutSummary(unit).Any())
                                                                {
                                                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                                                        @foreach (var summary in GetLoadoutSummary(unit).Take(4))
                                                                        {
                                                                            <span class="badge text-bg-light">@summary</span>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>

                                                            @if (availableEnhancements.Any() && unit.CanTakeEnhancement)
                                                            {
                                                                <div>
                                                                    <label class="form-label">Enhancement</label>
                                                                    <select class="form-select w-auto" value="@unit.EnhancementId?.ToString()" @onchange="@(args => UpdateUnitEnhancementAsync(unit, args.Value?.ToString()))">
                                                                        <option value="">-- None --</option>
                                                                        @foreach (var enhancement in availableEnhancements)
                                                                        {
                                                                            var assignedElsewhere = IsEnhancementAssignedElsewhere(unit, enhancement.Id);
                                                                            <option value="@enhancement.Id.ToString()" disabled="@assignedElsewhere">
                                                                                @enhancement.Name (@enhancement.Cost pts)@(assignedElsewhere ? " — assigned" : string.Empty)
                                                                            </option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            }

                                                            <div class="d-flex flex-column gap-2">
                                                                <div class="d-inline-flex align-items-center gap-1">
                                                                    <label class="form-label mb-0">Notes</label>
                                                                    <button type="button"
                                                                            class="btn btn-sm btn-link text-decoration-none p-0"
                                                                            @onclick="() => ToggleUnitNotesEditor(unit)">
                                                                        <i class="fa fa-pen"></i>
                                                                    </button>
                                                                    <span class="form-label mb-0">:</span>
                                                                </div>
                                                                <div class="small text-muted" style="white-space: pre-wrap;">@GetUnitNotesDisplayText(unit)</div>
                                                                @if (IsEditingUnitNotes(unit.Id))
                                                                {
                                                                    <textarea class="form-control"
                                                                              rows="2"
                                                                              value="@GetUnitNotesDraft(unit)"
                                                                              @oninput="args => SetUnitNotesDraft(unit.Id, args.Value?.ToString())"
                                                                              @onblur="() => SaveUnitNotesAsync(unit.Id)"></textarea>
                                                                }
                                                            </div>

                                                            @if (unit.Keywords.Any())
                                                            {
                                                                <div>
                                                                    <div class="small text-muted text-uppercase fw-semibold mb-2">Keywords</div>
                                                                    <div class="d-flex flex-wrap gap-1">
                                                                        @foreach (var keyword in unit.Keywords)
                                                                        {
                                                                            <span class="badge text-bg-primary">@keyword</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(selectedRole))
{
    <div class="fullscreen-overlay" style="background: rgba(0, 0, 0, 0.6);">
        <div class="container py-4">
            <div class="card mx-auto" style="max-width: 960px;">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <div>
                        <div class="fw-semibold">Add Unit</div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseRolePicker">
                        <i class="fa fa-xmark me-1"></i>Close
                    </button>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div>
                        <label class="form-label">Search @selectedRole units</label>
                        <input class="form-control" placeholder="Search units..." @bind="unitSearch" @bind:event="oninput" />
                    </div>

                    @if (!FilteredDatasheets.Any())
                    {
                        <div class="text-muted">No @selectedRole units match the current search.</div>
                    }
                    else
                    {
                        <div class="unit-browser-list d-flex flex-column gap-2">
                            <Virtualize Items="FilteredDatasheets" Context="datasheet" ItemSize="88" OverscanCount="4">
                                <div class="border rounded-3 p-2 clickable-card"
                                     role="button"
                                     tabindex="0"
                                     @key="datasheet.Id"
                                     @onclick="() => AddUnitFromRolePickerAsync(datasheet)"
                                     @onkeydown="args => HandleAddUnitCardKeyDown(args, datasheet)">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div class="align-self-center">
                                            <span class="fw-semibold">
                                                @datasheet.Name
                                            </span>
                                            @if (GetRosterUnitCount(datasheet.Id) > 0)
                                            {
                                                <span class="text-muted"><sup>&nbsp;<i class="fa fa-2xs fa-times"></i>@GetRosterUnitCount(datasheet.Id)</sup></span>
                                            }
                                        </div>

                                        <button class="btn btn-sm btn-primary flex-shrink-0 align-self-start py-0"
                                                @onclick="() => AddUnitFromRolePickerAsync(datasheet)"
                                                @onclick:stopPropagation="true">
                                            <i class="fa fa-2xs fa-plus" style="margin-right: 0.1rem;"></i>
                                            @if (datasheet.PointsCost.HasValue)
                                            {   
                                                @(datasheet.PointsCost.Value + " pts")
                                            }
                                        </button>
                                    </div>
                                </div>
                            </Virtualize>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (loadoutEditorOpen && LoadoutEditorUnit != null)
{
    <div class="fullscreen-overlay modal-fullscreen">
        <div class="fullscreen-toolbar px-3 py-3">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="text-uppercase small text-muted fw-semibold">Loadout Editor</div>
                    <h2 class="h4 mb-1">@LoadoutEditorUnit.DatasheetName</h2>
                    <div class="text-muted">@GetRoleDisplay(LoadoutEditorUnit.Role) &middot; @GetUnitSizeSummary(LoadoutEditorUnit)</div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-secondary" @onclick="CloseLoadoutEditor">
                        <i class="fa fa-times me-1"></i>Close
                    </button>
                </div>
            </div>
        </div>

        <div class="container-fluid modal-body loadout-editor-body" id="@loadoutEditorWeaponLayoutContainerId">
            @if (loadoutEditorLoading)
            {
                <div class="d-flex align-items-center py-4">
                    <div class="spinner-border text-primary me-2" role="status"></div>
                    <div>Loading unit editor...</div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @if (LoadoutEditorUnit.CostOptions.Count > 1)
                    {
                        <div class="reference-panel">
                            <label class="form-label">Unit size / cost</label>
                            <select class="form-select"
